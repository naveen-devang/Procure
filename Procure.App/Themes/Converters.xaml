<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Procure.App.Converters">

    <!-- App-wide converter instances so pages/controls/modals stop re-declaring them. -->
    <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    <conv:NullOrEmptyToVisibilityConverter x:Key="NullVis" />
    <conv:BoolToChevronConverter x:Key="Chevron" />
    <conv:FormatConverter x:Key="Fmt" />
    <conv:DateTimeOffsetConverter x:Key="Dto" />
    <conv:DoneGlyphConverter x:Key="DoneGlyph" />
    <conv:StrikethroughConverter x:Key="Strike" />
    <conv:ZeroCountToVisibilityConverter x:Key="ZeroVis" />
    <conv:CountToVisibilityConverter x:Key="CountVis" />
    <conv:PercentTextConverter x:Key="Pct" />
    <conv:ShortDateConverter x:Key="ShortDate" />
    <conv:PriorityColorConverter x:Key="PriorityColor" />
    <conv:StatusColorConverter x:Key="StatusColor" />
    <conv:StatusBadgeBgConverter x:Key="StatusBg" />
    <conv:SelectAllToggleConverter x:Key="SelAll" />
    <conv:BoolToFilterChipBgConverter x:Key="ChipBg" />
    <conv:BoolToFilterChipStrokeConverter x:Key="ChipStroke" />
    <conv:BoolToFilterChipTextConverter x:Key="ChipText" />
    <conv:PoFulfillmentColorConverter x:Key="FulfilColor" />
    <conv:PoFulfillmentBgConverter x:Key="FulfilBg" />
    <conv:PoFulfillmentStrokeConverter x:Key="FulfilStroke" />
    <conv:BytesToImageConverter x:Key="PngImg" />
    <conv:SegmentedSelectionBrushConverter x:Key="SegBg" />

    <!-- For ComboBoxes over string lists that can contain an empty entry. Without an explicit
         template, selecting the empty string leaves the ContentPresenter with no content and it
         falls back to printing the DataContext - the Technical Approval box read
         "Procure.PageModels.PrListPageModel". -->
    <DataTemplate x:Key="StringItemTemplate">
        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
    <conv:NumericTextConverter x:Key="Num" />
    <conv:AllocationColorConverter x:Key="AllocColor" />
    <conv:SegmentedSelectionTextConverter x:Key="SegText" />
    <conv:PixelsToGridLengthConverter x:Key="Px" />
</ResourceDictionary>
