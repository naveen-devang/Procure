<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The MAUI app carried ~960 {AppThemeBinding Light=... Dark=...} sites over the
      tokens in Resources/Styles/Colors.xaml. WinUI swaps automatically: one key per
      semantic role, a Light value and a Default (= dark / fallback) value, resolved
      with {ThemeResource Key}. Port rule:
        {StaticResource FluentSuccessBg}                              -> {ThemeResource FluentSuccessBg}
        {AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}
                                                                      -> {ThemeResource AppHairline}
      AccentFillBrush / PrimaryTextBrush are NOT theme-scoped - WinUiAppHost rewrites
      them at runtime from the pastel accent picker.
    -->
    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <!-- surfaces -->
            <SolidColorBrush x:Key="AppBackground"          Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppSecondaryBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTertiaryBackground"  Color="#F9F9F9" />
            <SolidColorBrush x:Key="AppHairline"            Color="#D1D1D1" />
            <SolidColorBrush x:Key="AppControlBorder"       Color="#D1D1D1" />
            <SolidColorBrush x:Key="AppSubtleFill"          Color="#E5E5E5" />
            <SolidColorBrush x:Key="AppDisabledFill"        Color="#D1D1D1" />
            <SolidColorBrush x:Key="AppDisabledText"        Color="#8A8A8A" />
            <!-- text -->
            <SolidColorBrush x:Key="AppTextPrimary"     Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppTextSecondary"   Color="#5C5C5C" />
            <SolidColorBrush x:Key="AppTextTertiary"    Color="#8A8A8A" />
            <SolidColorBrush x:Key="AppTextPlaceholder" Color="#8A8A8A" />
            <!-- status: text + bg -->
            <SolidColorBrush x:Key="FluentSuccess"   Color="#107C41" />
            <SolidColorBrush x:Key="FluentSuccessBg" Color="#E7F3ED" />
            <SolidColorBrush x:Key="FluentCaution"   Color="#7A4B04" />
            <SolidColorBrush x:Key="FluentCautionBg" Color="#FFF4CE" />
            <SolidColorBrush x:Key="FluentCritical"   Color="#A80000" />
            <SolidColorBrush x:Key="FluentCriticalBg" Color="#FDE7E9" />
            <SolidColorBrush x:Key="FluentInfo"   Color="#004E8C" />
            <SolidColorBrush x:Key="FluentInfoBg" Color="#EBF3FC" />
            <SolidColorBrush x:Key="FluentTeal"   Color="#005A70" />
            <SolidColorBrush x:Key="FluentTealBg" Color="#E0F7FA" />
            <SolidColorBrush x:Key="FluentPurple"   Color="#4B2BA8" />
            <SolidColorBrush x:Key="FluentPurpleBg" Color="#F0EBF9" />
            <!-- lineage badges -->
            <SolidColorBrush x:Key="BadgeCombinedPrBg"     Color="#E6F2FB" />
            <SolidColorBrush x:Key="BadgeCombinedPrText"   Color="#004578" />
            <SolidColorBrush x:Key="BadgeCombinedPrBorder" Color="#CCE4F7" />
            <SolidColorBrush x:Key="BadgeSharedRfqBg"     Color="#E0F7FA" />
            <SolidColorBrush x:Key="BadgeSharedRfqText"   Color="#005A70" />
            <SolidColorBrush x:Key="BadgeSharedRfqBorder" Color="#B2EBF2" />
            <SolidColorBrush x:Key="BadgeCombinedPoBg"     Color="#E6F5EC" />
            <SolidColorBrush x:Key="BadgeCombinedPoText"   Color="#107C41" />
            <SolidColorBrush x:Key="BadgeCombinedPoBorder" Color="#C2E8D3" />
            <SolidColorBrush x:Key="BadgeMergedBg"     Color="#EDEBE9" />
            <SolidColorBrush x:Key="BadgeMergedText"   Color="#494847" />
            <SolidColorBrush x:Key="BadgeMergedBorder" Color="#D2D0CE" />
            <!-- metric strip pills -->
            <SolidColorBrush x:Key="PillBg"          Color="#F3F3F3" />
            <SolidColorBrush x:Key="PillBorder"      Color="#E0E0E0" />
            <SolidColorBrush x:Key="PillTextNeutral" Color="#323130" />
            <!-- warm alert infobar -->
            <SolidColorBrush x:Key="AlertWarningBg"     Color="#FFF8F0" />
            <SolidColorBrush x:Key="AlertWarningBorder" Color="#F6D3A0" />
            <SolidColorBrush x:Key="AlertWarningIcon"   Color="#8A5700" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Default">
            <!-- surfaces -->
            <SolidColorBrush x:Key="AppBackground"          Color="#202020" />
            <SolidColorBrush x:Key="AppSecondaryBackground" Color="#2B2B2B" />
            <SolidColorBrush x:Key="AppTertiaryBackground"  Color="#323232" />
            <SolidColorBrush x:Key="AppHairline"            Color="#2E2E2E" />
            <SolidColorBrush x:Key="AppControlBorder"       Color="#6E6E6E" />
            <SolidColorBrush x:Key="AppSubtleFill"          Color="#383838" />
            <SolidColorBrush x:Key="AppDisabledFill"        Color="#383838" />
            <SolidColorBrush x:Key="AppDisabledText"        Color="#6E6E6E" />
            <!-- text -->
            <SolidColorBrush x:Key="AppTextPrimary"     Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondary"   Color="#C5C5C5" />
            <SolidColorBrush x:Key="AppTextTertiary"    Color="#8A8A8A" />
            <SolidColorBrush x:Key="AppTextPlaceholder" Color="#8A8A8A" />
            <!-- status: text + bg -->
            <SolidColorBrush x:Key="FluentSuccess"   Color="#6CCB5F" />
            <SolidColorBrush x:Key="FluentSuccessBg" Color="#143823" />
            <SolidColorBrush x:Key="FluentCaution"   Color="#FCE100" />
            <SolidColorBrush x:Key="FluentCautionBg" Color="#3B2E08" />
            <SolidColorBrush x:Key="FluentCritical"   Color="#FF99A4" />
            <SolidColorBrush x:Key="FluentCriticalBg" Color="#3F1011" />
            <SolidColorBrush x:Key="FluentInfo"   Color="#60CDFF" />
            <SolidColorBrush x:Key="FluentInfoBg" Color="#142F4C" />
            <SolidColorBrush x:Key="FluentTeal"   Color="#4DD0E1" />
            <SolidColorBrush x:Key="FluentTealBg" Color="#103B44" />
            <SolidColorBrush x:Key="FluentPurple"   Color="#C4A6FE" />
            <SolidColorBrush x:Key="FluentPurpleBg" Color="#281A4C" />
            <!-- lineage badges -->
            <SolidColorBrush x:Key="BadgeCombinedPrBg"     Color="#172E48" />
            <SolidColorBrush x:Key="BadgeCombinedPrText"   Color="#70B8FF" />
            <SolidColorBrush x:Key="BadgeCombinedPrBorder" Color="#244970" />
            <SolidColorBrush x:Key="BadgeSharedRfqBg"     Color="#103B44" />
            <SolidColorBrush x:Key="BadgeSharedRfqText"   Color="#4DD0E1" />
            <SolidColorBrush x:Key="BadgeSharedRfqBorder" Color="#1A535F" />
            <SolidColorBrush x:Key="BadgeCombinedPoBg"     Color="#143823" />
            <SolidColorBrush x:Key="BadgeCombinedPoText"   Color="#6BD279" />
            <SolidColorBrush x:Key="BadgeCombinedPoBorder" Color="#1E5234" />
            <SolidColorBrush x:Key="BadgeMergedBg"     Color="#2D2C2C" />
            <SolidColorBrush x:Key="BadgeMergedText"   Color="#C8C6C4" />
            <SolidColorBrush x:Key="BadgeMergedBorder" Color="#403F3E" />
            <!-- metric strip pills -->
            <SolidColorBrush x:Key="PillBg"          Color="#2B2B2B" />
            <SolidColorBrush x:Key="PillBorder"      Color="#383838" />
            <SolidColorBrush x:Key="PillTextNeutral" Color="#E1DFDD" />
            <!-- warm alert infobar -->
            <SolidColorBrush x:Key="AlertWarningBg"     Color="#2D2312" />
            <SolidColorBrush x:Key="AlertWarningBorder" Color="#5A3F10" />
            <SolidColorBrush x:Key="AlertWarningIcon"   Color="#FFC83B" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Live pastel accent. WinUiAppHost.ApplyAccentColor overwrites these at runtime
         (and re-runs on theme change, since PrimaryTextBrush is deep in light / pastel
         in dark). Defaults = the "Blue" palette. -->
    <SolidColorBrush x:Key="AccentFillBrush"   Color="#60CDFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush"  Color="#005FB8" />

    <!-- shared non-color tokens (were AppStyles.xaml) -->
    <x:Double x:Key="SidebarExpandedWidth">240</x:Double>
    <x:Double x:Key="SidebarCompactWidth">68</x:Double>

</ResourceDictionary>
