<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The shared design layer the MAUI head had and the WinUI port lost. Merged into App.xaml
      after AppColors.xaml. Redesign (Sep 2026, approved direction: docs/procure-redesign
      artifact): Notion/Vercel-ish - airy shell, dense board data, warm neutrals, Plus Jakarta
      Sans for UI text (Segoe Fluent Icons untouched for glyphs).
    -->

    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="Space2xl">32</x:Double>
    <x:Double x:Key="ControlHeightStd">36</x:Double>

    <!-- Fluent geometry override: default is 4/8, softened to 6/10 for the calmer feel. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!-- UI font. Segoe UI Variable read thin/stick-like at UI weights; Plus Jakarta Sans
         (SIL OFL, variable weight, bundled in Assets/Fonts) has more presence and pairs with
         the Notion/Vercel direction. Icon glyphs (Segoe Fluent Icons) are untouched - see
         IconButton below. -->
    <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/PlusJakartaSans-Variable.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/PlusJakartaSans-Variable.ttf#Plus Jakarta Sans</FontFamily>

    <!-- Applies to every plain TextBlock app-wide (Controls pick up ContentControlThemeFontFamily
         above on their own). -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <!-- Native ButtonBackgroundPointerOver/Pressed default to a Fluent-grey overlay that isn't
         one of our warm-neutral tokens - repoint to app tokens so hover/press is subtle and
         theme-correct everywhere.
         IMPORTANT: a Button whose own Background is a live Binding (segmented selectors -
         Tasks' view switcher, priority picker, PcrPreviewModal's layout pickers) must NOT bind
         Button.Background directly. Once the PointerOver/Pressed VisualState Setters below have
         touched that property, WinUI fails to restore the Binding afterwards - the button gets
         stuck on its first-ever value (usually Transparent) and never shows "selected" again.
         Bind the selection fill on a plain Border behind/around the Button instead (Border isn't
         subject to Button's CommonStates VSM), and leave Button.Background a static Transparent. -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource AppSubtleFill}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource AppTertiaryBackground}" />

    <!-- Plus Jakarta Sans's line box sits text higher than Segoe did, so text/placeholder in
         every text-entry control (TextBox, PasswordBox, RichEditBox, AutoSuggestBox all share
         this resource) crowded the top edge with a gap left below. Shifting the padding box
         down compensates - default is 10,5,6,6. -->
    <Thickness x:Key="TextControlThemePadding">10,8,6,3</Thickness>

    <!-- The padding above only bites on a box that has room to shift into: an auto-height
         TextBox measures to its text and the nudge has nowhere to go, so placeholders still
         rode high everywhere a Height was not set by hand (40 of 47 boxes in the PR/RFQ/PO
         dialogs). MinHeight, not Height, so multi-line boxes keep their own larger size. -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <!-- Content container: board card, detail columns, modal sections, dashboard tiles, settings panes. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
        <Setter Property="Background" Value="{ThemeResource AppSecondaryBackground}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Capsule status / type / count label. Pair with BadgeText. A fixed radius + MinWidth,
         not 999 - 999 on a near-square short-text box draws as a literal ellipse, not a pill
         (confirmed by zooming a rendered "Capex" badge). -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="Background" Value="{ThemeResource AppSubtleFill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
    </Style>

    <!-- Board filter toggles - pill geometry; on/off colour stays converter-driven at the call site. -->
    <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinWidth" Value="70" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Segmented single-choice group member (theme mode, PCR layout options). -->
    <Style x:Key="SegmentButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Square glyph button that sits beside a 34px input: same footprint and fill as the field
         it accompanies, so a toolbar row reads as one control group. -->
    <Style x:Key="ToolbarIcon" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
        <Setter Property="Background" Value="{ThemeResource AppSubtleFill}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- edit / delete / chevron / expander glyphs - keeps the subtle-fill hover, 32px target. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
    </Style>

</ResourceDictionary>
