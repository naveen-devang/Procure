<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      The shared design layer the MAUI head had and the WinUI port lost. Merged into App.xaml
      after AppColors.xaml. Fluent geometry: 4px control / 8px card / pill badge; 4/8/12/16 spacing.
    -->

    <x:Double x:Key="SpaceXs">4</x:Double>
    <x:Double x:Key="SpaceSm">8</x:Double>
    <x:Double x:Key="SpaceMd">12</x:Double>
    <x:Double x:Key="SpaceLg">16</x:Double>
    <x:Double x:Key="SpaceXl">24</x:Double>
    <x:Double x:Key="ControlHeightStd">36</x:Double>

    <!-- Content container: board card, detail columns, modal sections, dashboard tiles, settings panes. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
        <Setter Property="Background" Value="{ThemeResource AppSecondaryBackground}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Capsule status / type / count label. Pair with BadgeText. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="Background" Value="{ThemeResource AppSubtleFill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
    </Style>

    <!-- Board filter toggles - pill geometry; on/off colour stays converter-driven at the call site. -->
    <Style x:Key="FilterChip" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Segmented single-choice group member (theme mode, PCR layout options). -->
    <Style x:Key="SegmentButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- edit / delete / chevron / expander glyphs - keeps the subtle-fill hover, 32px target. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
    </Style>

</ResourceDictionary>
