<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Procure.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="RWC MM Tracker">

    <!-- Explicit background: the window has no backdrop (Mica is off), so without this the
         NavigationView pane's default acrylic falls back to fully transparent on an unpackaged
         build - fine-looking in dark, see-through to the desktop in light. -->
    <Grid Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The window's title bar. The window draws its own (ExtendsContentIntoTitleBar), and without
             a row of its own every page started at the very top, underneath Windows' minimise /
             maximise / close buttons: "+ Add PR" sat beneath Close, and the top strip of each header
             was the window's drag area, so clicks there moved the window instead of pressing buttons.
             This row is the drag area (SetTitleBar), keeps clear of the caption buttons at any display
             scale, and carries the sidebar toggle that used to sit inside the pane. -->
        <muxc:TitleBar x:Name="AppTitleBar" Grid.Row="0"
                       Title="RWC MM Tracker"
                       IsPaneToggleButtonVisible="True"
                       IsBackButtonVisible="False"
                       PaneToggleRequested="AppTitleBar_PaneToggleRequested"
                       Background="{ThemeResource AppBackground}" />

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="180"
            Background="{ThemeResource AppBackground}"
            SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.Resources>
                <!-- Replace the acrylic pane fills (transparent on an unpackaged build) with a
                     solid surface. Theme-keyed so it re-resolves live when RequestedTheme flips -
                     a plain StaticResource froze the pane to its launch-time colour. Values match
                     AppBackground (redesign, Sep 2026). -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FBFAF8" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FBFAF8" />
                            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#FBFAF8" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#161619" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#161619" />
                            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#161619" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <!-- The MAUI app's navigation icon font (FluentSystemIcons-Regular). -->
                    <FontFamily x:Key="NavIconFont">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>
                </ResourceDictionary>
            </muxc:NavigationView.Resources>

            <!-- Same order and icons as the MAUI app (AppShell.xaml / App.xaml there): Dashboard first -
                 it is the page the app opens on - and the Fluent UI System Icons it used, from the same
                 font file, rather than Segoe symbol stand-ins. -->
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItemHeader Content="Workspace" />
                <muxc:NavigationViewItem Content="Dashboard" Tag="Dashboard" IsSelected="True">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource NavIconFont}" Glyph="&#xF35A;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="PR Board" Tag="Board">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource NavIconFont}" Glyph="&#xF379;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="RawPackingNavItem" Content="Raw &amp; Packing" Tag="CallOff">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource NavIconFont}" Glyph="&#xE218;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <!-- Segoe Fluent Icons "People": the MAUI icon font the others use has no supplier glyph. -->
                <muxc:NavigationViewItem Content="Suppliers" Tag="Suppliers">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE716;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemHeader Content="Planning" />
                <muxc:NavigationViewItem Content="Tasks" Tag="Tasks">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource NavIconFont}" Glyph="&#xEC93;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Notes" Tag="Notes">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource NavIconFont}" Glyph="&#xF577;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Settings" Tag="Settings">
                    <muxc:NavigationViewItem.Icon><FontIcon FontFamily="{StaticResource NavIconFont}" Glyph="&#xF6AA;" /></muxc:NavigationViewItem.Icon>
                    <!-- Dot while an update is ready and the sidebar is collapsed (no room for the card). -->
                    <muxc:NavigationViewItem.InfoBadge>
                        <muxc:InfoBadge x:Name="UpdateReadyDot" Visibility="Collapsed" ToolTipService.ToolTip="Update ready - expand the sidebar to restart" />
                    </muxc:NavigationViewItem.InfoBadge>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>
            <!-- Light / Dark switch under Settings, as in the MAUI sidebar: sun and moon side by side when the
                 sidebar is open, one toggle when it is collapsed. Both rows are the same height - the pane
                 misplaces its menu items when the footer changes height. Wired in MainWindow.Sidebar.cs. -->
            <muxc:NavigationView.PaneFooter>
                <Grid Height="48">
                    <Grid x:Name="ThemeSwitchExpanded" Padding="16,0,12,0">
                        <TextBlock Text="Theme" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                   IsTextSelectionEnabled="False" Foreground="{ThemeResource AppTextSecondary}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="3" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSecondaryBackground}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button x:Name="LightModeBtn" Content="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                        Width="32" Height="26" Padding="0" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Light Theme" Click="LightMode_Click" />
                                <Button x:Name="DarkModeBtn" Content="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="13"
                                        Width="32" Height="26" Padding="0" CornerRadius="4" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Dark Theme" Click="DarkMode_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Button x:Name="CompactThemeBtn" Visibility="Collapsed" FontFamily="Segoe Fluent Icons" FontSize="14"
                            Width="36" Height="36" Padding="0" CornerRadius="8" Margin="6,0,0,0" HorizontalAlignment="Left"
                            Background="Transparent" BorderThickness="0" Click="CompactTheme_Click" />
                </Grid>
            </muxc:NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame">
                <!-- Fires on a direct Content set too (NavigateTo assigns .Content to keep DI
                     singletons), so tab switches get the standard entrance animation. -->
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </muxc:NavigationView>

        <!-- "Update ready": shown once an update has downloaded in the background (MainWindow.Updates.cs).
             The card floats just above Settings while the sidebar is open; collapsed, a dot on Settings stands
             in. Not in NavigationView.PaneFooter: the pane laid its menu items out in the wrong place every
             time the footer changed height. -->
        <Border x:Name="UpdateReadyCard" Grid.Row="1" Visibility="Collapsed" Width="160" Margin="10,0,0,104" Padding="12,10"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource AccentButtonBackground}" Background="{ThemeResource AppSecondaryBackground}">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentButtonBackground}" />
                    <TextBlock Grid.Column="1" Text="Update ready" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"
                            Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Dismiss" Click="UpdateLater_Click" />
                </Grid>
                <TextBlock x:Name="UpdateReadyText" Text="Downloaded in the background. Restart to apply." FontSize="10.5" TextWrapping="Wrap"
                           Foreground="{ThemeResource AppTextSecondary}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Restart" Style="{StaticResource AccentButtonStyle}" FontSize="11" Height="28"
                            HorizontalAlignment="Stretch" Click="UpdateRestart_Click" />
                    <Button Grid.Column="1" Content="Later" FontSize="11" Height="28" Click="UpdateLater_Click" />
                </Grid>
            </StackPanel>
        </Border>
        <!-- The update window. Same scene as the installer's splash, minus the painted-on title:
             here the title, status and buttons are live. Opened from the sidebar's Update ready
             card or from Settings; never opened on its own while someone is working. -->
        <Grid x:Name="UpdateOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B3000000">
            <Border Width="520" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
                <Grid Height="292" CornerRadius="10">
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,520,292" />
                    </Grid.Clip>
                    <Image Stretch="UniformToFill" VerticalAlignment="Center">
                        <Image.Source>
                            <BitmapImage UriSource="ms-appx:///Assets/update-backdrop.gif" AutoPlay="True" />
                        </Image.Source>
                    </Image>
                    <!-- Without this wash, white text over a moving scene is unreadable the moment a
                         bright frame comes round. -->
                    <Border VerticalAlignment="Bottom" Height="190">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#F2080A0E" Offset="0" />
                                <GradientStop Color="#C4080A0E" Offset="0.45" />
                                <GradientStop Color="#00080A0E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,18" Spacing="8">
                        <TextBlock x:Name="UpdateDialogTitle" Style="{StaticResource AppText}" Text="Update ready"
                                   FontSize="21" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="UpdateDialogStatus" Style="{StaticResource AppText}" Text="Downloaded and waiting to be installed."
                                   FontSize="12.5" TextWrapping="Wrap" Foreground="#D6D9E0" />
                        <ProgressBar x:Name="UpdateDialogProgress" Height="6" Minimum="0" Maximum="100" Value="100"
                                     Foreground="{ThemeResource AccentButtonBackground}" Background="#3AFFFFFF" />
                        <TextBlock x:Name="UpdateDialogHint" Style="{StaticResource AppText}" Text="The app will close and reopen by itself."
                                   FontSize="11.5" Foreground="#AEB4C0" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button x:Name="UpdateDialogLater" Content="Later" Click="UpdateDialogLater_Click" />
                            <Button x:Name="UpdateDialogInstall" Content="Install and restart" Style="{StaticResource AccentButtonStyle}"
                                    Click="UpdateDialogInstall_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- "Deleted - Undo" toast (MainWindow.UndoToast.cs, UndoDeleteService). Here rather than on a page
             so it follows you across tabs: a delete made on the Board can still be undone from Tasks.
             Inverted surface - dark on the light theme, raised grey on the dark one - so it reads as
             "about the app", not part of the page under it. -->
        <Grid x:Name="UndoToast" Grid.Row="1" Visibility="Collapsed" Opacity="0"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,28"
              MinWidth="380" MaxWidth="560">
            <Grid.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="UndoToastBackground" Color="#1F1E1C" />
                            <SolidColorBrush x:Key="UndoToastBorder" Color="#34322E" />
                            <SolidColorBrush x:Key="UndoToastText" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="UndoToastSubText" Color="#B8B2A9" />
                            <SolidColorBrush x:Key="UndoToastIconBg" Color="#40292A" />
                            <SolidColorBrush x:Key="UndoToastIconFg" Color="#FF9C94" />
                            <SolidColorBrush x:Key="UndoToastAccent" Color="#8CC8FF" />
                            <SolidColorBrush x:Key="UndoToastTrack" Color="#26FFFFFF" />
                            <!-- Lightweight button styling: the toast's buttons sit on a dark card in
                                 both themes, so the page's light-theme button text must not reach them. -->
                            <SolidColorBrush x:Key="ButtonForeground" Color="#8CC8FF" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#B5DCFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#8CC8FF" />
                            <SolidColorBrush x:Key="ButtonBackground" Color="#1A8CC8FF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E8CC8FF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#228CC8FF" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="UndoToastBackground" Color="#2C2C32" />
                            <SolidColorBrush x:Key="UndoToastBorder" Color="#3E3E46" />
                            <SolidColorBrush x:Key="UndoToastText" Color="#F1EFEC" />
                            <SolidColorBrush x:Key="UndoToastSubText" Color="#A8A39C" />
                            <SolidColorBrush x:Key="UndoToastIconBg" Color="#4A2B2F" />
                            <SolidColorBrush x:Key="UndoToastIconFg" Color="#FF9C94" />
                            <SolidColorBrush x:Key="UndoToastAccent" Color="#60CDFF" />
                            <SolidColorBrush x:Key="UndoToastTrack" Color="#1FFFFFFF" />
                            <SolidColorBrush x:Key="ButtonForeground" Color="#60CDFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#9ADFFF" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#60CDFF" />
                            <SolidColorBrush x:Key="ButtonBackground" Color="#1A60CDFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2E60CDFF" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2260CDFF" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <Storyboard x:Key="UndoToastShowAnim">
                        <DoubleAnimation Storyboard.TargetName="UndoToastShift" Storyboard.TargetProperty="Y"
                                         From="24" To="0" Duration="0:0:0.28">
                            <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="6" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="UndoToast" Storyboard.TargetProperty="Opacity"
                                         To="1" Duration="0:0:0.18" />
                    </Storyboard>
                    <Storyboard x:Key="UndoToastHideAnim">
                        <DoubleAnimation Storyboard.TargetName="UndoToastShift" Storyboard.TargetProperty="Y"
                                         To="14" Duration="0:0:0.16">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="UndoToast" Storyboard.TargetProperty="Opacity"
                                         To="0" Duration="0:0:0.16" />
                    </Storyboard>
                    <!-- The bar empties over the whole Undo window. Linear on purpose: it is a clock. -->
                    <Storyboard x:Key="UndoToastCountdownAnim">
                        <DoubleAnimation Storyboard.TargetName="UndoToastProgressScale" Storyboard.TargetProperty="ScaleX"
                                         From="1" To="0" Duration="0:0:10" />
                    </Storyboard>
                </ResourceDictionary>
            </Grid.Resources>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="UndoToastShift" Y="24" />
            </Grid.RenderTransform>

            <Border x:Name="UndoToastCard" CornerRadius="12" BorderThickness="1"
                    Background="{ThemeResource UndoToastBackground}" BorderBrush="{ThemeResource UndoToastBorder}">
                <Grid Padding="14,12,10,12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center"
                                Background="{ThemeResource UndoToastIconBg}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="15"
                                      Foreground="{ThemeResource UndoToastIconFg}" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="UndoToastMessage" Text="Deleted" FontSize="13.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="False"
                                       Foreground="{ThemeResource UndoToastText}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="UndoToastCountdown" Text="You can undo this for 10 seconds" FontSize="11.5"
                                       IsTextSelectionEnabled="False" Foreground="{ThemeResource UndoToastSubText}" />
                        </StackPanel>

                        <Button x:Name="UndoToastUndoButton" Grid.Column="2" VerticalAlignment="Center"
                                Height="34" Padding="14,0" CornerRadius="8"
                                AutomationProperties.Name="Undo delete" Click="UndoToastUndo_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="13" />
                                <TextBlock Text="Undo" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3" Width="30" Height="30" Padding="0" CornerRadius="15" VerticalAlignment="Center"
                                Background="Transparent" Foreground="{ThemeResource UndoToastSubText}"
                                ToolTipService.ToolTip="Close and delete now" AutomationProperties.Name="Close and delete now"
                                Click="UndoToastClose_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Countdown: a track, and a fill that shrinks from the right. -->
                    <Grid Grid.Row="1" Height="3" Margin="0,0,4,0">
                        <Border CornerRadius="1.5" Background="{ThemeResource UndoToastTrack}" />
                        <Border CornerRadius="1.5" Background="{ThemeResource UndoToastAccent}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="UndoToastProgressScale" ScaleX="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Perf HUD - kept in every migration build until cutover (MIGRATION-PLAN.md 5a).
             Development instrument, hidden unless PROCURE_HUD=1 (MainWindow.xaml.cs). -->
        <Border x:Name="Hud" Grid.Row="1" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,12,10" Padding="8,4"
                CornerRadius="4" IsHitTestVisible="False"
                Background="#99000000">
            <TextBlock x:Name="HudText" FontFamily="Consolas" FontSize="11"
                       Foreground="#30FF90" Text="perf: warming up…" />
        </Border>
    </Grid>
</Window>
