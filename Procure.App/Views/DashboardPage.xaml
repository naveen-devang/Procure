<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Procure.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models"
    xmlns:conv="using:Procure.App.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:StatusColorConverter x:Key="StatusColor" />
        <conv:StatusBadgeBgConverter x:Key="StatusBg" />
        <conv:PriorityColorConverter x:Key="PriorityColor" />
        <conv:PriorityBgConverter x:Key="PriorityBg" />
        <conv:PriorityBorderConverter x:Key="PriorityBorder" />

        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppSecondaryBackground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="28,24,28,32" Background="{ThemeResource AppBackground}">
        <StackPanel Spacing="24" MaxWidth="1600" HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Procurement Overview" FontSize="28" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimary}" />
                    <TextBlock Text="Real-time pipeline metrics, pending multi-role approvals, and SLA tracking."
                               FontSize="13" Foreground="{ThemeResource AppTextSecondary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding LoadDataCommand}" Height="38" />
                    <Button Content="+ Add PR" Command="{Binding CreateNewPrCommand}" Height="38"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Total Requisitions" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                        <TextBlock Text="{Binding Metrics.TotalPrs}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="RFQs Awaiting Quote" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                        <TextBlock Text="{Binding Metrics.RfqsAwaitingQuote}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PCRs Pending Sign" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                        <TextBlock Text="{Binding Metrics.PcrsAwaitingSignature}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="POs Raised" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                        <TextBlock Text="{Binding Metrics.PosRaised}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Overdue / SLA Alert" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                        <TextBlock Text="{Binding Metrics.OverdueCount}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{ThemeResource FluentCritical}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource MetricCard}" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Action Required &amp; Urgent Requisitions" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                        <Button Grid.Column="1" Content="Open PR Board →" Command="{Binding NavigateToPrBoardCommand}"
                                FontSize="12" Height="28" Padding="8,0" Background="Transparent"
                                Foreground="{ThemeResource PrimaryTextBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Metrics.NeedsAttentionPrs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PurchaseRequisition">
                                <Border Margin="0,0,0,10" Padding="14,10" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{ThemeResource AppHairline}"
                                        Background="{ThemeResource AppTertiaryBackground}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="8,3,8,5" CornerRadius="11" MinWidth="54" BorderThickness="0" VerticalAlignment="Center"
                                                Background="{x:Bind Priority, Converter={StaticResource PriorityBg}}"
                                                BorderBrush="{x:Bind Priority, Converter={StaticResource PriorityBorder}}">
                                            <TextBlock Text="{x:Bind Priority}" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{x:Bind Priority, Converter={StaticResource PriorityColor}}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind PrNo}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{ThemeResource AppTextPrimary}" />
                                                <TextBlock Text="{x:Bind Requestor}" FontSize="12" MaxLines="1"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AppTextSecondary}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource AppTextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" MinWidth="100">
                                            <Border Padding="8,2,8,4" CornerRadius="11" MinWidth="54" HorizontalAlignment="Right"
                                                    Background="{x:Bind Status, Converter={StaticResource StatusBg}}">
                                                <TextBlock Text="{x:Bind Status}" FontSize="10" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{x:Bind Status, Converter={StaticResource StatusColor}}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind AgeDisplay}" FontSize="10" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource AppTextTertiary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyMsg" Text="All requisitions are running smoothly without overdue delays."
                               FontSize="13" Foreground="{ThemeResource AppTextTertiary}" HorizontalAlignment="Center"
                               Padding="40" Visibility="Collapsed" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
