<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Procure.App.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models"
    xmlns:conv="using:Procure.App.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:TodoPriorityColorConverter x:Key="PrioColor" />
        <conv:TodoOverdueColorConverter x:Key="OverdueColor" />
        <conv:TodoSegmentBgConverter x:Key="SegBg" />
        <conv:TodoSegmentTextConverter x:Key="SegText" />
        <conv:StrikethroughConverter x:Key="Strike" />
        <conv:DoneGlyphConverter x:Key="DoneGlyph" />
        <conv:DateTimeOffsetConverter x:Key="Dto" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
            <Setter Property="Background" Value="{ThemeResource AppSecondaryBackground}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <DataTemplate x:Key="TaskRow" x:DataType="models:TodoTask">
            <Grid Padding="6,3" ColumnSpacing="4" Tapped="Row_Tapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2" Margin="0,4"
                           Fill="{x:Bind Priority, Converter={StaticResource PrioColor}, Mode=OneWay}" />
                <Button Grid.Column="1" Style="{StaticResource IconBtn}" FontSize="16" Click="Done_Click" Tapped="Stop"
                        Content="{x:Bind IsDone, Converter={StaticResource DoneGlyph}, Mode=OneWay}"
                        Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Title, Mode=OneWay}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextDecorations="{x:Bind IsDone, Converter={StaticResource Strike}, Mode=OneWay}"
                           Foreground="{ThemeResource AppTextPrimary}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="{x:Bind SubtaskBadge, Mode=OneWay}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{ThemeResource AppTextTertiary}"
                               Visibility="{x:Bind HasSubtasks, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="10" VerticalAlignment="Center"
                               Foreground="{ThemeResource AppTextTertiary}"
                               Visibility="{x:Bind HasRecurrence, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                    <Border Padding="7,3" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{ThemeResource PrimaryTextBrush}"
                            Visibility="{x:Bind HasLinks, Converter={StaticResource BoolVis}, Mode=OneWay}"
                            Tapped="Link_Tapped">
                        <TextBlock Text="{x:Bind LinksBadge, Mode=OneWay}" FontSize="10"
                                   Foreground="{ThemeResource PrimaryTextBrush}" />
                    </Border>
                    <Border Padding="7,3" CornerRadius="9" BorderThickness="1" VerticalAlignment="Center"
                            BorderBrush="{ThemeResource AppHairline}"
                            Visibility="{x:Bind HasDueDate, Converter={StaticResource BoolVis}, Mode=OneWay}">
                        <TextBlock Text="{x:Bind DueLabel, Mode=OneWay}" FontSize="10.5"
                                   Foreground="{x:Bind IsOverdue, Converter={StaticResource OverdueColor}, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BoardCard" x:DataType="models:TodoTask">
            <Border Padding="9,7" Margin="0,0,0,6" BorderThickness="1" CornerRadius="7"
                    BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppTertiaryBackground}"
                    Tapped="Row_Tapped">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconBtn}" FontSize="13" Click="Done_Click" Tapped="Stop"
                            Content="{x:Bind IsDone, Converter={StaticResource DoneGlyph}, Mode=OneWay}"
                            Foreground="{ThemeResource AppTextSecondary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextPrimary}"
                               TextDecorations="{x:Bind IsDone, Converter={StaticResource Strike}, Mode=OneWay}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind DueLabel, Mode=OneWay}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{x:Bind IsOverdue, Converter={StaticResource OverdueColor}, Mode=OneWay}"
                               Visibility="{x:Bind HasDueDate, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WeekChip" x:DataType="models:TodoTask">
            <Border Padding="6,5" Margin="0,0,0,4" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSecondaryBackground}"
                    Tapped="Row_Tapped">
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                               Fill="{x:Bind Priority, Converter={StaticResource PrioColor}, Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="10.5" MaxLines="2"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextPrimary}"
                               TextDecorations="{x:Bind IsDone, Converter={StaticResource Strike}, Mode=OneWay}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WeekColumnTemplate">
            <Border Padding="8" BorderThickness="1" CornerRadius="8" Margin="0,0,6,0"
                    BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppBackground}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding DayName}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextSecondary}" />
                        <TextBlock Text="{Binding Day}" FontSize="10.5" Foreground="{ThemeResource AppTextTertiary}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource WeekChip}" />
                    </ScrollViewer>
                    <TextBox Grid.Row="2" PlaceholderText="+ add" FontSize="11" Tag="{Binding}"
                             KeyDown="WeekAdd_KeyDown" Text="{Binding NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20" ColumnSpacing="16" Background="{ThemeResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="332" />
        </Grid.ColumnDefinitions>

        <!-- LEFT -->
        <Border Style="{StaticResource Pane}">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Padding="16,14,16,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tasks" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"
                               Foreground="{ThemeResource AppTextPrimary}" />
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="3"
                            CornerRadius="8" Background="{ThemeResource AppSubtleFill}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <!-- Selection fill lives on a Border behind each Button, not on the
                                 Button itself - see the note by ButtonBackgroundPointerOver in
                                 Styles.xaml for why a bound Button.Background breaks after the
                                 first hover/press. -->
                            <Grid>
                                <Border CornerRadius="6" Background="{Binding IsListView, Converter={StaticResource SegBg}}" />
                                <Button Content="List" Tag="List" Click="Seg_Click" Padding="14,5" CornerRadius="6"
                                        BorderThickness="0" Background="Transparent" FontSize="11.5" FontWeight="SemiBold"
                                        Foreground="{Binding IsListView, Converter={StaticResource SegText}}" />
                            </Grid>
                            <Grid>
                                <Border CornerRadius="6" Background="{Binding IsBoardView, Converter={StaticResource SegBg}}" />
                                <Button Content="Board" Tag="Board" Click="Seg_Click" Padding="14,5" CornerRadius="6"
                                        BorderThickness="0" Background="Transparent" FontSize="11.5" FontWeight="SemiBold"
                                        Foreground="{Binding IsBoardView, Converter={StaticResource SegText}}" />
                            </Grid>
                            <Grid>
                                <Border CornerRadius="6" Background="{Binding IsCalendarView, Converter={StaticResource SegBg}}" />
                                <Button Content="Calendar" Tag="Calendar" Click="Seg_Click" Padding="14,5" CornerRadius="6"
                                        BorderThickness="0" Background="Transparent" FontSize="11.5" FontWeight="SemiBold"
                                        Foreground="{Binding IsCalendarView, Converter={StaticResource SegText}}" />
                            </Grid>
                            <Grid>
                                <Border CornerRadius="6" Background="{Binding IsFinishedView, Converter={StaticResource SegBg}}" />
                                <Button Content="Finished" Tag="Finished" Click="Seg_Click" Padding="14,5" CornerRadius="6"
                                        BorderThickness="0" Background="Transparent" FontSize="11.5" FontWeight="SemiBold"
                                        Foreground="{Binding IsFinishedView, Converter={StaticResource SegText}}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button FontSize="11" Height="28" Padding="11,0"
                                Visibility="{Binding IsListView, Converter={StaticResource BoolVis}}"
                                Content="{Binding GroupMode}" Command="{Binding ToggleGroupModeCommand}" />
                        <TextBlock FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondary}">
                            <Run Text="{Binding OpenCount}" /><Run Text=" open" />
                        </TextBlock>
                        <TextBlock FontSize="11.5" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding HasOverdue, Converter={StaticResource OverdueColor}}"
                                   Visibility="{Binding HasOverdue, Converter={StaticResource BoolVis}}">
                            <Run Text="{Binding OverdueCount}" /><Run Text=" overdue" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- toolbar -->
                <Grid Grid.Row="1" Padding="16,0,16,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Filter tasks" FontSize="13" Height="36"
                             Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Clear finished" FontSize="11.5" Height="34"
                            Visibility="{Binding IsFinishedView, Converter={StaticResource BoolVis}}"
                            Command="{Binding ClearFinishedCommand}" />
                </Grid>

                <!-- quick-add composer -->
                <Border Grid.Row="2" Margin="16,0,16,10" BorderThickness="1" CornerRadius="9"
                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppTertiaryBackground}"
                        Visibility="{Binding ShowQuickAdd, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <Grid Padding="12,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTaskBox" PlaceholderText="Add a task" FontSize="13.5" Height="36"
                                     GotFocus="Composer_GotFocus" KeyDown="NewTask_KeyDown"
                                     Text="{Binding NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE70D;" FontSize="11"
                                    Width="28" Height="28" Command="{Binding NewTaskCommand}"
                                    Visibility="{Binding ComposerOpen, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        </Grid>
                        <StackPanel Spacing="10" Padding="12,4,12,12"
                                    Visibility="{Binding ComposerOpen, Converter={StaticResource BoolVis}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Grid>
                                        <Border CornerRadius="6" Background="{Binding NewTaskPriority, Converter={StaticResource SegBg}, ConverterParameter=None}" />
                                        <Button Content="None" Tag="None" Click="NewPrio_Click" Padding="12,4" CornerRadius="6" BorderThickness="0" Background="Transparent" FontSize="11"
                                                Foreground="{Binding NewTaskPriority, Converter={StaticResource SegText}, ConverterParameter=None}" />
                                    </Grid>
                                    <Grid>
                                        <Border CornerRadius="6" Background="{Binding NewTaskPriority, Converter={StaticResource SegBg}, ConverterParameter=Low}" />
                                        <Button Content="Low" Tag="Low" Click="NewPrio_Click" Padding="12,4" CornerRadius="6" BorderThickness="0" Background="Transparent" FontSize="11"
                                                Foreground="{Binding NewTaskPriority, Converter={StaticResource SegText}, ConverterParameter=Low}" />
                                    </Grid>
                                    <Grid>
                                        <Border CornerRadius="6" Background="{Binding NewTaskPriority, Converter={StaticResource SegBg}, ConverterParameter=Medium}" />
                                        <Button Content="Medium" Tag="Medium" Click="NewPrio_Click" Padding="12,4" CornerRadius="6" BorderThickness="0" Background="Transparent" FontSize="11"
                                                Foreground="{Binding NewTaskPriority, Converter={StaticResource SegText}, ConverterParameter=Medium}" />
                                    </Grid>
                                    <Grid>
                                        <Border CornerRadius="6" Background="{Binding NewTaskPriority, Converter={StaticResource SegBg}, ConverterParameter=High}" />
                                        <Button Content="High" Tag="High" Click="NewPrio_Click" Padding="12,4" CornerRadius="6" BorderThickness="0" Background="Transparent" FontSize="11"
                                                Foreground="{Binding NewTaskPriority, Converter={StaticResource SegText}, ConverterParameter=High}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Due" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Today" Tag="Today" Click="NewDue_Click" FontSize="11" Height="30" />
                                    <Button Content="Tomorrow" Tag="Tomorrow" Click="NewDue_Click" FontSize="11" Height="30" />
                                    <Button Content="+1 week" Tag="Week" Click="NewDue_Click" FontSize="11" Height="30" />
                                    <CalendarDatePicker Date="{Binding NewDuePickerDate, Converter={StaticResource Dto}, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                                <TextBox Grid.Column="1" PlaceholderText="Optional notes" FontSize="12.5" Height="36"
                                         Text="{Binding NewTaskNotes, Mode=TwoWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Cancel" FontSize="12" Height="34" Background="Transparent" BorderThickness="0"
                                        Command="{Binding CancelComposerCommand}" />
                                <Button Content="Add task" FontSize="12" Height="34" Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{Binding CanAddTask}" Command="{Binding QuickAddCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- content area -->
                <Grid Grid.Row="3">
                    <!-- List / Finished -->
                    <ListView x:Name="TaskList" Margin="8,0,8,8" SelectionMode="None"
                              ItemTemplate="{StaticResource TaskRow}"
                              Visibility="{Binding ShowListOrFinished, Converter={StaticResource BoolVis}}">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="models:TodoTaskGroup">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,14,4,4">
                                            <TextBlock Text="{x:Bind Header}" FontWeight="SemiBold" FontSize="10.5"
                                                       CharacterSpacing="90" Foreground="{ThemeResource AppTextSecondary}" />
                                            <Border Padding="6,1" CornerRadius="8" Background="{ThemeResource AppSubtleFill}">
                                                <TextBlock Text="{x:Bind CountLabel}" FontSize="10"
                                                           Foreground="{ThemeResource AppTextTertiary}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>

                    <!-- Board -->
                    <Grid ColumnSpacing="10" Padding="12" Visibility="{Binding IsBoardView, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="10" BorderThickness="1" CornerRadius="10"
                                BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppBackground}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding BoardHigh.Header}" Style="{StaticResource FieldLabel}" />
                                <ListView Grid.Row="1" ItemsSource="{Binding BoardHigh}" ItemTemplate="{StaticResource BoardCard}" SelectionMode="None" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Padding="10" BorderThickness="1" CornerRadius="10"
                                BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppBackground}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding BoardMedium.Header}" Style="{StaticResource FieldLabel}" />
                                <ListView Grid.Row="1" ItemsSource="{Binding BoardMedium}" ItemTemplate="{StaticResource BoardCard}" SelectionMode="None" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Padding="10" BorderThickness="1" CornerRadius="10"
                                BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppBackground}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding BoardLow.Header}" Style="{StaticResource FieldLabel}" />
                                <ListView Grid.Row="1" ItemsSource="{Binding BoardLow}" ItemTemplate="{StaticResource BoardCard}" SelectionMode="None" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="3" Padding="10" BorderThickness="1" CornerRadius="10"
                                BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppBackground}">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding BoardNone.Header}" Style="{StaticResource FieldLabel}" />
                                <ListView Grid.Row="1" ItemsSource="{Binding BoardNone}" ItemTemplate="{StaticResource BoardCard}" SelectionMode="None" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Calendar week -->
                    <Grid Padding="12,0,6,8" RowSpacing="8" Visibility="{Binding IsCalendarView, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" FontSize="11" Width="30" Height="30"
                                    Background="{ThemeResource AppSubtleFill}" Command="{Binding WeekPrevCommand}" />
                            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" FontSize="11" Width="30" Height="30"
                                    Background="{ThemeResource AppSubtleFill}" Command="{Binding WeekNextCommand}" />
                            <TextBlock Text="{Binding WeekRangeLabel}" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource AppTextPrimary}" />
                            <Button Content="Today" FontSize="11.5" Height="30" Margin="8,0,0,0" Command="{Binding CalendarTodayCommand}" />
                        </StackPanel>
                        <!-- exactly 7 equal columns; populated in code-behind on WeekRebuilt
                             (WinUI DataTemplate.LoadContent + DataContext wires x:Bind, unlike MAUI) -->
                        <Grid Grid.Row="1" x:Name="WeekGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- RIGHT detail -->
        <Border Grid.Column="1" Style="{StaticResource Pane}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
            <ScrollViewer Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Task" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SelectedTask.Title, Mode=TwoWay}" PlaceholderText="Task title" FontSize="14" />

                    <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding PriorityOptions}" HorizontalAlignment="Stretch"
                              SelectedValue="{Binding SelectedTask.Priority, Mode=TwoWay}" />

                    <TextBlock Text="Due date" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker Date="{Binding SelectedDueDate, Converter={StaticResource Dto}, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Today" FontSize="11" Height="32" Command="{Binding SetDueTodayCommand}" />
                        <Button Grid.Column="2" Content="Clear" FontSize="11" Height="32" Background="Transparent" BorderThickness="0"
                                Visibility="{Binding SelectedHasDueDate, Converter={StaticResource BoolVis}}"
                                Command="{Binding ClearDueDateCommand}" />
                    </Grid>

                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SelectedTask.Notes, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="90" FontSize="12.5" PlaceholderText="Optional notes" />

                    <TextBlock Text="Repeats" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding RecurrenceOptions}" HorizontalAlignment="Stretch"
                              SelectedValue="{Binding SelectedRecurrence, Mode=TwoWay}" />

                    <TextBlock Text="Linked records" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding SelectedTask.Links}"
                                  Visibility="{Binding SelectedTask.HasLinks, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskLink">
                                <Grid ColumnSpacing="6" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="9,5" CornerRadius="9" BorderThickness="1" HorizontalAlignment="Left"
                                            BorderBrush="{ThemeResource PrimaryTextBrush}">
                                        <TextBlock Text="{x:Bind Label}" FontSize="11" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    </Border>
                                    <Button Grid.Column="1" Content="Unlink" FontSize="11" Height="30" Background="Transparent"
                                            BorderThickness="0" Click="Unlink_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox PlaceholderText="Add a PR / RFQ / PO number" FontSize="13" Height="36"
                             Text="{Binding LinkQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Border BorderThickness="1" CornerRadius="7" BorderBrush="{ThemeResource AppHairline}"
                            Background="{ThemeResource AppTertiaryBackground}"
                            Visibility="{Binding ShowLinkResults, Converter={StaticResource BoolVis}}">
                        <ListView ItemsSource="{Binding LinkResults}" SelectionMode="None" MaxHeight="176"
                                  ItemClick="LinkResult_Click" IsItemClickEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaskLinkTarget">
                                    <Grid Padding="4,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="5,1" CornerRadius="9" MinWidth="40" Background="{ThemeResource AppSubtleFill}" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Type}" FontSize="9" Foreground="{ThemeResource AppTextTertiary}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" FontSize="11.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <TextBlock Text="Subtasks" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding SelectedSubtasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TodoTask">
                                <Grid ColumnSpacing="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource IconBtn}" FontSize="13" Click="Subtask_Toggle"
                                            Content="{x:Bind IsDone, Converter={StaticResource DoneGlyph}, Mode=OneWay}"
                                            Foreground="{ThemeResource AppTextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextPrimary}"
                                               TextDecorations="{x:Bind IsDone, Converter={StaticResource Strike}, Mode=OneWay}" />
                                    <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE74D;" FontSize="10"
                                            Width="22" Foreground="{ThemeResource AppTextTertiary}" Click="Subtask_Delete" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox PlaceholderText="Add a subtask" FontSize="12" KeyDown="Subtask_KeyDown"
                             Text="{Binding NewSubtaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Height="1" Background="{ThemeResource AppHairline}" Margin="0,4" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Reorder" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconBtn}" Content="&#xE70E;" FontSize="11" Width="34" Height="30"
                                Background="{ThemeResource AppSubtleFill}" Command="{Binding MoveSelectedCommand}" CommandParameter="Up" />
                        <Button Style="{StaticResource IconBtn}" Content="&#xE70D;" FontSize="11" Width="34" Height="30"
                                Background="{ThemeResource AppSubtleFill}" Command="{Binding MoveSelectedCommand}" CommandParameter="Down" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource AppHairline}" Margin="0,4" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Mark done" Style="{StaticResource AccentButtonStyle}" Height="36" FontSize="12.5"
                                HorizontalAlignment="Stretch" Click="MarkDone_Click" />
                        <Button Grid.Column="1" Content="Delete" Height="36" FontSize="12.5" Padding="16,0" Click="DeleteTask_Click" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="24" HorizontalAlignment="Center"
                       Foreground="{ThemeResource AppTextTertiary}" />
            <TextBlock Text="Select a task to see details" FontSize="12.5" Foreground="{ThemeResource AppTextTertiary}" />
        </StackPanel>
    </Grid>
</Page>
