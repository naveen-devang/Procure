<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.ApprovalConfigModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models">

    <Grid Background="#B3000000">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border MaxWidth="660" MaxHeight="680" Margin="24" Padding="24" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="1"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <StackPanel Spacing="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Configure Approval Stages" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource AppTextPrimary}" />
                        <TextBlock Text="Add, remove, rename, and drag to reorder approval stages."
                                   FontSize="12" Foreground="{ThemeResource AppTextTertiary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                            Command="{Binding CloseApprovalConfigModalCommand}" />
                </Grid>

                <ListView ItemsSource="{Binding ConfiguringApprovals}" SelectionMode="None" MaxHeight="320"
                          CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Approval">
                            <Border Padding="10,8" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppTertiaryBackground}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="Include this stage" />
                                    <TextBox Grid.Column="1" Text="{x:Bind Role, Mode=TwoWay}" PlaceholderText="Stage Title (e.g. Finance Controller)"
                                             FontSize="13" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                            Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="{ThemeResource FluentCritical}" Click="Remove_Click"
                                            ToolTipService.ToolTip="Remove Stage" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Padding="10,8" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSecondaryBackground}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewStageRoleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="New stage title (e.g. Legal Counsel, Compliance)..." FontSize="13" />
                        <Button Grid.Column="1" Content="+ Add Stage" Style="{StaticResource AccentButtonStyle}" FontSize="12"
                                Command="{Binding AddNewStageToConfigCommand}" />
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CloseApprovalConfigModalCommand}" />
                    <Button Content="Save Stages" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveApprovalConfigModalCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
