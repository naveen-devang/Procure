<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.BatchPoModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models">

    <Grid Background="#B3000000">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border MaxWidth="480" Margin="24" Padding="26" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" BorderThickness="1"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <StackPanel Spacing="14">
                <TextBlock Style="{StaticResource AppText}" Text="Create Master Combined Purchase Order" FontWeight="SemiBold" FontSize="16"
                           Foreground="{ThemeResource AppTextPrimary}" />
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AppText}" Text="PO Number *" FontSize="12" Foreground="{ThemeResource AppTextPrimary}" />
                    <TextBox Text="{Binding BatchPoNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. PO-2026-901" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AppText}" Text="Vendor Name *" FontSize="12" Foreground="{ThemeResource AppTextPrimary}" />
                    <AutoSuggestBox x:Name="VendorBox" Text="{Binding BatchPoVendor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Vendor Name"
                                    AutomationProperties.Name="Vendor name">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:VendorSuggestion">
                                <StackPanel Padding="0,5" Spacing="1">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="11.5" Foreground="{ThemeResource AppTextSecondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource AppText}" FontSize="12" Foreground="{ThemeResource AppTextPrimary}"
                               Text="{Binding BatchPoCurrency, Converter={StaticResource Fmt}, ConverterParameter='Total Combined PO Value ({0}) *'}" />
                    <TextBox Text="{Binding BatchPoTotalValue, Mode=TwoWay, Converter={StaticResource Num}, ConverterParameter=decimal, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Command="{Binding CloseBatchPoModalCommand}" />
                    <Button Content="Create Combined PO" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveBatchPoModalCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
