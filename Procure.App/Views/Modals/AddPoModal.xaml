<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.AddPoModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border MaxWidth="980" MaxHeight="860" Margin="24" CornerRadius="10" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- header + stepper -->
                <StackPanel Padding="20,14,16,12" Spacing="10" Background="{ThemeResource AppTertiaryBackground}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding PoModalTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock Text="{Binding AddPoModalSubtitle}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                Command="{Binding CloseAddPoModalCommand}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10"
                                Visibility="{Binding IsEditPoMode, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Border Padding="10,4" CornerRadius="12" BorderThickness="0"
                                Background="{Binding IsPoModalStep1, Converter={StaticResource ChipBg}}"
                                BorderBrush="{Binding IsPoModalStep1, Converter={StaticResource ChipStroke}}">
                            <TextBlock Text="1  Select Supplier Quotes" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{Binding IsPoModalStep1, Converter={StaticResource ChipText}}" />
                        </Border>
                        <TextBlock Text="&#x2192;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AppTextTertiary}" />
                        <Border Padding="10,4" CornerRadius="12" BorderThickness="0"
                                Background="{Binding IsPoModalStep2, Converter={StaticResource ChipBg}}"
                                BorderBrush="{Binding IsPoModalStep2, Converter={StaticResource ChipStroke}}">
                            <TextBlock Text="2  Configure PO Details &amp; Quantities" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{Binding IsPoModalStep2, Converter={StaticResource ChipText}}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="20,16">
                    <Grid>
                        <!-- ===== STEP 1 ===== -->
                        <StackPanel Spacing="14" Visibility="{Binding IsPoModalStep1, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Select Supplier Quotation(s) to Award" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                                    <TextBlock Text="Select one or more quotes. A separate PO is created for each selected supplier in the next step."
                                               FontSize="11.5" Foreground="{ThemeResource AppTextSecondary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding AllPoRfqsSelected, Converter={StaticResource SelAll}}" FontSize="11" Height="28" Padding="10,0"
                                        Command="{Binding ToggleAllPoRfqsCommand}" />
                            </Grid>
                            <TextBlock Text="No RFQ or vendor quotes found for this requisition. Create and price an RFQ first."
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondary}"
                                       Visibility="{Binding HasPoRfqs, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding PoRfqSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PoRfqSelection">
                                        <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSecondaryBackground}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind VendorName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                                                        <Border Padding="6,1" CornerRadius="10" MinWidth="46" BorderThickness="0" BorderBrush="{ThemeResource AppControlBorder}"
                                                                Background="{ThemeResource AppSubtleFill}"
                                                                Visibility="{x:Bind HasRfqNumber, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{x:Bind RfqNumber}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondary}" />
                                                        </Border>
                                                        <Border Padding="6,1" CornerRadius="10" MinWidth="46" BorderThickness="0" BorderBrush="{ThemeResource FluentSuccess}"
                                                                Background="{ThemeResource FluentSuccessBg}"
                                                                Visibility="{x:Bind HasTechnicalApproval, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{x:Bind TechnicalApproval}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource FluentSuccess}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource AppTextSecondary}">
                                                        <Run Text="{x:Bind SelectedItemsSummary}" /><Run Text="  ·  " /><Run Text="{x:Bind Incoterms}" /><Run Text="  ·  " /><Run Text="{x:Bind PaymentTerms}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FormattedDisplayAmount, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" Foreground="{ThemeResource FluentSuccess}" />
                                                    <TextBlock Text="Total Landed Cost" FontSize="10" HorizontalAlignment="Right" Foreground="{ThemeResource AppTextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ===== STEP 2 ===== -->
                        <StackPanel Spacing="14"
                                    Visibility="{Binding IsPoModalStep2, Converter={StaticResource BoolVis}}">
                            <Border Padding="12,8" CornerRadius="6" BorderThickness="1"
                                    Visibility="{Binding PoAllocationSummaryText, Converter={StaticResource NullVis}}"
                                    BorderBrush="{Binding PoAllocationSummaryText, Converter={StaticResource FulfilStroke}}"
                                    Background="{Binding PoAllocationSummaryText, Converter={StaticResource FulfilBg}}">
                                <TextBlock Text="{Binding PoAllocationSummaryText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{Binding PoAllocationSummaryText, Converter={StaticResource FulfilColor}}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding PoRfqSelections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PoRfqSelection">
                                        <Border Padding="16" Margin="0,0,0,16" CornerRadius="8" BorderThickness="1"
                                                Visibility="{x:Bind IsSelected, Converter={StaticResource BoolVis}, Mode=OneWay}"
                                                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppTertiaryBackground}">
                                            <StackPanel Spacing="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Rectangle Width="6" Height="18" RadiusX="2" RadiusY="2" Fill="{ThemeResource FluentSuccess}" />
                                                        <TextBlock Text="{x:Bind VendorName}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                                                        <Border Padding="6,1" CornerRadius="10" MinWidth="46" BorderThickness="0" BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSubtleFill}">
                                                            <TextBlock Text="{x:Bind Currency, Converter={StaticResource Fmt}, ConverterParameter='Currency: {0}'}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource AppTextPrimary}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="PO Amount:" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                                                        <TextBlock Text="{x:Bind FormattedDisplayAmount, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource FluentSuccess}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="240" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="PO Number *" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind PoNo, Mode=TwoWay}" PlaceholderText="e.g. PO-2026-101" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="Enter a unique PO reference for this supplier" FontSize="11"
                                                               VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondary}" />
                                                </Grid>

                                                <Border BorderThickness="1" CornerRadius="8" Padding="12,10" BorderBrush="{ThemeResource AppHairline}"
                                                        Visibility="{x:Bind IsRawMaterial, Converter={StaticResource BoolVis}}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="Transport" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="Contract Number" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind TransportContractNumber, Mode=TwoWay}" PlaceholderText="e.g. TC-2026-014" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <TextBlock Text="Transporter Name" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind TransporterName, Mode=TwoWay}" PlaceholderText="e.g. Al Futtaim Logistics" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="4">
                                                                <TextBlock Text="Rate / Unit" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind TransportRatePerUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Spacing="4">
                                                                <TextBlock Text="Transport Total" Style="{StaticResource Lbl}" />
                                                                <TextBlock Text="{x:Bind FormattedTransportTotal, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Spacing="8" Visibility="{x:Bind HasItems, Converter={StaticResource BoolVis}}">
                                                    <ItemsControl ItemsSource="{x:Bind Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:PoRfqItemSelection">
                                                                <Border Padding="10,6" Margin="0,0,0,4" CornerRadius="4" BorderThickness="1"
                                                                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSecondaryBackground}">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="36" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="75" />
                                                                            <ColumnDefinition Width="45" />
                                                                            <ColumnDefinition Width="95" />
                                                                            <ColumnDefinition Width="85" />
                                                                            <ColumnDefinition Width="100" />
                                                                            <ColumnDefinition Width="28" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind ItemName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{ThemeResource AppTextPrimary}" />
                                                                            <TextBlock Text="{x:Bind AllocationStatusText, Mode=OneWay}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{x:Bind AllocationStatusText, Converter={StaticResource FulfilColor}, Mode=OneWay}" />
                                                                        </StackPanel>
                                                                        <TextBox Grid.Column="2" Text="{x:Bind Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Text="{x:Bind Unit}" FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondary}" />
                                                                        <TextBox Grid.Column="4" Text="{x:Bind QuotedUnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="11.5" VerticalAlignment="Center" />
                                                                        <TextBox Grid.Column="5" Text="{x:Bind Discount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="11.5" VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedLineTotal, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                                                                        <Button Grid.Column="7" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" Width="26" Height="26" Padding="0"
                                                                                Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AppTextSecondary}"
                                                                                VerticalAlignment="Center" Click="RemoveLine_Click" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <Border Padding="14,10" CornerRadius="6" BorderThickness="1"
                                                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSubtleFill}">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="Commercial Terms &amp; Landed Cost Breakdown" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="Base Price" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind CustomBaseAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="11.5" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Text="Freight (+)" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind Freight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="11.5" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                <TextBlock Text="Other Charges (+)" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind OtherCharges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="11.5" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="3" Spacing="2">
                                                                <TextBlock Text="Total Discount (-)" Style="{StaticResource Lbl}" />
                                                                <TextBox Text="{x:Bind OverallDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" FontSize="11.5" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Spacing="2">
                                                                <TextBlock Text="VAT Type" Style="{StaticResource Lbl}" />
                                                                <ComboBox HorizontalAlignment="Stretch" FontSize="11.5" SelectedValue="{x:Bind VatType, Mode=TwoWay}">
                                                                    <x:String>5%</x:String>
                                                                    <x:String>RC</x:String>
                                                                    <x:String>V0</x:String>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{x:Bind FormattedVatAmount, Converter={StaticResource Fmt}, ConverterParameter='Calculated VAT: +{0}', Mode=OneWay}"
                                                                       FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AppTextSecondary}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <TextBlock Text="Total PO Value:" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                                                                <TextBlock Text="{x:Bind FormattedDisplayAmount, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource FluentSuccess}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- footer -->
                <Grid Grid.Row="2" Padding="20,14" ColumnSpacing="10" Background="{ThemeResource AppTertiaryBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Cancel" Command="{Binding CloseAddPoModalCommand}"
                            Visibility="{Binding IsPoModalStep1, Converter={StaticResource BoolVis}}" />
                    <Button Content="{Binding PoModalBackButtonText}" Command="{Binding GoToPoStep1Command}"
                            Visibility="{Binding IsPoModalStep2, Converter={StaticResource BoolVis}}" />
                    <Border Grid.Column="1" Padding="12,6" CornerRadius="16" MinWidth="70" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding SelectedPoRfqCount, Converter={StaticResource Fmt}, ConverterParameter='Selected: {0} quote(s)'}"
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock Text="·" FontSize="11.5" Foreground="{ThemeResource AppTextTertiary}" />
                            <TextBlock Text="{Binding TotalPoAmountSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource FluentSuccess}" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Content="Next: Configure PO(s) →" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding GoToPoStep2Command}" IsEnabled="{Binding CanGoToPoStep2}"
                            Visibility="{Binding IsPoModalStep1, Converter={StaticResource BoolVis}}" />
                    <Button Grid.Column="2" Content="{Binding PoModalSaveButtonText}" Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding SaveNewPoCommand}"
                            Visibility="{Binding IsPoModalStep2, Converter={StaticResource BoolVis}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
