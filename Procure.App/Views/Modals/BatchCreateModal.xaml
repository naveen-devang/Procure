<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.BatchCreateModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#B3000000">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border MaxWidth="1020" MaxHeight="840" Margin="24" Padding="24" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="1"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding ModalTitle}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource AppTextPrimary}" />
                        <TextBlock Text="{Binding ModalSubtitle}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                            Command="{Binding CloseBatchCreateModalCommand}" />
                </Grid>

                <Border Grid.Row="1" Padding="14,10" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppTertiaryBackground}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="New Row Defaults" VerticalAlignment="Center" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11" ItemsSource="{Binding AllPlants}" SelectedValue="{Binding BatchSharedPlant, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" FontSize="11" ItemsSource="{Binding AllPrTypes}" SelectedValue="{Binding BatchSharedPrType, Mode=TwoWay}" />
                        <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" FontSize="11" ItemsSource="{Binding AllPriorities}" SelectedValue="{Binding BatchSharedPriority, Mode=TwoWay}" />
                        <TextBox Grid.Column="4" FontSize="11" PlaceholderText="Default requestor" Text="{Binding BatchSharedRequestor, Mode=TwoWay}" />
                        <TextBox Grid.Column="5" FontSize="11" PlaceholderText="Notes / purpose" Text="{Binding BatchSharedNotes, Mode=TwoWay}" />
                        <Button Grid.Column="6" Content="Apply to all rows" FontSize="11" Height="32" Padding="12,0"
                                Command="{Binding ApplyDefaultsToAllRowsCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RequisitionsSectionLabel}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Paste rows from Excel" FontSize="11" Height="28" Padding="12,0" Command="{Binding PasteBatchPrRowsFromClipboardCommand}" />
                        <Button Content="+ Add Row" FontSize="11" Height="28" Padding="12,0" Command="{Binding AddBatchPrRowCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView Width="220" ItemsSource="{Binding BatchPrEntries}" SelectionMode="Single"
                              SelectedItem="{Binding SelectedBatchEntry, Mode=TwoWay}"
                              Visibility="{Binding IsBulkMode, Converter={StaticResource BoolVis}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BatchPrEntry">
                                <StackPanel Spacing="3" Padding="4,6">
                                    <TextBlock Text="{x:Bind PrNo, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind ItemsCount, Mode=OneWay}" FontSize="9.5" Foreground="{ThemeResource AppTextSecondary}"
                                                   Visibility="{x:Bind HasItems, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentFillBrush}"
                                                 Visibility="{x:Bind HasCustomizations, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Column="1">
                        <StackPanel Spacing="14" Padding="0,0,16,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PR Number *" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding SelectedBatchEntry.PrNo, Mode=TwoWay}" PlaceholderText="e.g. PR-2026-001" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Description / Summary" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding SelectedBatchEntry.Description, Mode=TwoWay}" PlaceholderText="Requisition title..." FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PR Type *" Style="{StaticResource Lbl}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllPrTypes}"
                                              SelectedValue="{Binding SelectedBatchEntry.PrType, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Plant" Style="{StaticResource Lbl}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllPlants}"
                                              SelectedValue="{Binding SelectedBatchEntry.Plant, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Priority" Style="{StaticResource Lbl}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllPriorities}"
                                              SelectedValue="{Binding SelectedBatchEntry.Priority, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="Requestor" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding SelectedBatchEntry.Requestor, Mode=TwoWay}" PlaceholderText="Requestor / team" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppHairline}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Line Items" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Paste items from Excel" FontSize="11" Height="28" Padding="10,0"
                                            Command="{Binding PasteBatchItemsFromClipboardCommand}" CommandParameter="{Binding SelectedBatchEntry}" />
                                    <Button Content="+ Add Item" FontSize="11" Height="28" Padding="10,0"
                                            Command="{Binding AddBatchItemToPrCommand}" CommandParameter="{Binding SelectedBatchEntry}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedBatchEntry.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PrItem">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind ItemName, Mode=TwoWay}" TextWrapping="Wrap" Height="46" PlaceholderText="Item name / spec..."
                                                     FontSize="12" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{x:Bind Quantity, Mode=TwoWay}" PlaceholderText="Qty" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="2" Text="{x:Bind Unit, Mode=TwoWay}" PlaceholderText="pcs" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="3" Text="{x:Bind EstimatedUnitPrice, Mode=TwoWay}" PlaceholderText="Price" FontSize="12" VerticalAlignment="Center" />
                                            <Button Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="11" Width="28" Height="28" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource FluentCritical}" VerticalAlignment="Center"
                                                    Click="RemoveItem_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="8" Visibility="{Binding CustomColumnDefinitions.Count, Converter={StaticResource CountVis}}">
                                <Border Height="1" Background="{ThemeResource AppHairline}" />
                                <TextBlock Text="Custom Fields" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource AppTextPrimary}" />
                                <ItemsControl ItemsSource="{Binding SelectedBatchEntry.CustomValues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomFieldValue">
                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                <TextBlock Text="{x:Bind ColumnName}" Style="{StaticResource Lbl}" />
                                                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind OptionsList}" SelectedValue="{x:Bind Value, Mode=TwoWay}"
                                                          Visibility="{x:Bind IsSelect, Converter={StaticResource BoolVis}}" />
                                                <CalendarDatePicker Date="{x:Bind DateValue, Converter={StaticResource Dto}, Mode=TwoWay}"
                                                                    Visibility="{x:Bind IsDate, Converter={StaticResource BoolVis}}" />
                                                <TextBox Text="{x:Bind Value, Mode=TwoWay}" Visibility="{x:Bind IsNumber, Converter={StaticResource BoolVis}}" />
                                                <TextBox Text="{x:Bind Value, Mode=TwoWay}" Visibility="{x:Bind IsText, Converter={StaticResource BoolVis}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="4" Margin="0,4,0,0" Padding="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="{ThemeResource AppHairline}" />
                    <TextBlock Text="{Binding BatchEntriesSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource AppTextSecondary}"
                               Visibility="{Binding IsBulkMode, Converter={StaticResource BoolVis}}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Content="Cancel" Command="{Binding CloseBatchCreateModalCommand}" />
                        <Button Content="{Binding SaveButtonText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveBatchPrsModalCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
