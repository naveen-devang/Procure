<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.BatchCreateModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models"
    xmlns:views="using:Procure.App.Views">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock" BasedOn="{StaticResource AppText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#B3000000">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border MaxWidth="1020" MaxHeight="840" Margin="24" Padding="24" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" BorderThickness="1"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <Grid RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource AppText}" Text="{Binding ModalTitle}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource AppTextPrimary}" />
                        <TextBlock Style="{StaticResource AppText}" Text="{Binding ModalSubtitle}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                    </StackPanel>
                    <Button ToolTipService.ToolTip="Close" Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                            Command="{Binding CloseBatchCreateModalCommand}" />
                </Grid>

                <Border Grid.Row="1" Padding="14,10" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppTertiaryBackground}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="New Row Defaults" Style="{StaticResource Lbl}" />
                            <TextBlock Style="{StaticResource AppText}" Text="applied to rows you add next" FontSize="10" Foreground="{ThemeResource AppTextTertiary}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11" ItemsSource="{Binding AllPlants}" SelectedItem="{Binding BatchSharedPlant, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" FontSize="11" ItemsSource="{Binding AllPrTypes}" SelectedItem="{Binding BatchSharedPrType, Mode=TwoWay}" />
                        <ComboBox Grid.Column="3" HorizontalAlignment="Stretch" FontSize="11" ItemsSource="{Binding AllPriorities}" SelectedItem="{Binding BatchSharedPriority, Mode=TwoWay}" />
                        <TextBox Grid.Column="4" FontSize="11" PlaceholderText="Default requestor" Text="{Binding BatchSharedRequestor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="5" FontSize="11" PlaceholderText="Notes / purpose" Text="{Binding BatchSharedNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="6" Content="Apply to all rows" FontSize="11" Height="{StaticResource ControlHeightStd}" Padding="12,0"
                                Command="{Binding ApplyDefaultsToAllRowsCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource AppText}" Text="{Binding RequisitionsSectionLabel}" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Paste rows from Excel" FontSize="11" Height="28" Padding="12,0" Command="{Binding PasteBatchPrRowsFromClipboardCommand}" />
                        <Button Content="+ Add Row" FontSize="11" Height="28" Padding="12,0" Command="{Binding AddBatchPrRowCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView Width="220" ItemsSource="{Binding BatchPrEntries}" SelectionMode="Single"
                              SelectedItem="{Binding SelectedBatchEntry, Mode=TwoWay}"
                              Visibility="{Binding IsBulkMode, Converter={StaticResource BoolVis}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BatchPrEntry">
                                <StackPanel Spacing="3" Padding="4,6">
                                    <TextBlock Style="{StaticResource AppText}" Text="{x:Bind PrNo, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppTextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Style="{StaticResource AppText}" Text="{x:Bind ItemsCount, Mode=OneWay}" FontSize="9.5" Foreground="{ThemeResource AppTextSecondary}"
                                                   Visibility="{x:Bind HasItems, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource AccentFillBrush}"
                                                 Visibility="{x:Bind HasCustomizations, Converter={StaticResource BoolVis}, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Visible">
                        <StackPanel Spacing="14" Padding="0,0,16,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PR Number *" Style="{StaticResource Lbl}" />
                                    <TextBox x:Name="FirstField" Text="{Binding SelectedBatchEntry.PrNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. PR-2026-001" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Description / Summary" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding SelectedBatchEntry.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Requisition title..." FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PR Type *" Style="{StaticResource Lbl}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllPrTypes}"
                                              SelectedItem="{Binding SelectedBatchEntry.PrType, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Plant" Style="{StaticResource Lbl}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllPlants}"
                                              SelectedItem="{Binding SelectedBatchEntry.Plant, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Priority" Style="{StaticResource Lbl}" />
                                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllPriorities}"
                                              SelectedItem="{Binding SelectedBatchEntry.Priority, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="4">
                                    <TextBlock Text="Requestor" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding SelectedBatchEntry.Requestor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Requestor / team" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="Requested For" Style="{StaticResource Lbl}" />
                                    <TextBox Text="{Binding SelectedBatchEntry.RequestedFor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. E&amp;I" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppHairline}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource AppText}" Text="Line Items" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Paste items from Excel" FontSize="11" Height="28" Padding="10,0"
                                            Command="{Binding PasteBatchItemsFromClipboardCommand}" CommandParameter="{Binding SelectedBatchEntry}" />
                                    <Button Content="+ Add Item" FontSize="11" Height="28" Padding="10,0"
                                            Command="{Binding AddBatchItemToPrCommand}" CommandParameter="{Binding SelectedBatchEntry}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="8" Padding="0,0,0,2">
                                <Grid.Resources>
                                    <Style BasedOn="{StaticResource AppText}" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{ThemeResource AppTextTertiary}" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ITEM" />
                                <TextBlock Grid.Column="1" Text="QTY" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="UNIT" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="EST. UNIT PRICE" />
                                <Border Grid.Column="4" Width="28" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SelectedBatchEntry.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PrItem">
                                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="36" MaxHeight="110" PlaceholderText="Item name / spec..."
                                                     FontSize="12" VerticalAlignment="Top" />
                                            <TextBox Height="36" VerticalAlignment="Top" Grid.Column="1" Text="{x:Bind Quantity, Mode=TwoWay, Converter={StaticResource Num}, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Qty" FontSize="12" TextAlignment="Center" />
                                            <TextBox Height="36" VerticalAlignment="Top" Grid.Column="2" Text="{x:Bind Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="pcs" FontSize="12" TextAlignment="Center" />
                                            <TextBox Height="36" VerticalAlignment="Top" Grid.Column="3" Text="{x:Bind EstimatedPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Price or 0.00 usd" FontSize="12"
                                                     ToolTipService.ToolTip="A currency typed with the number - e.g. 86.75 usd - is kept; otherwise the row keeps its last currency" />
                                            <Button ToolTipService.ToolTip="Remove Item" Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="11" Width="28" Height="28" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource FluentCritical}" VerticalAlignment="Top" Margin="0,4,0,0"
                                                    Click="RemoveItem_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Spacing="8" Visibility="{Binding CustomColumnDefinitions.Count, Converter={StaticResource CountVis}}">
                                <Border Height="1" Background="{ThemeResource AppHairline}" />
                                <Grid>
                                    <TextBlock Style="{StaticResource AppText}" Text="Custom Fields" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AppTextPrimary}" />
                                    <!-- Adding several PRs: fills this row's values into rows that have none - never overwrites. -->
                                    <Button Content="Copy to all rows" FontSize="11" Height="28" Padding="10,0" HorizontalAlignment="Right"
                                            Command="{Binding CopyCustomFieldsToAllRowsCommand}" CommandParameter="{Binding SelectedBatchEntry}"
                                            ToolTipService.ToolTip="Fills this value into any other row that doesn't already have one set - never overwrites"
                                            Visibility="{Binding IsBulkMode, Converter={StaticResource BoolVis}}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SelectedBatchEntry.CustomValues}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:WrapPanel HorizontalSpacing="12" VerticalSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <!-- Only the input for the field's type is built (x:Load). All four used to exist with three hidden,
                                             each bound to the same value: the hidden dropdown and date picker wrote their own
                                             empty / today's-date value back and wiped what was typed. -->
                                        <DataTemplate x:DataType="models:CustomFieldValue">
                                            <StackPanel Spacing="4" Margin="0,0,0,8" Width="280">
                                                <TextBlock Text="{x:Bind ColumnName}" Style="{StaticResource Lbl}" />
                                                <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Not set" ItemTemplate="{StaticResource StringItemTemplate}" ItemsSource="{x:Bind OptionsList}" SelectedItem="{x:Bind Value, Mode=TwoWay}" x:Name="CfSelect" x:Load="{x:Bind IsSelect}" />
                                                <CalendarDatePicker Date="{x:Bind DateValue, Converter={StaticResource Dto}, Mode=TwoWay}" x:Name="CfDate" x:Load="{x:Bind IsDate}" />
                                                <TextBox x:Name="CfNumber" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Load="{x:Bind IsNumber}" />
                                                <TextBox x:Name="CfText" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Load="{x:Bind IsText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid Grid.Row="4" Margin="0,4,0,0" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Height="1" Background="{ThemeResource AppHairline}" />
                    <TextBlock Style="{StaticResource AppText}" Grid.Row="1" Text="{Binding BatchEntriesSummary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource AppTextSecondary}"
                               Visibility="{Binding IsBulkMode, Converter={StaticResource BoolVis}}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Content="Cancel" Command="{Binding CloseBatchCreateModalCommand}" />
                        <Button Content="{Binding SaveButtonText}" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveBatchPrsModalCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
