<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.SplitPrModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models">

    <Grid Background="#B3000000">
        <Border MaxWidth="660" MaxHeight="760" Margin="24" Padding="26" CornerRadius="10"
                VerticalAlignment="Center" HorizontalAlignment="Center" BorderThickness="1"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Split Combined Requisition" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock Text="{Binding SplitTargetMasterPr.PrNo, Converter={StaticResource Fmt}, ConverterParameter='Master Requisition: {0}'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                                Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0"
                                Command="{Binding CloseSplitPrModalCommand}" />
                    </Grid>

                    <Border Padding="12,10" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppTertiaryBackground}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Select which requisitions to keep combined:" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{ThemeResource AppTextPrimary}" />
                            <TextBlock Text="Checked requisitions stay combined; unchecked ones separate back into standalone PRs on your board."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource AppTextTertiary}" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SplitPrEntries.Count, Converter={StaticResource Fmt}, ConverterParameter='Source Requisitions ({0}):'}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Keep All" FontSize="11" Height="28" Padding="12,0" Command="{Binding SelectAllKeepCombinedCommand}" />
                            <Button Content="Split All" FontSize="11" Height="28" Padding="12,0" Command="{Binding SelectNoneKeepCombinedCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SplitPrEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SplitPrEntry">
                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppTertiaryBackground}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsKeepCombined, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind PrNo}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource PrimaryTextBrush}" />
                                                <TextBlock Text="{x:Bind Requestor}" FontSize="12" Foreground="{ThemeResource AppTextPrimary}" />
                                                <TextBlock Text="{x:Bind Plant}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                                <TextBlock Text="{x:Bind Priority}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{x:Bind Priority, Converter={StaticResource PriorityColor}}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind ItemsSummary}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource AppTextTertiary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Padding="12,10" CornerRadius="6" BorderThickness="1"
                            BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
                        <TextBlock Text="{Binding SplitActionSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource AppTextPrimary}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseSplitPrModalCommand}" />
                        <Button Content="Confirm Split" Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{Binding CanConfirmSplit}" Command="{Binding ConfirmSplitPrModalCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
