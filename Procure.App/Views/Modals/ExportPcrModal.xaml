<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Procure.App.Views.Modals.ExportPcrModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models">

    <UserControl.Resources>
        <Style x:Key="Sec" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
            <Setter Property="Background" Value="{ThemeResource AppTertiaryBackground}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="H" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000">
        <Grid.ChildrenTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="18" />
            </TransitionCollection>
        </Grid.ChildrenTransitions>
        <Border MaxWidth="600" MaxHeight="640" Margin="24" CornerRadius="10" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Padding="20,16,16,14" Background="{ThemeResource AppTertiaryBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Export Price Comparison Sheet" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimary}" />
                        <TextBlock Text="{Binding ExportPcrSubtitle}" FontSize="12" Foreground="{ThemeResource AppTextSecondary}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12"
                            Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                            Command="{Binding CloseExportPcrModalCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="20,16">
                    <StackPanel Spacing="16">
                        <Border Style="{StaticResource Sec}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="1. Select Suppliers to Compare" Style="{StaticResource H}" />
                                    <Border Grid.Column="1" Padding="8,2,8,4" CornerRadius="11" MinWidth="54" BorderThickness="1"
                                            VerticalAlignment="Center"
                                            BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSubtleFill}">
                                        <TextBlock Text="{Binding SelectedRfqCountMessage}" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppTextPrimary}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="Choose up to 5 supplier quotations to display side-by-side:" FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondary}" />
                                <ItemsControl ItemsSource="{Binding ExportRfqSelections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ExportRfqSelection">
                                            <Border Padding="10,6" Margin="0,0,0,6" CornerRadius="4" BorderThickness="1"
                                                    BorderBrush="{ThemeResource AppHairline}" Background="{ThemeResource AppSecondaryBackground}">
                                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                                    <TextBlock Text="{x:Bind DisplaySummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource AppTextPrimary}" />
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Sec}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="2. Collective Number" Style="{StaticResource H}" />
                                <TextBlock Text="Optional. Printed on the sheet as-is; blank shows a dash." FontSize="11.5" Foreground="{ThemeResource AppTextSecondary}" />
                                <TextBox Text="{Binding ExportPcrCollectiveNumber, Mode=TwoWay}" PlaceholderText="e.g. PCR-2026-014" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Sec}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="3. Remarks / Justification" Style="{StaticResource H}" />
                                <TextBlock Text="Additional justification for the approvers. Saved for future exports." FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondary}" />
                                <TextBox Text="{Binding ExportPcrRemarks, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                         PlaceholderText="e.g. Required by Electrical Dept. on urgent basis" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="20,14" ColumnSpacing="8" Background="{ThemeResource AppTertiaryBackground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="Cancel" Command="{Binding CloseExportPcrModalCommand}" />
                    <Button Grid.Column="2" Content="Export / Print PDF" Command="{Binding ExportPcrPdfCommand}" />
                    <Button Grid.Column="3" Content="Export Excel (.xlsx)" Style="{StaticResource AccentButtonStyle}" Command="{Binding ExportPcrExcelCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
