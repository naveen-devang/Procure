<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Procure.App.Views.ServiceEntriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models"
    xmlns:pm="using:Procure.PageModels"
    xmlns:views="using:Procure.App.Views">

    <!-- The Service Entry register (design: artifact "Service Entry Register"). One table of service
         invoices, each moving Invoice in -> With technical -> SE done -> With accounts as its
         handover dates are filled. Standalone: nothing here touches PRs or POs. -->
    <Page.Resources>
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
            <Setter Property="Background" Value="{ThemeResource AppSecondaryBackground}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppHairline}" />
            <Setter Property="Background" Value="{ThemeResource AppTertiaryBackground}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="TileCap" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextTertiary}" />
        </Style>
        <Style x:Key="TileVal" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextTertiary}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="GroupHead" TargetType="Border">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppControlBorder}" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextPrimary}" />
        </Style>
        <Style x:Key="SectionCap" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextSecondary}" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackground}">
        <Grid Padding="24">

            <!-- ================= LEFT: the register ================= -->
            <Border Style="{StaticResource Pane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,12,12,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource NonSelectableText}" Text="Service Entries" FontSize="20" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{ThemeResource AppTextPrimary}" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                 PlaceholderText="Search PO, vendor, invoice no, SE no, description"
                                 Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Height="{StaticResource ControlHeightStd}" Command="{x:Bind Vm.ExportCommand}"
                                IsEnabled="{x:Bind Vm.CanExport, Mode=OneWay}"
                                ToolTipService.ToolTip="Everything in the current tab and search, as an Excel file">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Style="{StaticResource NonSelectableText}" Text="Export to Excel" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Height="{StaticResource ControlHeightStd}" Content="+ New Entry"
                                Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.NewEntryCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,10,12,0">
                        <SelectorBar x:Name="StageBar" SelectionChanged="StageBar_SelectionChanged">
                            <SelectorBarItem Tag="open" Text="{x:Bind Vm.OpenTab, Mode=OneWay}" IsSelected="True" />
                            <SelectorBarItem Tag="0" Text="{x:Bind Vm.InvoiceInTab, Mode=OneWay}" />
                            <SelectorBarItem Tag="1" Text="{x:Bind Vm.WithTechnicalTab, Mode=OneWay}" />
                            <SelectorBarItem Tag="2" Text="{x:Bind Vm.SeDoneTab, Mode=OneWay}" />
                            <SelectorBarItem Tag="3" Text="{x:Bind Vm.WithAccountsTab, Mode=OneWay}" />
                            <SelectorBarItem Tag="all" Text="{x:Bind Vm.AllTab, Mode=OneWay}" />
                        </SelectorBar>
                    </Grid>

                    <Grid Grid.Row="2" Margin="12" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TileCap}" Text="OPEN INVOICES" />
                                <TextBlock Style="{StaticResource TileVal}" Text="{x:Bind Vm.OpenCount, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileSub}" Text="{x:Bind Vm.OpenAmount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Tile}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TileCap}" Text="WITH TECHNICAL" />
                                <TextBlock Style="{StaticResource TileVal}" Text="{x:Bind Vm.TechCount, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileSub}" Text="waiting to come back" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Tile}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TileCap}" Text="{x:Bind Vm.LateCaption, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileVal}" Text="{x:Bind Vm.LateCount, Mode=OneWay}"
                                           Foreground="{x:Bind Vm.HasLate, Mode=OneWay, Converter={StaticResource LateText}}" />
                                <TextBlock Style="{StaticResource TileSub}" Text="change the days in Settings" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Tile}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource TileCap}" Text="{x:Bind Vm.SentCaption, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileVal}" Text="{x:Bind Vm.SentCount, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource TileSub}" Text="{x:Bind Vm.SentAmount, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- The table scrolls sideways on a narrow window rather than squeezing the vendor
                         column to nothing; the list inside still virtualizes vertically. -->
                    <ScrollViewer x:Name="TableScroll" Grid.Row="3" Margin="12,0,12,12" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" SizeChanged="TableScroll_SizeChanged">
                        <Grid x:Name="TableGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid BorderThickness="0,1,0,1" BorderBrush="{ThemeResource AppHairline}" Padding="10,6,0,8" RowSpacing="6">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Reset column widths" Click="ResetColumns_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C0, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C1, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C2, Mode=OneWay}" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C3, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C4, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C5, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C6, Mode=OneWay}" />
                                    <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C7, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource GroupHead}">
                                    <TextBlock Style="{StaticResource SectionCap}" Text="PURCHASE ORDER" FontSize="9" />
                                </Border>
                                <Border Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource GroupHead}">
                                    <TextBlock Style="{StaticResource SectionCap}" Text="INVOICE" FontSize="9" />
                                </Border>
                                <Border Grid.Column="6" Grid.ColumnSpan="3" Style="{StaticResource GroupHead}">
                                    <TextBlock Style="{StaticResource SectionCap}" Text="HANDOVER TRAIL" FontSize="9" />
                                </Border>
                                <TextBlock Grid.Row="1" Style="{StaticResource ColHead}" Text="SR" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ColHead}" Text="PO NO" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ColHead}" Text="PO AMOUNT" HorizontalTextAlignment="Right" Margin="0,0,12,0" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ColHead}" Text="VENDOR / DESCRIPTION" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource ColHead}" Text="INV NO / DATE" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource ColHead}" Text="INV AMOUNT" HorizontalTextAlignment="Right" Margin="0,0,12,0" />
                                <TextBlock Grid.Row="1" Grid.Column="6" Style="{StaticResource ColHead}" Text="TECH" />
                                <TextBlock Grid.Row="1" Grid.Column="7" Style="{StaticResource ColHead}" Text="SE NO / SAP DATE" />
                                <TextBlock Grid.Row="1" Grid.Column="8" Style="{StaticResource ColHead}" Text="ACCOUNTS" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="0" Column="0" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="1" Column="1" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="2" Column="2" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="4" Column="3" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="5" Column="4" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="6" Column="5" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="7" Column="6" />
                                <views:ColumnResizeGrip Grid.Row="1" Grid.Column="8" Column="7" />
                            </Grid>

                            <ListView x:Name="EntryList" Grid.Row="1" ItemsSource="{x:Bind Vm.Entries, Mode=OneWay}"
                                      SelectionMode="Single" IsItemClickEnabled="True" ItemClick="EntryList_ItemClick"
                                      ContainerContentChanging="EntryList_ContainerContentChanging">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="10,0,0,0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ServiceEntry">
                                        <Grid Padding="0,9" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppHairline}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C0, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C1, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C2, Mode=OneWay}" />
                                                <ColumnDefinition Width="*" MinWidth="150" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C3, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C4, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C5, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C6, Mode=OneWay}" />
                                                <ColumnDefinition Width="{x:Bind views:ServiceEntryColumns.Current.C7, Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Cell}" Text="{x:Bind SrNo}" Foreground="{ThemeResource AppTextTertiary}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{x:Bind PoNo}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{x:Bind PoAmountText}" HorizontalTextAlignment="Right" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="3" Spacing="1" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Cell}" Text="{x:Bind Vendor}" FontWeight="SemiBold" Margin="0" />
                                                <TextBlock Style="{StaticResource Cell}" Text="{x:Bind Description}" FontSize="11" Margin="0"
                                                           Foreground="{ThemeResource AppTextSecondary}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Spacing="1">
                                                <TextBlock Style="{StaticResource Cell}" Text="{x:Bind InvoiceNo}" />
                                                <TextBlock Style="{StaticResource Cell}" Text="{x:Bind InvoiceDateText}" FontSize="11" Foreground="{ThemeResource AppTextSecondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="5" Style="{StaticResource Cell}" Text="{x:Bind InvoiceAmountText}" FontWeight="SemiBold"
                                                       HorizontalTextAlignment="Right" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="6" Style="{StaticResource Cell}" Text="{x:Bind TechText}" />
                                            <StackPanel Grid.Column="7" Spacing="1">
                                                <TextBlock Style="{StaticResource Cell}" Text="{x:Bind SeNoText}" />
                                                <TextBlock Style="{StaticResource Cell}" Text="{x:Bind SapSeText}" FontSize="11" Foreground="{ThemeResource AppTextSecondary}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="8" Style="{StaticResource Cell}" Text="{x:Bind AccountText}"
                                                       Visibility="{x:Bind IsDone, Converter={StaticResource BoolVis}}" />
                                            <StackPanel Grid.Column="8" Spacing="3" HorizontalAlignment="Left"
                                                        Visibility="{x:Bind IsDone, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                                <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Left"
                                                        Background="{x:Bind Stage, Converter={StaticResource StageBg}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                 Fill="{x:Bind Stage, Converter={StaticResource StageColor}}" />
                                                        <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind StageName}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{x:Bind Stage, Converter={StaticResource StageColor}}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind AgeText}" FontSize="10"
                                                           Foreground="{x:Bind IsLate, Converter={StaticResource LateText}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Grid.Row="1" Style="{StaticResource NonSelectableText}" Margin="0,40,0,0" HorizontalAlignment="Center"
                                       FontSize="12.5" Foreground="{ThemeResource AppTextSecondary}"
                                       Text="No entries here. Click + New Entry to add one."
                                       Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <!-- ================= Handover trail: slides in from the right, like the PR Board's detail sheet ================= -->
        <Grid x:Name="DetailOverlay" Background="#99000000" Tapped="DetailBackdrop_Tapped"
              Visibility="{x:Bind Vm.HasSelection, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <Border x:Name="DetailSheet" HorizontalAlignment="Right" Width="440" Tapped="Sheet_Tapped"
                    Background="{ThemeResource AppBackground}" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource AppHairline}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DetailSheetShift" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Padding="20,18,20,0">
                        <StackPanel Spacing="16" Padding="0,0,0,16">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource AppText}" Text="{x:Bind Vm.Selected.Vendor, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Foreground="{ThemeResource AppTextPrimary}" />
                                    <TextBlock Style="{StaticResource AppText}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppTextSecondary}">
                                        <Run Text="{x:Bind Vm.Selected.PoNo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind Vm.Selected.Description, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource NonSelectableText}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AppTextTertiary}">
                                        <Run Text="Sr " /><Run Text="{x:Bind Vm.Selected.SrNo, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTipService.ToolTip="Close (Esc)"
                                            Command="{x:Bind Vm.SelectCommand}" CommandParameter="{x:Null}" />
                                </StackPanel>
                            </Grid>

                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                    Background="{x:Bind Vm.Selected.Stage, Mode=OneWay, Converter={StaticResource StageBg}}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{x:Bind Vm.Selected.Stage, Mode=OneWay, Converter={StaticResource StageColor}}" />
                                    <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind Vm.Selected.StageName, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{x:Bind Vm.Selected.Stage, Mode=OneWay, Converter={StaticResource StageColor}}" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource TileCap}" Text="INVOICE AMOUNT" />
                                        <TextBlock Style="{StaticResource TileVal}" Text="{x:Bind Vm.Selected.InvoiceAmountText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Tile}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource TileCap}" Text="PO AMOUNT" />
                                        <TextBlock Style="{StaticResource TileVal}" Text="{x:Bind Vm.Selected.PoAmountText, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Spacing="6" Visibility="{x:Bind Vm.PoBilledLabel, Mode=OneWay, Converter={StaticResource NullVis}}">
                                <Grid>
                                    <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind Vm.PoBilledLabel, Mode=OneWay}" FontSize="11.5"
                                               Foreground="{ThemeResource AppTextTertiary}" />
                                    <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind Vm.PoBilledText, Mode=OneWay}" FontSize="11.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" Foreground="{x:Bind Vm.PoOver, Mode=OneWay, Converter={StaticResource LateText}}" />
                                </Grid>
                                <ProgressBar Value="{x:Bind Vm.PoBilledPercent, Mode=OneWay}" Maximum="100" Height="6"
                                             Foreground="{ThemeResource AccentFillBrush}"
                                             Visibility="{x:Bind Vm.HasPoAmount, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Bind Vm.PoOverText, Mode=OneWay}"
                                           Foreground="{ThemeResource FluentCritical}"
                                           Visibility="{x:Bind Vm.PoOver, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource TileCap}" Text="HANDOVER TRAIL" FontSize="10" />
                                <ItemsControl ItemsSource="{x:Bind Vm.Steps, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pm:ServiceEntryStep">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- The rail joining this dot to the next one. -->
                                                <Border Width="2" Margin="0,20,0,0" HorizontalAlignment="Center"
                                                        Background="{ThemeResource AppHairline}"
                                                        Visibility="{x:Bind IsLast, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                                <Border Width="20" Height="20" CornerRadius="10" BorderThickness="2" VerticalAlignment="Top"
                                                        BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}" />
                                                <Border Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top"
                                                        Background="{ThemeResource AccentFillBrush}"
                                                        Visibility="{x:Bind Done, Converter={StaticResource BoolVis}}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" Padding="0,1,0,14">
                                                    <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind Title}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AppTextPrimary}" />
                                                    <TextBlock Style="{StaticResource AppText}" Text="{x:Bind Detail}" FontSize="11.5"
                                                               Foreground="{ThemeResource AppTextSecondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Padding="12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource AppHairline}"
                                        Background="{ThemeResource AppTertiaryBackground}"
                                        Visibility="{x:Bind Vm.HasNextStep, Mode=OneWay, Converter={StaticResource BoolVis}}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource NonSelectableText}" Text="{x:Bind Vm.NextStepTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimary}" />
                                        <CalendarDatePicker HorizontalAlignment="Stretch" PlaceholderText="Date"
                                                            Date="{x:Bind Vm.NextStepDate, Mode=TwoWay, Converter={StaticResource Dto}}" />
                                        <TextBox PlaceholderText="Service Entry No" Text="{x:Bind Vm.NextSeNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{x:Bind Vm.NextStepNeedsSeNo, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                                        <Button Content="Mark Done" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                                Command="{x:Bind Vm.MarkDoneCommand}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{x:Bind Vm.Selected.AgeText, Mode=OneWay}"
                                                   Foreground="{x:Bind Vm.Selected.IsLate, Mode=OneWay, Converter={StaticResource LateText}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Margin="20,0,20,16" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppHairline}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Edit" Command="{x:Bind Vm.EditEntryCommand}" />
                            <Button Content="Undo Last Step" Command="{x:Bind Vm.UndoStepCommand}"
                                    ToolTipService.ToolTip="Clears the most recent handover date"
                                    Visibility="{x:Bind Vm.CanUndoStep, Mode=OneWay, Converter={StaticResource BoolVis}}" />
                        </StackPanel>
                        <Button Content="Delete" HorizontalAlignment="Right" Foreground="{ThemeResource FluentCritical}"
                                Command="{x:Bind Vm.DeleteEntryCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= New / Edit entry ================= -->
        <Grid Background="#B3000000" Visibility="{x:Bind Vm.IsEditorOpen, Mode=OneWay, Converter={StaticResource BoolVis}}">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="18" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>
            <Border MaxWidth="640" MaxHeight="780" Margin="24" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    BorderThickness="1" BorderBrush="{ThemeResource AppControlBorder}" Background="{ThemeResource AppSecondaryBackground}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Padding="24,22,24,0">
                        <StackPanel Spacing="18" Padding="0,0,0,22">
                            <TextBlock Style="{StaticResource AppText}" Text="{x:Bind Vm.EditorTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimary}" />

                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SectionCap}" Text="PURCHASE ORDER" />
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Sr No" />
                                        <TextBox Text="{x:Bind Vm.EditSrNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="Number" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PO No *" />
                                        <TextBox x:Name="PoNoBox" Text="{x:Bind Vm.EditPoNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PO Amount" />
                                        <TextBox Text="{x:Bind Vm.EditPoAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vendor *" />
                                        <AutoSuggestBox x:Name="VendorBox" Text="{x:Bind Vm.EditVendor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="Vendors typed here before are suggested" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Description" />
                                        <TextBox Text="{x:Bind Vm.EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. AMC for CCTV" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SectionCap}" Text="INVOICE" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice Date *" />
                                        <CalendarDatePicker HorizontalAlignment="Stretch" Date="{x:Bind Vm.EditInvoiceDate, Mode=TwoWay, Converter={StaticResource Dto}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice No *" />
                                        <TextBox Text="{x:Bind Vm.EditInvoiceNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Invoice Amount *" />
                                        <TextBox Text="{x:Bind Vm.EditInvoiceAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0.00" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="{x:Bind Vm.EditPoHint, Mode=OneWay}"
                                           Foreground="{x:Bind Vm.EditPoHintWarn, Mode=OneWay, Converter={StaticResource LateText}}"
                                           Visibility="{x:Bind Vm.EditPoHint, Mode=OneWay, Converter={StaticResource NullVis}}" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SectionCap}" Text="HANDOVER (OPTIONAL)" />
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Tech Handover" />
                                        <CalendarDatePicker HorizontalAlignment="Stretch" PlaceholderText="Not yet"
                                                            Date="{x:Bind Vm.EditTech, Mode=TwoWay, Converter={StaticResource Dto}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Returned, SAP SE" />
                                        <CalendarDatePicker HorizontalAlignment="Stretch" PlaceholderText="Not yet"
                                                            Date="{x:Bind Vm.EditSapSe, Mode=TwoWay, Converter={StaticResource Dto}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Service Entry No" />
                                        <TextBox Text="{x:Bind Vm.EditSeNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 1114572949" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Account Handover" />
                                        <CalendarDatePicker HorizontalAlignment="Stretch" PlaceholderText="Not yet"
                                                            Date="{x:Bind Vm.EditAccount, Mode=TwoWay, Converter={StaticResource Dto}}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="Usually filled in later from the panel with Mark Done." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppHairline}"
                          Background="{ThemeResource AppTertiaryBackground}" CornerRadius="0,0,10,10">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Cancel" MinWidth="110" Command="{x:Bind Vm.CancelEditCommand}" />
                            <Button Content="{x:Bind Vm.EditorSaveText, Mode=OneWay}" MinWidth="110" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind Vm.SaveEntryCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
