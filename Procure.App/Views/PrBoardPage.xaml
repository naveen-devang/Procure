<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Procure.App.Views.PrBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models"
    xmlns:local="using:Procure.App"
    xmlns:views="using:Procure.App.Views"
    xmlns:modals="using:Procure.App.Views.Modals"
    xmlns:conv="using:Procure.App.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <conv:StatusColorConverter x:Key="StatusColor" />
        <conv:StatusBadgeBgConverter x:Key="StatusBg" />
        <conv:PriorityColorConverter x:Key="PriorityColor" />
        <conv:PriorityBgConverter x:Key="PriorityBg" />
        <conv:PriorityBorderConverter x:Key="PriorityBorder" />
        <conv:PoPillTextColorConverter x:Key="PoPillText" />
        <conv:PcrPillTextColorConverter x:Key="PcrPillText" />
        <conv:PrTypeColorConverter x:Key="PrTypeColor" />
        <conv:PrTypeBgConverter x:Key="PrTypeBg" />
        <conv:PrTypeBorderConverter x:Key="PrTypeBorder" />
        <conv:BoolToFilterChipBgConverter x:Key="ChipBg" />
        <conv:BoolToFilterChipStrokeConverter x:Key="ChipStroke" />
        <conv:BoolToFilterChipTextConverter x:Key="ChipText" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToChevronConverter x:Key="Chevron" />

        <Style x:Key="PillChip" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource PillBg}" />
            <Setter Property="BorderBrush" Value="{ThemeResource PillBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

  <Grid Background="{ThemeResource AppBackground}">
    <Grid Padding="28,20,28,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Purchase Requisitions" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimary}" />
                    <Border Style="{StaticResource PillChip}" VerticalAlignment="Center"
                            Visibility="{Binding ListSummaryPill, Converter={StaticResource NullOrEmptyVis}}"
                            ToolTipService.ToolTip="{Binding ListSummary}">
                        <TextBlock Text="{Binding ListSummaryPill}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextSecondary}" />
                    </Border>
                </StackPanel>
                <TextBlock FontSize="13" Foreground="{ThemeResource AppTextSecondary}"
                           Text="Manage procurement lifecycle across vendor RFQs, multi-role PCR approvals, and purchase orders." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Height="38" />
                <Button Content="Refresh" Command="{Binding RefreshBoardCommand}" Height="38" />
                <Button Content="+ Add PR" Command="{Binding OpenBatchCreateModalCommand}" Height="38"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filter / search toolbar -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="SearchBox" Height="36" VerticalAlignment="Center"
                     PlaceholderText="Search by PR #, item, requestor..." TextChanged="SearchBox_TextChanged" />

            <ComboBox Grid.Column="1" Height="36" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />

            <ToggleButton Grid.Column="2" Content="Overdue SLA" Height="36" FontSize="12"
                          IsChecked="{Binding FilterOverdueOnly, Mode=OneWay}" Click="OverdueChip_Click"
                          Background="{Binding FilterOverdueOnly, Converter={StaticResource ChipBg}}"
                          BorderBrush="{Binding FilterOverdueOnly, Converter={StaticResource ChipStroke}}"
                          Foreground="{Binding FilterOverdueOnly, Converter={StaticResource ChipText}}" />
            <ToggleButton Grid.Column="3" Content="PCR Awaiting Sign" Height="36" FontSize="12"
                          IsChecked="{Binding FilterPcrPendingOnly, Mode=OneWay}" Click="PcrPendingChip_Click"
                          Background="{Binding FilterPcrPendingOnly, Converter={StaticResource ChipBg}}"
                          BorderBrush="{Binding FilterPcrPendingOnly, Converter={StaticResource ChipStroke}}"
                          Foreground="{Binding FilterPcrPendingOnly, Converter={StaticResource ChipText}}" />
            <ToggleButton Grid.Column="4" Content="Urgent Only" Height="36" FontSize="12"
                          IsChecked="{Binding FilterUrgentOnly, Mode=OneWay}" Click="UrgentChip_Click"
                          Background="{Binding FilterUrgentOnly, Converter={StaticResource ChipBg}}"
                          BorderBrush="{Binding FilterUrgentOnly, Converter={StaticResource ChipStroke}}"
                          Foreground="{Binding FilterUrgentOnly, Converter={StaticResource ChipText}}" />
        </Grid>

        <!-- Batch action bar -->
        <Border Grid.Row="2" Padding="16,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource PrimaryTextBrush}"
                Background="{ThemeResource AppSecondaryBackground}"
                Visibility="{Binding IsBatchSelectionActive, Converter={StaticResource BoolVis}}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentFillBrush}" CornerRadius="10" Padding="6,2">
                        <TextBlock Text="{Binding SelectedPrsCount}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" />
                    </Border>
                    <TextBlock Text="{Binding SelectedPrsSummary}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{Binding MergeButtonText}" Command="{Binding MergeOrSplitPrCommand}"
                            IsEnabled="{Binding IsMergeOrSplitPrEnabled}" Style="{StaticResource AccentButtonStyle}"
                            Height="34" FontSize="12" ToolTipService.ToolTip="{Binding MergeButtonToolTip}" />
                    <Button Content="{Binding SharedRfqButtonText}" Command="{Binding CreateOrSplitSharedRfqCommand}"
                            IsEnabled="{Binding IsSharedRfqActionEnabled}" Height="34" FontSize="12"
                            ToolTipService.ToolTip="{Binding SharedRfqButtonToolTip}" />
                    <Button Content="{Binding CombinedPoButtonText}" Command="{Binding CreateOrSplitCombinedPoCommand}"
                            IsEnabled="{Binding IsCombinedPoActionEnabled}" Height="34" FontSize="12"
                            ToolTipService.ToolTip="{Binding CombinedPoButtonToolTip}" />
                    <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Height="34" FontSize="12" />
                    <Button Content="Delete" Command="{Binding DeleteSelectedPrsCommand}" Height="34" FontSize="12"
                            ToolTipService.ToolTip="Permanently delete the selected requisitions and all their RFQs, PCRs and POs" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- PR cards -->
        <Grid Grid.Row="3">
            <ProgressRing IsActive="{Binding IsBusy}" Width="36" Height="36"
                          VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" />

            <ListView
                x:Name="Board"
                SelectionMode="None"
                ShowsScrollingPlaceholders="False"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                ContainerContentChanging="Board_ContainerContentChanging">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,14" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PurchaseRequisition">
                        <Border BorderThickness="1" CornerRadius="8"
                                BorderBrush="{ThemeResource AppHairline}"
                                Background="{ThemeResource AppSecondaryBackground}">
                            <StackPanel>
                                <!-- header row (tap to expand) -->
                                <Grid Padding="14,14,18,14" ColumnSpacing="10" Tapped="Card_Tapped" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              Checked="PrCheck_Toggled" Unchecked="PrCheck_Toggled" Tapped="Child_Tapped" />

                                    <Button Grid.Column="1" Content="{x:Bind Priority}" Click="Priority_Click" Tapped="Child_Tapped"
                                            FontSize="11" FontWeight="SemiBold" Height="26" Padding="8,0" CornerRadius="4"
                                            BorderThickness="1" VerticalAlignment="Center"
                                            Foreground="{x:Bind Priority, Converter={StaticResource PriorityColor}}"
                                            Background="{x:Bind Priority, Converter={StaticResource PriorityBg}}"
                                            BorderBrush="{x:Bind Priority, Converter={StaticResource PriorityBorder}}" />

                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                        <Border Visibility="{x:Bind PrType, Converter={StaticResource NullOrEmptyVis}}"
                                                Padding="6,2" CornerRadius="4" BorderThickness="1" HorizontalAlignment="Left"
                                                Background="{x:Bind PrType, Converter={StaticResource PrTypeBg}}"
                                                BorderBrush="{x:Bind PrType, Converter={StaticResource PrTypeBorder}}">
                                            <TextBlock Text="{x:Bind PrType}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{x:Bind PrType, Converter={StaticResource PrTypeColor}}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind PrNo}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{ThemeResource AppTextPrimary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind Requestor}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="80" Foreground="{ThemeResource AppTextSecondary}" />
                                            <TextBlock Text="{x:Bind Plant}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource PrimaryTextBrush}"
                                                       Visibility="{x:Bind Plant, Converter={StaticResource NullOrEmptyVis}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Description}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource AppTextPrimary}"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Style="{StaticResource PillChip}" Padding="5,1"
                                                    Visibility="{x:Bind HasItems, Converter={StaticResource BoolVis}}">
                                                <TextBlock FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextSecondary}"
                                                           Text="{x:Bind ItemsCount}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind AgeDisplay}" FontSize="11"
                                                       Foreground="{ThemeResource AppTextTertiary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="4" Style="{StaticResource PillChip}">
                                        <TextBlock Text="{x:Bind RfqCount}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource PillTextNeutral}" />
                                    </Border>
                                    <Border Grid.Column="5" Style="{StaticResource PillChip}">
                                        <TextBlock Text="{x:Bind PcrStatusDisplay}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{x:Bind PcrStatusDisplay, Converter={StaticResource PcrPillText}}" />
                                    </Border>
                                    <Border Grid.Column="6" Style="{StaticResource PillChip}">
                                        <TextBlock Text="{x:Bind FormattedTotalPoValue}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{x:Bind TotalPoValue, Converter={StaticResource PoPillText}}" />
                                    </Border>

                                    <Button Grid.Column="7" Content="{x:Bind Status}" Click="Status_Click" Tapped="Child_Tapped"
                                            FontSize="12" FontWeight="SemiBold" Height="28" Padding="12,0" CornerRadius="6"
                                            BorderThickness="0" VerticalAlignment="Center"
                                            Background="{x:Bind Status, Converter={StaticResource StatusBg}}"
                                            Foreground="{x:Bind Status, Converter={StaticResource StatusColor}}" />

                                    <Button Grid.Column="8" Click="Edit_Click" Tapped="Child_Tapped" VerticalAlignment="Center"
                                            Height="30" Width="30" Padding="0" CornerRadius="4" FontSize="12"
                                            FontFamily="Segoe Fluent Icons" Content="&#xE70F;"
                                            ToolTipService.ToolTip="Edit PR" />
                                    <Button Grid.Column="9" Click="Delete_Click" Tapped="Child_Tapped" VerticalAlignment="Center"
                                            Height="30" Width="30" Padding="0" CornerRadius="4" FontSize="12"
                                            FontFamily="Segoe Fluent Icons" Content="&#xE74D;"
                                            Foreground="{ThemeResource FluentCritical}"
                                            ToolTipService.ToolTip="Delete PR" />

                                    <TextBlock Grid.Column="10" FontFamily="Segoe Fluent Icons" FontSize="11"
                                               VerticalAlignment="Center" Foreground="{ThemeResource AppTextTertiary}"
                                               Text="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource Chevron}}" />
                                </Grid>

                                <!-- expanded detail - x:Load defers building the heavy panel until the
                                     card is expanded (the MAUI LazyExpander equivalent) -->
                                <views:PrDetailPanel x:Name="DetailPanel" x:Load="{x:Bind IsExpanded, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                        Padding="60,40" Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Text="No purchase requisitions match your criteria." FontSize="15"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource AppTextTertiary}" />
                <Button Content="Reset Filters" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>

    <!-- modal layer (each x:Load-deferred on its VM visibility flag) -->
    <modals:MergePrModal x:Name="MergeModal" x:Load="{x:Bind Vm.IsMergePrModalVisible, Mode=OneWay}" />
    <modals:SplitPrModal x:Name="SplitModal" x:Load="{x:Bind Vm.IsSplitPrModalVisible, Mode=OneWay}" />
    <modals:ApprovalConfigModal x:Name="ApprovalModal" x:Load="{x:Bind Vm.IsApprovalConfigModalVisible, Mode=OneWay}" />
    <modals:BatchPoModal x:Name="BatchPoModal_" x:Load="{x:Bind Vm.IsBatchPoModalVisible, Mode=OneWay}" />
  </Grid>
</Page>
