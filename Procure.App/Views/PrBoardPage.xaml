<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Procure.App.Views.PrBoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Procure.Models"
    xmlns:local="using:Procure.App"
    xmlns:views="using:Procure.App.Views"
    xmlns:modals="using:Procure.App.Views.Modals"
    xmlns:conv="using:Procure.App.Converters"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Page.Resources>
        <ScalarTransition x:Key="StaleFade" Duration="0:0:0.12" />
        <conv:StatusColorConverter x:Key="StatusColor" />
        <conv:StatusBadgeBgConverter x:Key="StatusBg" />
        <conv:PriorityColorConverter x:Key="PriorityColor" />
        <conv:PriorityBgConverter x:Key="PriorityBg" />
        <conv:PriorityBorderConverter x:Key="PriorityBorder" />
        <conv:PoPillTextColorConverter x:Key="PoPillText" />
        <conv:PcrPillTextColorConverter x:Key="PcrPillText" />
        <conv:PrTypeColorConverter x:Key="PrTypeColor" />
        <conv:PrTypeBgConverter x:Key="PrTypeBg" />
        <conv:PrTypeBorderConverter x:Key="PrTypeBorder" />
        <conv:BoolToFilterChipBgConverter x:Key="ChipBg" />
        <conv:BoolToFilterChipStrokeConverter x:Key="ChipStroke" />
        <conv:BoolToFilterChipTextConverter x:Key="ChipText" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyVis" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToChevronConverter x:Key="Chevron" />

        <Style x:Key="PillChip" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource PillBg}" />
            <Setter Property="BorderBrush" Value="{ThemeResource PillBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

  <Grid Background="{ThemeResource AppBackground}">
    <Grid Padding="28,20,28,0" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <TextBlock Text="Purchase Requisitions" FontSize="28" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimary}" />
                    <TextBlock Text="{Binding ListSummaryPill}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,3"
                               Foreground="{ThemeResource AppTextTertiary}"
                               Visibility="{Binding ListSummaryPill, Converter={StaticResource NullOrEmptyVis}}"
                               ToolTipService.ToolTip="{Binding ListSummary}" />
                </StackPanel>
                <TextBlock FontSize="13" Foreground="{ThemeResource AppTextSecondary}"
                           Text="Manage procurement lifecycle across vendor RFQs, multi-role PCR approvals, and purchase orders." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Height="38" />
                <Button Content="Refresh" Command="{Binding RefreshBoardCommand}" Height="38" />
                <Button Content="+ Add PR" Command="{Binding OpenBatchCreateModalCommand}" Height="38"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filter / search toolbar. Search is the hero; the three toggle filters live in one
             popover with an active-count badge instead of three loose chips. -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" x:Name="SearchBox" Height="36" VerticalAlignment="Center"
                     PlaceholderText="Search by PR #, item, requestor..." TextChanged="SearchBox_TextChanged" />

            <ComboBox x:Name="StatusFilterBox" Grid.Column="1" Height="36" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                      SelectionChanged="StatusFilter_SelectionChanged" />

            <Button Grid.Column="2" Height="36" Padding="14,0" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Overdue SLA, PCR awaiting sign, urgent only">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Filters" FontSize="12.5" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource AccentFillBrush}" CornerRadius="9" MinWidth="18" Height="18"
                            Padding="6,0" VerticalAlignment="Center"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ActiveFilterCount}" FontSize="10.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1A1A1A" />
                    </Border>
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="12" MinWidth="216">
                            <TextBlock Text="Filter requisitions" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{ThemeResource AppTextPrimary}" />
                            <StackPanel Spacing="6">
                                <CheckBox Content="Overdue SLA" MinWidth="0"
                                          IsChecked="{Binding FilterOverdueOnly, Mode=TwoWay}" />
                                <CheckBox Content="PCR awaiting sign" MinWidth="0"
                                          IsChecked="{Binding FilterPcrPendingOnly, Mode=TwoWay}" />
                                <CheckBox Content="Urgent only" MinWidth="0"
                                          IsChecked="{Binding FilterUrgentOnly, Mode=TwoWay}" />
                            </StackPanel>
                            <Button Content="Reset all" FontSize="12" Height="30" HorizontalAlignment="Stretch"
                                    Command="{Binding ResetFiltersCommand}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Batch action bar -->
        <Border Grid.Row="2" Padding="16,10" CornerRadius="8" BorderThickness="1,1,1,1"
                BorderBrush="{ThemeResource AppControlBorder}"
                Background="{ThemeResource AppTertiaryBackground}"
                Visibility="{Binding IsBatchSelectionActive, Converter={StaticResource BoolVis}}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource AccentFillBrush}" CornerRadius="10" Padding="6,2">
                        <TextBlock Text="{Binding SelectedPrsCount}" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" />
                    </Border>
                    <TextBlock Text="{Binding SelectedPrsSummary}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Foreground="{ThemeResource AppTextPrimary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="{Binding MergeButtonText}" Command="{Binding MergeOrSplitPrCommand}"
                            IsEnabled="{Binding IsMergeOrSplitPrEnabled}" Style="{StaticResource AccentButtonStyle}"
                            Height="34" FontSize="12" ToolTipService.ToolTip="{Binding MergeButtonToolTip}" />
                    <Button Content="{Binding SharedRfqButtonText}" Command="{Binding CreateOrSplitSharedRfqCommand}"
                            IsEnabled="{Binding IsSharedRfqActionEnabled}" Height="34" FontSize="12"
                            ToolTipService.ToolTip="{Binding SharedRfqButtonToolTip}" />
                    <Button Content="{Binding CombinedPoButtonText}" Command="{Binding CreateOrSplitCombinedPoCommand}"
                            IsEnabled="{Binding IsCombinedPoActionEnabled}" Height="34" FontSize="12"
                            ToolTipService.ToolTip="{Binding CombinedPoButtonToolTip}" />
                    <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Height="34" FontSize="12" />
                    <Button Content="Delete" Command="{Binding DeleteSelectedPrsCommand}" Height="34" FontSize="12"
                            ToolTipService.ToolTip="Permanently delete the selected requisitions and all their RFQs, PCRs and POs" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- PR cards -->
        <Grid Grid.Row="3">
            <ProgressRing IsActive="{Binding IsBusy}" Width="36" Height="36"
                          VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" />

            <ListView
                x:Name="Board"
                SelectionMode="None"
                ShowsScrollingPlaceholders="False"
                ItemsSource="{Binding FilteredPrs}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                IsHitTestVisible="{Binding IsSearchPending, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                Opacity="{Binding StaleResultsOpacity}"
                OpacityTransition="{StaticResource StaleFade}"
                ContainerContentChanging="Board_ContainerContentChanging"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppHairline}">
                <!-- Rows belonging to the term you just replaced are dimmed and inert until the new
                     ones arrive. Dimmed rather than cleared: emptying the board on every keystroke
                     flashes, and this says "stale", which is what they are. -->
                <ListView.Resources>
                    <!-- Neutral hover instead of the default accent-tinted one - a calmer scan surface. -->
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource AppTertiaryBackground}" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource AppTertiaryBackground}" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="CornerRadius" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PurchaseRequisition">
                        <StackPanel>
                            <!-- row (tap to expand) - borderless, hairline below, hover fill from the
                                 container's own PointerOver state (see ListView.Resources above). -->
                            <Grid ColumnSpacing="14" Padding="12,10" Tapped="Card_Tapped" Background="Transparent">
                                <Grid.Resources>
                                    <!-- Clicked, not read: selectable text here would swallow the tap (see Styles.xaml). -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource NonSelectableText}" />
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- priority accent rail -->
                                <Rectangle Grid.Column="0" Width="3" Margin="0,4" RadiusX="1.5" RadiusY="1.5"
                                           Fill="{x:Bind Priority, Converter={StaticResource PriorityColor}, Mode=OneWay}" />

                                <CheckBox Grid.Column="1" MinWidth="0" Padding="0" VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          Checked="PrCheck_Toggled" Unchecked="PrCheck_Toggled" Tapped="Child_Tapped" />

                                <TextBlock Grid.Column="2" Text="{x:Bind Priority, Mode=OneWay}" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{x:Bind Priority, Converter={StaticResource PriorityColor}, Mode=OneWay}" />

                                <!-- identity block: id + type on one line, title, dim meta line -->
                                <StackPanel Grid.Column="3" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind PrNo}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource AppTextPrimary}" />
                                        <Border Visibility="{x:Bind PrType, Converter={StaticResource NullOrEmptyVis}}"
                                                Padding="10,3" CornerRadius="10" BorderThickness="0" VerticalAlignment="Center"
                                                MinWidth="60" HorizontalAlignment="Left"
                                                Background="{x:Bind PrType, Converter={StaticResource PrTypeBg}}"
                                                BorderBrush="{x:Bind PrType, Converter={StaticResource PrTypeBorder}}">
                                            <TextBlock Text="{x:Bind PrType}" FontSize="9.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{x:Bind PrType, Converter={StaticResource PrTypeColor}}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12.5"
                                               Foreground="{ThemeResource AppTextPrimary}"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock FontSize="11" Foreground="{ThemeResource AppTextTertiary}" VerticalAlignment="Center">
                                            <Run Text="{x:Bind Requestor}" />
                                            <Run Text="·" />
                                            <Run Text="{x:Bind Plant}" Foreground="{ThemeResource PrimaryTextBrush}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource PillChip}"
                                                Visibility="{x:Bind HasItems, Converter={StaticResource BoolVis}, Mode=OneWay}">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondary}"
                                                       Text="{x:Bind ItemsCount, Converter={StaticResource Fmt}, ConverterParameter='{}{0} items', Mode=OneWay}" />
                                        </Border>
                                        <Border Style="{StaticResource PillChip}">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource PillTextNeutral}"
                                                       Text="{x:Bind RfqCount, Converter={StaticResource Fmt}, ConverterParameter='{}{0} RFQ', Mode=OneWay}" />
                                        </Border>
                                        <Border Style="{StaticResource PillChip}">
                                            <TextBlock Text="{x:Bind PcrStatusDisplay, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{x:Bind PcrStatusDisplay, Converter={StaticResource PcrPillText}, Mode=OneWay}" />
                                        </Border>
                                        <Border Style="{StaticResource PillChip}">
                                            <TextBlock Text="{x:Bind AgeDisplay}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AppTextTertiary}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- right cluster: value, status, actions (actions dim until hovered) -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedTotalPoValue, Mode=OneWay}" FontSize="12.5"
                                               VerticalAlignment="Center"
                                               Foreground="{x:Bind TotalPoValue, Converter={StaticResource PoPillText}, Mode=OneWay}" />
                                    <Button Content="{x:Bind Status, Mode=OneWay}" Click="Status_Click" Tapped="Child_Tapped"
                                            FontSize="11.5" FontWeight="SemiBold" Height="28" Padding="12,0" CornerRadius="14" MinWidth="56"
                                            BorderThickness="0" VerticalAlignment="Center"
                                            Background="{x:Bind Status, Converter={StaticResource StatusBg}, Mode=OneWay}"
                                            Foreground="{x:Bind Status, Converter={StaticResource StatusColor}, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Style="{StaticResource IconButton}" Click="Edit_Click" Tapped="Child_Tapped"
                                                Content="&#xE70F;" ToolTipService.ToolTip="Edit PR" />
                                        <Button Style="{StaticResource IconButton}" Click="Delete_Click" Tapped="Child_Tapped"
                                                Content="&#xE74D;" Foreground="{ThemeResource FluentCritical}"
                                                ToolTipService.ToolTip="Delete PR" />
                                    </StackPanel>
                                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AppTextTertiary}"
                                               Text="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource Chevron}}" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppHairline}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                        Padding="60,40" Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Text="No purchase requisitions match your criteria." FontSize="15"
                           FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource AppTextTertiary}" />
                <Button Content="Reset Filters" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>

    <!-- Detail slide-over. Was an inline expander inside the row; as a slide-over only one PR
         is open at a time and the board dims behind it. Stays wide (not the ~400px the audit
         first drew) because the panel is three editable columns, not a summary. x:Load keeps
         the old deferral - the heavy panel isn't built until a row is opened. -->
    <Grid x:Name="DetailOverlay" Background="#99000000" Tapped="DetailBackdrop_Tapped"
          x:Load="{x:Bind Vm.IsDetailPanelOpen, Mode=OneWay}">
        <!-- Sized by a left margin rather than a fixed Width: leaves a strip of board visible for
             context and never clips its own content on a smaller window (a fixed Width clips from
             the left once the window is narrower than it). The three columns carry a 212px date
             stack in the middle one, so the panel needs real width - at ~1000px the approval role
             names and vendor names truncate. -->
        <Border HorizontalAlignment="Stretch" Margin="180,0,0,0" Tapped="Child_Tapped"
                Background="{ThemeResource AppBackground}"
                BorderThickness="1,0,0,0" BorderBrush="{ThemeResource AppHairline}">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="140" FromVerticalOffset="0" />
                </TransitionCollection>
            </Border.Transitions>
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="20,16" ColumnSpacing="12" Background="{ThemeResource AppSecondaryBackground}"
                      BorderThickness="0,0,0,1" BorderBrush="{ThemeResource AppHairline}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding ExpandedPr.PrNo}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimary}" />
                            <Border Padding="10,3,10,5" CornerRadius="10" MinWidth="60" BorderThickness="0"
                                    VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Visibility="{Binding ExpandedPr.PrType, Converter={StaticResource NullOrEmptyVis}}"
                                    Background="{Binding ExpandedPr.PrType, Converter={StaticResource PrTypeBg}}"
                                    BorderBrush="{Binding ExpandedPr.PrType, Converter={StaticResource PrTypeBorder}}">
                                <TextBlock Text="{Binding ExpandedPr.PrType}" FontSize="9.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding ExpandedPr.PrType, Converter={StaticResource PrTypeColor}}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ExpandedPr.Description}" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Foreground="{ThemeResource AppTextSecondary}" />
                    </StackPanel>
                    <!-- Centred, not Top: aligned to the top it sat a few pixels under the window's
                         own Close button on a maximised window, and aiming for this one quit the app. -->
                    <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;"
                            VerticalAlignment="Center" Margin="0,8,0,0" ToolTipService.ToolTip="Close (Esc)"
                            Command="{Binding CloseDetailPanelCommand}" />
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer Visibility="{Binding IsDetailHydrating, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <views:PrDetailPanel x:Name="DetailPanel" DataContext="{Binding ExpandedPr}" />
                    </ScrollViewer>

                    <!-- The panel's quote and order lines are not read until a requisition is opened,
                         so opening one now waits on a query. Without this the panel appears with its
                         three columns empty and fills a moment later, which reads as a bug rather than
                         as loading. Shaped like the panel it replaces - three columns, a card or two
                         each - so the layout does not jump when the real thing arrives. -->
                    <Border Visibility="{Binding IsDetailHydrating, Converter={StaticResource BoolVis}}"
                            Padding="20,18">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <Border Style="{StaticResource SkeletonBlock}" Width="120" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonCard}" />
                                <Border Style="{StaticResource SkeletonCard}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="10">
                                <Border Style="{StaticResource SkeletonBlock}" Width="120" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonCard}" />
                                <Border Style="{StaticResource SkeletonCard}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="10">
                                <Border Style="{StaticResource SkeletonBlock}" Width="120" HorizontalAlignment="Left" />
                                <Border Style="{StaticResource SkeletonCard}" />
                                <Border Style="{StaticResource SkeletonCard}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <!-- modal layer (each x:Load-deferred on its VM visibility flag) -->
    <modals:EditPrModal x:Name="EditModal" x:Load="{x:Bind Vm.IsEditModalVisible, Mode=OneWay}" />
    <modals:AddRfqModal x:Name="AddRfqModal_" x:Load="{x:Bind Vm.IsAddRfqModalVisible, Mode=OneWay}" />
    <modals:MergePrModal x:Name="MergeModal" x:Load="{x:Bind Vm.IsMergePrModalVisible, Mode=OneWay}" />
    <modals:SplitPrModal x:Name="SplitModal" x:Load="{x:Bind Vm.IsSplitPrModalVisible, Mode=OneWay}" />
    <modals:ApprovalConfigModal x:Name="ApprovalModal" x:Load="{x:Bind Vm.IsApprovalConfigModalVisible, Mode=OneWay}" />
    <modals:BatchPoModal x:Name="BatchPoModal_" x:Load="{x:Bind Vm.IsBatchPoModalVisible, Mode=OneWay}" />
    <modals:BatchCreateModal x:Name="BatchCreateModal_" x:Load="{x:Bind Vm.IsBatchCreateModalVisible, Mode=OneWay}" />
    <modals:BatchRfqModal x:Name="BatchRfqModal_" x:Load="{x:Bind Vm.IsBatchRfqModalVisible, Mode=OneWay}" />
    <modals:ExportPcrModal x:Name="ExportPcrModal_" x:Load="{x:Bind Vm.IsExportPcrModalVisible, Mode=OneWay}" />
    <modals:AddPoModal x:Name="AddPoModal_" x:Load="{x:Bind Vm.IsAddPoModalVisible, Mode=OneWay}" />
    <modals:PcrPreviewModal x:Name="PcrPreviewModal_" x:Load="{x:Bind Vm.IsPcrPreviewVisible, Mode=OneWay}" />
  </Grid>
</Page>
