<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Procure.PageModels"
             xmlns:models="clr-namespace:Procure.Models"
             x:Class="Procure.Pages.CallOffPage"
             x:Name="ThisPage"
             x:DataType="pageModels:CallOffPageModel"
             Shell.NavBarIsVisible="False"
             Title="Raw &amp; Packing Materials"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <Grid Padding="24" ColumnDefinitions="280,16,*">

        <!-- Left pane: material index -->
        <Border Grid.Column="0"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                Padding="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="10,10,10,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry x:Name="SearchEntry" Grid.Column="0"
                           Placeholder="Search material, vendor, or PO..."
                           Text="{Binding SearchText, Mode=TwoWay}" />
                    <Button Grid.Column="1" Text="&#xE72C;"
                            FontFamily="Segoe Fluent Icons" FontSize="13"
                            HeightRequest="34" WidthRequest="34" Padding="0" CornerRadius="6"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            Command="{Binding RefreshCommand}"
                            ToolTipProperties.Text="Refresh" />
                </Grid>

                <!-- One grouped CollectionView: the group headers AND the vendor rows are both
                     virtualized by it. The rows used to live in a BindableLayout nested inside each
                     group template, which realises every bound item up front - at ~480 vendor lines
                     per material that was thousands of native views built synchronously the moment
                     a group was opened. Expanding now just fills the group (see MaterialGroup), and
                     only what fits on screen is ever realised. -->
                <CollectionView Grid.Row="1" Margin="8"
                                ItemsSource="{Binding Groups}"
                                IsGrouped="True"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No raw or packing material POs yet."
                               Margin="14" FontSize="12.5"
                               TextColor="{StaticResource Gray400}" />
                    </CollectionView.EmptyView>

                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="models:MaterialGroup">
                            <Border Padding="12,10" Margin="0,6,0,0"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleExpandCommand}"
                                                           CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="11"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource Gray400}" />

                                        <Label Grid.Column="1" Text="{Binding MaterialName}" FontFamily="SegoeSemibold" FontSize="13.5"
                                               LineBreakMode="TailTruncation" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <!-- A group's rows are fetched on first expand, so the gap between
                                             the chevron turning and the rows landing needs to say something. -->
                                        <ActivityIndicator Grid.Column="2" IsVisible="{Binding IsLoadingLines}" IsRunning="{Binding IsLoadingLines}"
                                                           HeightRequest="14" WidthRequest="14" VerticalOptions="Center"
                                                           Color="{DynamicResource AccentFill}" />

                                        <Label Grid.Column="3" VerticalOptions="Center"
                                               Text="{Binding PercentComplete, StringFormat='{0:F0}%'}"
                                               FontSize="13.5" FontFamily="SegoeSemibold"
                                               TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}" />
                                    </Grid>

                                    <ProgressBar Progress="{Binding Percent01}" HeightRequest="5"
                                                 ProgressColor="{DynamicResource AccentFill}" />

                                    <Label Text="{Binding VendorCountText}" FontSize="10.5"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CallOffLine">
                            <Grid Margin="10,0,2,0">
                                <!-- Selection fill: a plain AppThemeBinding assigned directly to a property is
                                     live-reactive to theme changes; toggling Opacity via a trigger (both static
                                     doubles) avoids the known MAUI issue where an AppThemeBinding placed inside
                                     a Setter/DataTrigger only resolves once and never updates again. -->
                                <Border StrokeThickness="0" Opacity="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                </Border>

                                <Border Padding="8,6" StrokeThickness="0" BackgroundColor="Transparent">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectLineCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Vendor}" FontFamily="SegoeSemibold" FontSize="11.5"
                                                   LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Label Grid.Column="1" Text="{Binding PercentComplete, StringFormat='{0:F0}%'}" FontFamily="SegoeSemibold" FontSize="10.5"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Percent01}" HeightRequest="4"
                                                     ProgressColor="{DynamicResource AccentFill}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Right pane: detail -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="14"
              IsVisible="{Binding SelectedLine, Converter={StaticResource NullToBoolConverter}}">

            <!-- Header -->
            <Border Grid.Row="0"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="16" x:DataType="pageModels:CallOffPageModel">
                    <Grid ColumnDefinitions="*,Auto,*" BindingContext="{Binding SelectedLine}" x:DataType="models:CallOffLine">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Start" VerticalOptions="Center">
                            <Label Text="VENDOR" FontSize="10" CharacterSpacing="0.6"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding Vendor}" FontFamily="SegoeSemibold" FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        </VerticalStackLayout>

                        <!-- Two straight columns - every label's right edge and every value's left edge
                             line up, instead of each row centring independently at its own text width. -->
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4"
                              RowDefinitions="Auto,Auto,Auto,Auto" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Grid.Row="0" Grid.Column="0" Text="PO" FontSize="10" HorizontalTextAlignment="End"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding PoNo}" FontFamily="OpenSansSemibold" FontSize="12.5"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                            <Label Grid.Row="1" Grid.Column="0" Text="PR" FontSize="10" HorizontalTextAlignment="End"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding PrNo}" FontFamily="OpenSansSemibold" FontSize="12.5"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="CONTRACT" FontSize="10" HorizontalTextAlignment="End"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" IsVisible="{Binding HasTransportContractNumber}" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TransportContractNumber}" FontFamily="OpenSansSemibold" FontSize="12.5"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                   IsVisible="{Binding HasTransportContractNumber}" />

                            <Label Grid.Row="3" Grid.Column="0" Text="TRANSPORTER" FontSize="10" HorizontalTextAlignment="End"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center" IsVisible="{Binding HasTransporterName}" />
                            <Label Grid.Row="3" Grid.Column="1" Text="{Binding TransporterName}" FontFamily="OpenSansSemibold" FontSize="12.5"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                   IsVisible="{Binding HasTransporterName}" />
                        </Grid>

                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                            <Label Text="MATERIAL" FontSize="10" CharacterSpacing="0.6" HorizontalOptions="End"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label Text="{Binding MaterialName}" FontFamily="SegoeSemibold" FontSize="20" HorizontalOptions="End"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Packing Material: 3 tiles. Raw Material: same 3 plus Transport Rate/Unit in the
                         same row - two separate fixed-column grids, toggled, so neither leaves a gap. -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" BindingContext="{Binding SelectedLine}" x:DataType="models:CallOffLine"
                          IsVisible="{Binding IsRawMaterial, Converter={StaticResource BoolToInvertedBoolConverter}}">
                        <Border Grid.Column="0" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="ORDERED" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedOrdered}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="DELIVERED" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedCalledOff}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="REMAINING" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedRemaining}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" BindingContext="{Binding SelectedLine}" x:DataType="models:CallOffLine"
                          IsVisible="{Binding IsRawMaterial}">
                        <Border Grid.Column="0" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="ORDERED" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedOrdered}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="DELIVERED" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedCalledOff}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="REMAINING" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedRemaining}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Padding="10,8" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TRANSPORT RATE/UNIT" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FormattedTransportRatePerUnit}" FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <ProgressBar Progress="{Binding SelectedLine.Percent01}" HeightRequest="6"
                                 ProgressColor="{DynamicResource AccentFill}" />
                </VerticalStackLayout>
            </Border>

            <!-- Log entry form -->
            <Border Grid.Row="1"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid ColumnDefinitions="140,110,Auto,*,Auto" ColumnSpacing="10">
                    <DatePicker Grid.Column="0" Date="{Binding NewCallOffDate, Mode=TwoWay}" />
                    <Entry Grid.Column="1" Placeholder="Qty" Keyboard="Numeric" Text="{Binding NewCallOffQuantity, Mode=TwoWay}" />
                    <Label Grid.Column="2" Text="{Binding SelectedLine.Unit}" VerticalOptions="Center" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <Entry Grid.Column="3" Placeholder="Note (optional)" Text="{Binding NewCallOffNote, Mode=TwoWay}" />
                    <Button Grid.Column="4" Text="+ Log Delivery"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LogCallOffCommand}" />
                </Grid>
            </Border>

            <!-- History -->
            <Border Grid.Row="2"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                    Padding="14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <Grid Grid.Row="0" Padding="0,0,0,8" ColumnDefinitions="90,100,*,Auto" ColumnSpacing="0">
                        <BoxView Grid.ColumnSpan="4" VerticalOptions="End" HeightRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                        <HorizontalStackLayout Grid.Column="0" Spacing="3">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SortHistoryCommand}" CommandParameter="Date" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="DATE" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                            <Label Text="{Binding DateSortGlyph}" FontFamily="Segoe Fluent Icons" FontSize="9"
                                   VerticalOptions="Center" TextColor="{StaticResource Gray400}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" Spacing="3">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SortHistoryCommand}" CommandParameter="Quantity" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="QUANTITY" FontSize="9.5" CharacterSpacing="0.5" TextColor="{StaticResource Gray400}" />
                            <Label Text="{Binding QuantitySortGlyph}" FontFamily="Segoe Fluent Icons" FontSize="9"
                                   VerticalOptions="Center" TextColor="{StaticResource Gray400}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="2" Text="NOTE" FontSize="9.5" CharacterSpacing="0.5"
                               TextColor="{StaticResource Gray400}" />
                        <Label Grid.Column="3" Text="" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding SelectedLineHistory}">
                    <CollectionView.EmptyView>
                        <Label Text="No deliveries logged yet." FontSize="12.5" Margin="10"
                               TextColor="{StaticResource Gray400}" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PoItemCallOff">
                            <Grid Padding="0,8" ColumnDefinitions="90,100,*,Auto" ColumnSpacing="0">
                                <Label Grid.Column="0" Text="{Binding CallOffDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="11"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Quantity}" FontFamily="OpenSansSemibold" FontSize="12" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Label Text="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectedLine.Unit}" FontSize="11" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Note}" FontSize="11.5" LineBreakMode="TailTruncation"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Button Grid.Column="3" Text="&#xE74D;"
                                        FontFamily="Segoe Fluent Icons" FontSize="11"
                                        HeightRequest="26" WidthRequest="26" Padding="0" CornerRadius="4" BorderWidth="1"
                                        BackgroundColor="{AppThemeBinding Light='#FDE7E9', Dark='#3F1011'}"
                                        BorderColor="{AppThemeBinding Light='#F1B0B7', Dark='#5C1B1E'}"
                                        TextColor="{AppThemeBinding Light={StaticResource FluentCritical}, Dark={StaticResource FluentCriticalTextDark}}"
                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCallOffCommand}"
                                        CommandParameter="{Binding .}"
                                        ToolTipProperties.Text="Delete entry" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Label Grid.Column="2"
               Text="Select a vendor line on the left to log or review deliveries."
               IsVisible="{Binding NoLineSelected}"
               HorizontalOptions="Center" VerticalOptions="Center" FontSize="13"
               TextColor="{StaticResource Gray400}" />
    </Grid>
</ContentPage>
