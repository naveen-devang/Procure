<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Procure.PageModels"
             xmlns:models="clr-namespace:Procure.Models"
             xmlns:converters="clr-namespace:Procure.Utilities"
             x:Class="Procure.Pages.SettingsPage"
             x:Name="ThisSettingsPage"
             x:DataType="pageModels:SettingsPageModel"
             Shell.NavBarIsVisible="False"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <!--
      One tab, seven sections. A category rail on the left swaps the pane on the right; each pane is a
      LazyExpander, so a section's XAML is only built the first time you open it - a section you
      never open in a session is never created. Built content is then kept (no AutoReleaseDelay):
      the whole page is ~140 light controls, so retaining it once built matches the old always-built
      page, and releasing would strand BindableLayout / theme-binding subscriptions on this singleton
      page model. The section contents are the same cards this page always had - only the wrapping changed.
    -->

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="230, *">

        <!-- Header spans both columns -->
        <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="3" Padding="28,22,28,18">
            <Label Text="Settings &amp; Configuration"
                   FontFamily="SegoeSemibold"
                   FontSize="24"
                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
            <Label Text="Appearance, navigation, procurement defaults, custom columns, updates, storage, and keyboard shortcuts."
                   FontSize="12.5"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </VerticalStackLayout>

        <!-- ================= Category rail ================= -->
        <Border Grid.Row="1" Grid.Column="0"
                StrokeThickness="0"
                Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                Padding="0">
            <ScrollView>
                <VerticalStackLayout Padding="12,8,12,20" Spacing="4">

                    <Button Text="Appearance"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Appearance"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Appearance}" />

                    <Button Text="Navigation &amp; Sidebar"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Navigation"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Navigation}" />

                    <Button Text="Procurement Defaults"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Procurement"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Procurement}" />

                    <Button Text="Custom Columns"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Columns"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Columns}" />

                    <Button Text="Updates"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Updates"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Updates}" />

                    <Button Text="Storage &amp; Data"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Storage"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Storage}" />

                    <Button Text="Keyboard Shortcuts"
                            Command="{Binding SelectSectionCommand}" CommandParameter="Shortcuts"
                            HorizontalOptions="Fill" HeightRequest="40" FontSize="13" Padding="10,0"
                            BackgroundColor="Transparent" CornerRadius="6"
                            TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                            BorderColor="{DynamicResource Primary}"
                            BorderWidth="{Binding SelectedSection, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Shortcuts}" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- ================= Section panes ================= -->
        <ScrollView Grid.Row="1" Grid.Column="1" Padding="28,16,28,32">
            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">

                <!-- ===== Appearance ===== -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Appearance}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:SettingsPageModel">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    Padding="20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="18">
                                    <Label Text="Appearance &amp; Theme Personalization"
                                           FontFamily="SegoeSemibold" FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Color Mode" FontSize="13" FontFamily="SegoeSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="12">
                                            <Button Grid.Column="0"
                                                    Text="&#xE708;  Dark Mode"
                                                    FontFamily="Segoe Fluent Icons"
                                                    Command="{Binding SelectThemeModeCommand}"
                                                    CommandParameter="Dark"
                                                    HeightRequest="40" FontSize="13"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                    BorderColor="{DynamicResource Primary}"
                                                    BorderWidth="{Binding SelectedThemeMode, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Dark}" />

                                            <Button Grid.Column="1"
                                                    Text="&#xE706;  Light Mode"
                                                    FontFamily="Segoe Fluent Icons"
                                                    Command="{Binding SelectThemeModeCommand}"
                                                    CommandParameter="Light"
                                                    HeightRequest="40" FontSize="13"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                    BorderColor="{DynamicResource Primary}"
                                                    BorderWidth="{Binding SelectedThemeMode, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Light}" />

                                            <Button Grid.Column="2"
                                                    Text="&#xE7F8;  System Default"
                                                    FontFamily="Segoe Fluent Icons"
                                                    Command="{Binding SelectThemeModeCommand}"
                                                    CommandParameter="System"
                                                    HeightRequest="40" FontSize="13"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                    BorderColor="{DynamicResource Primary}"
                                                    BorderWidth="{Binding SelectedThemeMode, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=System}" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0">
                                        <Label Text="Pastel Accent Theme Palette" FontSize="13" FontFamily="SegoeSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <Label Text="Choose your accent highlight color for buttons, badges, and status indicators across the entire app."
                                               FontSize="11" TextColor="{StaticResource Gray400}" />

                                        <Grid ColumnDefinitions="*, *, *, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="10" Margin="0,4,0,0">
                                            <Button Grid.Row="0" Grid.Column="0" Text="Pastel Blue"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Blue"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1A3A82EE"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#60CDFF}"
                                                    BorderColor="#60CDFF"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Blue}" />

                                            <Button Grid.Row="0" Grid.Column="1" Text="Pastel Purple"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Purple"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1A8B6CE8"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#B198F0}"
                                                    BorderColor="#B198F0"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Purple}" />

                                            <Button Grid.Row="0" Grid.Column="2" Text="Pastel Mint"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Mint"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1A2E9E6D"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#6CCB5F}"
                                                    BorderColor="#6CCB5F"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Mint}" />

                                            <Button Grid.Row="0" Grid.Column="3" Text="Pastel Coral"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Coral"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1AE07238"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#FFA043}"
                                                    BorderColor="#FFA043"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Coral}" />

                                            <Button Grid.Row="1" Grid.Column="0" Text="Pastel Rose"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Pink"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1AD95382"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#FF99A4}"
                                                    BorderColor="#FF99A4"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Pink}" />

                                            <Button Grid.Row="1" Grid.Column="1" Text="Pastel Crimson"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Red"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1AC83E4D"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#FF7B7B}"
                                                    BorderColor="#FF7B7B"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Red}" />

                                            <Button Grid.Row="1" Grid.Column="2" Text="Pastel Amber"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Yellow"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1AD48B17"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#FCE100}"
                                                    BorderColor="#FCE100"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Yellow}" />

                                            <Button Grid.Row="1" Grid.Column="3" Text="Pastel Teal"
                                                    Command="{Binding SelectAccentThemeCommand}" CommandParameter="Teal"
                                                    HeightRequest="38" FontSize="12" FontFamily="SegoeSemibold"
                                                    BackgroundColor="#1A1E989B"
                                                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=#48CAE4}"
                                                    BorderColor="#48CAE4"
                                                    BorderWidth="{Binding SelectedAccentTheme, Converter={StaticResource StringEqualsToBorderWidthConverter}, ConverterParameter=Teal}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

                <!-- ===== Navigation & Sidebar ===== -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Navigation}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:SettingsPageModel">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    Padding="20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="14">
                                    <Label Text="Navigation &amp; Sidebar"
                                           FontFamily="SegoeSemibold" FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Compact Sidebar Mode" FontSize="13" FontFamily="SegoeSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Label Text="Collapse the left navigation pane to icon-only mode to maximize workspace area."
                                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding IsSidebarCompact}"
                                                OnColor="{DynamicResource AccentFill}" VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Auto-collapse on Narrow Windows" FontSize="13" FontFamily="SegoeSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Label Text="Automatically switch to compact mode when window width is reduced below 1024px."
                                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding AutoCollapseSidebarOnNarrow}"
                                                OnColor="{DynamicResource AccentFill}" VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Raw &amp; Packing Materials Tab" FontSize="13" FontFamily="SegoeSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Label Text="Show the delivery call-off tracker in the sidebar. Existing purchase orders aren't affected either way, and will show automatically if you turn this back on."
                                                   FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding IsRawPackingTabEnabled}"
                                                OnColor="{DynamicResource AccentFill}" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

                <!-- ===== Procurement Defaults ===== -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Procurement}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:SettingsPageModel">
                            <VerticalStackLayout Spacing="22">

                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="16">
                                        <Label Text="Procurement Defaults"
                                               FontFamily="SegoeSemibold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <Grid ColumnDefinitions="*, 140" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Default Currency" FontSize="13" FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Label Text="Default currency applied when creating new RFQs and purchase requisitions."
                                                       FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                            </VerticalStackLayout>
                                            <Picker Grid.Column="1"
                                                    ItemsSource="{Binding AvailableCurrencies}"
                                                    SelectedItem="{Binding DefaultCurrency, Mode=TwoWay}"
                                                    HeightRequest="36" VerticalOptions="Center" />
                                        </Grid>

                                        <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                                        <Label Text="SLA Overdue Thresholds" FontSize="13" FontFamily="SegoeSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="Urgent Priority (Days) *" FontSize="12" FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Entry Text="{Binding UrgentDays, Mode=TwoWay}" Keyboard="Numeric" HeightRequest="36" />
                                                <Label Text="Flagged as overdue after this many days"
                                                       FontSize="11" TextColor="{StaticResource Gray400}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="Normal Priority (Days) *" FontSize="12" FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Entry Text="{Binding NormalDays, Mode=TwoWay}" Keyboard="Numeric" HeightRequest="36" />
                                                <Label Text="Standard PR overdue warning threshold"
                                                       FontSize="11" TextColor="{StaticResource Gray400}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <HorizontalStackLayout Spacing="12" HorizontalOptions="End" VerticalOptions="Center">
                                            <Label Text="{Binding SavedMessage}"
                                                   IsVisible="{Binding SavedMessage, Converter={StaticResource NullToBoolConverter}}"
                                                   FontSize="12" FontFamily="SegoeSemibold" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource FluentSuccess}, Dark={StaticResource FluentSuccessTextDark}}" />
                                            <Button Text="Save Settings"
                                                    Command="{Binding SaveSettingsCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HeightRequest="36" Padding="20,0" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="16">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Default PCR Approval Stages"
                                                       FontFamily="SegoeSemibold" FontSize="15"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Label Text="Global approval stage sequence automatically copied when a new PCR is created."
                                                       FontSize="12" TextColor="{StaticResource Gray400}" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="1"
                                                    Text="Reset to 4 Default Roles"
                                                    Command="{Binding ResetDefaultStagesToPresetCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    FontSize="11" HeightRequest="32" Padding="12,0" />
                                        </Grid>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DefaultApprovalStages}" Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Padding="12,8" StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                            Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>

                                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                            <Label Grid.Column="0" Text="{Binding .}"
                                                                   FontFamily="SegoeSemibold" FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                                   VerticalOptions="Center" />

                                                            <Button Grid.Column="1" Text="&#xE70E;"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    Command="{Binding MoveDefaultStageUpCommand, Source={x:Static pageModels:SettingsPageModel.Current}, x:DataType={x:Type pageModels:SettingsPageModel}}"
                                                                    CommandParameter="{Binding .}"
                                                                    FontSize="11" WidthRequest="28" HeightRequest="28" Padding="0"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                                    CornerRadius="4"
                                                                    ToolTipProperties.Text="Move Up" />

                                                            <Button Grid.Column="2" Text="&#xE70D;"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    Command="{Binding MoveDefaultStageDownCommand, Source={x:Static pageModels:SettingsPageModel.Current}, x:DataType={x:Type pageModels:SettingsPageModel}}"
                                                                    CommandParameter="{Binding .}"
                                                                    FontSize="11" WidthRequest="28" HeightRequest="28" Padding="0"
                                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                                    CornerRadius="4"
                                                                    ToolTipProperties.Text="Move Down" />

                                                            <Button Grid.Column="3" Text="&#xE74D;"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    Command="{Binding RemoveDefaultStageCommand, Source={x:Static pageModels:SettingsPageModel.Current}, x:DataType={x:Type pageModels:SettingsPageModel}}"
                                                                    CommandParameter="{Binding .}"
                                                                    FontSize="11" WidthRequest="28" HeightRequest="28" Padding="0"
                                                                    BackgroundColor="Transparent"
                                                                    TextColor="{StaticResource FluentCritical}"
                                                                    CornerRadius="4"
                                                                    ToolTipProperties.Text="Remove Default Stage" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                            <Entry Grid.Column="0" Text="{Binding NewDefaultStageName, Mode=TwoWay}"
                                                   Placeholder="Enter stage title (e.g. Legal Counsel, Managing Director)..."
                                                   HeightRequest="36" />
                                            <Button Grid.Column="1" Text="+ Add Default Stage"
                                                    Command="{Binding AddNewDefaultStageCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    HeightRequest="36" Padding="16,0" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

                <!-- ===== Custom Columns ===== -->
                <!-- Moved here from its own sidebar tab. The template binds to ManageColumnsPageModel
                     (a DI singleton) rather than the page model - BindingContext is set on the root
                     below; the per-row delete button reaches its command via that model's Current. -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Columns}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:ManageColumnsPageModel">
                            <VerticalStackLayout Spacing="22"
                                                 BindingContext="{Binding ColumnsModel, Source={x:Static pageModels:SettingsPageModel.Current}, x:DataType={x:Type pageModels:SettingsPageModel}}">

                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="16">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Custom Column Definitions"
                                                   FontFamily="SegoeSemibold" FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Label Text="Define team-specific metadata fields (e.g. Cost Center, GL Account, Department) that dynamically attach to every PR."
                                                   FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        </VerticalStackLayout>

                                        <Label Text="+ Add New Custom Field"
                                               FontFamily="SegoeSemibold" FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="14">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="Column Name *" FontSize="12" FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Entry Text="{Binding NewColumnName, Mode=TwoWay}"
                                                       Placeholder="e.g. Cost Center, GL Code, Department"
                                                       HeightRequest="36" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="Data Type *" FontSize="12" FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                <Picker ItemsSource="{Binding AvailableDataTypes}"
                                                        SelectedItem="{Binding NewColumnDataType, Mode=TwoWay}"
                                                        HeightRequest="36" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding ShowOptionsField}" Spacing="4">
                                            <Label Text="Dropdown Options (comma-separated)" FontSize="12" FontFamily="SegoeSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Entry Text="{Binding NewColumnOptions, Mode=TwoWay}"
                                                   Placeholder="e.g. IT, Engineering, Operations, Finance, HR"
                                                   HeightRequest="36" />
                                        </VerticalStackLayout>

                                        <Button Text="Add Column"
                                                Command="{Binding AddColumnCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalOptions="End"
                                                HeightRequest="36" Padding="20,0" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="16">
                                        <Label Text="Active Custom Columns"
                                               FontFamily="SegoeSemibold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Columns}">
                                            <BindableLayout.EmptyView>
                                                <Label Text="No custom columns defined yet."
                                                       FontSize="13" TextColor="{StaticResource Gray400}"
                                                       Padding="20" HorizontalOptions="Center" />
                                            </BindableLayout.EmptyView>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:CustomColumnDefinition">
                                                    <Border Margin="0,0,0,10"
                                                            Padding="16,12"
                                                            StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                            Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="6" />
                                                        </Border.StrokeShape>

                                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                                                <Label Text="{Binding Name}" FontFamily="SegoeSemibold" FontSize="14"
                                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                                <Label Text="{Binding SelectOptions, StringFormat='Options: {0}'}"
                                                                       IsVisible="{Binding SelectOptions, Converter={StaticResource NullToBoolConverter}}"
                                                                       LineBreakMode="TailTruncation" MaxLines="2"
                                                                       FontSize="11" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                                            </VerticalStackLayout>

                                                            <Border Grid.Column="1"
                                                                    Padding="8,3"
                                                                    StrokeThickness="1"
                                                                    Stroke="{AppThemeBinding Light='#CCE4F7', Dark='#244970'}"
                                                                    BackgroundColor="{AppThemeBinding Light='#EBF3FC', Dark='#172E48'}"
                                                                    VerticalOptions="Center">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="4" />
                                                                </Border.StrokeShape>
                                                                <Label Text="{Binding DataType}"
                                                                       FontSize="11" FontFamily="SegoeSemibold"
                                                                       TextColor="{AppThemeBinding Light='#004E8C', Dark='#70B8FF'}" />
                                                            </Border>

                                                            <Button Grid.Column="2"
                                                                    Text="&#xE74D;"
                                                                    FontFamily="Segoe Fluent Icons"
                                                                    Command="{Binding DeleteColumnCommand, Source={x:Static pageModels:ManageColumnsPageModel.Current}, x:DataType={x:Type pageModels:ManageColumnsPageModel}}"
                                                                    CommandParameter="{Binding .}"
                                                                    FontSize="11" HeightRequest="28" WidthRequest="28" Padding="0"
                                                                    CornerRadius="4" BorderWidth="1"
                                                                    BackgroundColor="{AppThemeBinding Light='#FDE7E9', Dark='#3F1011'}"
                                                                    BorderColor="{AppThemeBinding Light='#F1B0B7', Dark='#5C1B1E'}"
                                                                    TextColor="{AppThemeBinding Light={StaticResource FluentCritical}, Dark={StaticResource FluentCriticalTextDark}}"
                                                                    ToolTipProperties.Text="Delete Column" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

                <!-- ===== Updates ===== -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Updates}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:SettingsPageModel">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    Padding="20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="16">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Software Updates"
                                                   FontFamily="SegoeSemibold" FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label Text="Installed Version:" FontSize="12" TextColor="{StaticResource Gray400}" />
                                                <Label Text="{Binding CurrentVersion}" FontSize="12" FontFamily="SegoeSemibold"
                                                       TextColor="{DynamicResource Primary}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Check for Updates"
                                                Command="{Binding CheckForUpdatesCommand}"
                                                IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToInvertedBoolConverter}}"
                                                Style="{StaticResource SecondaryButton}"
                                                HeightRequest="36" Padding="16,0" />
                                    </Grid>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <CheckBox IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}" VerticalOptions="Center" />
                                        <Label Text="Automatically check for new releases when app starts"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center"
                                                           IsVisible="{Binding UpdateStatusMessage, Converter={StaticResource NullToBoolConverter}}">
                                        <ActivityIndicator IsRunning="{Binding IsCheckingForUpdates}"
                                                           IsVisible="{Binding IsCheckingForUpdates}"
                                                           WidthRequest="18" HeightRequest="18" />
                                        <Label Text="{Binding UpdateStatusMessage}"
                                               FontSize="12" FontFamily="SegoeSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Border IsVisible="{Binding IsUpdateAvailable}"
                                            Padding="16" StrokeThickness="1"
                                            Stroke="{DynamicResource Primary}"
                                            Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6" />
                                        </Border.StrokeShape>

                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding UpdateInfo.Title}"
                                                           FontFamily="SegoeSemibold" FontSize="14"
                                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                        <Label Text="{Binding UpdateInfo.TagName, StringFormat='Release Tag: {0}'}"
                                                               FontSize="11" TextColor="{StaticResource Gray400}" />
                                                        <Label Text="&#x2022;" FontSize="11" TextColor="{StaticResource Gray400}"
                                                               IsVisible="{Binding UpdateInfo.FormattedSize, Converter={StaticResource NullToBoolConverter}}" />
                                                        <Label Text="{Binding UpdateInfo.FormattedSize}"
                                                               FontSize="11" TextColor="{StaticResource Gray400}" />
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>

                                                <Border Grid.Column="1" Padding="8,3" StrokeThickness="0"
                                                        BackgroundColor="{StaticResource FluentSuccessBg}" VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="New Update Available"
                                                           FontSize="11" FontFamily="SegoeSemibold"
                                                           TextColor="{StaticResource FluentSuccess}" />
                                                </Border>
                                            </Grid>

                                            <Border Padding="10" StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                                    IsVisible="{Binding UpdateInfo.ReleaseNotes, Converter={StaticResource NullToBoolConverter}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding UpdateInfo.ReleaseNotes}"
                                                       FontSize="12" MaxLines="6" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Border>

                                            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsDownloading}">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Grid.Column="0" Text="Downloading update..." FontSize="11" TextColor="{StaticResource Gray400}" />
                                                    <Label Grid.Column="1" Text="{Binding DownloadPercentageText}" FontSize="11" FontFamily="SegoeSemibold" TextColor="{DynamicResource Primary}" />
                                                </Grid>
                                                <ProgressBar Progress="{Binding DownloadProgress}" HeightRequest="6" />
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                                                <Button Text="Download &amp; Install Update"
                                                        Command="{Binding DownloadAndInstallUpdateCommand}"
                                                        IsEnabled="{Binding IsDownloading, Converter={StaticResource BoolToInvertedBoolConverter}}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        HeightRequest="36" Padding="18,0" />

                                                <Button Text="View Release on GitHub &#x2197;"
                                                        Command="{Binding OpenReleasePageCommand}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        HeightRequest="36" Padding="16,0" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

                <!-- ===== Storage & Data ===== -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Storage}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:SettingsPageModel">
                            <VerticalStackLayout Spacing="22">

                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="16">
                                        <Label Text="SQLite Storage &amp; Database Location"
                                               FontFamily="SegoeSemibold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Current Database File Path:" FontSize="12" FontFamily="SegoeSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Border Padding="12,10" StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                    Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding DatabasePath}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                       LineBreakMode="CharacterWrap" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Spacing="10">
                                            <Button Text="Open DB Folder in Explorer"
                                                    Command="{Binding OpenDatabaseFolderCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HeightRequest="36" Padding="16,0" />
                                            <Button Text="Change Database Location..."
                                                    Command="{Binding ChangeDatabaseLocationCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HeightRequest="36" Padding="16,0" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>

                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="20">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="12">
                                        <Label Text="Database Reset &amp; Demo Data"
                                               FontFamily="SegoeSemibold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <Label Text="Reset the local database and populate with realistic sample requisitions, RFQs, PCR approvals, POs, and custom fields."
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                                        <Button Text="Reset &amp; Re-Seed Sample Data"
                                                Command="{Binding ResetDatabaseCommand}"
                                                BackgroundColor="{StaticResource FluentCriticalBg}"
                                                TextColor="{StaticResource FluentCritical}"
                                                HorizontalOptions="Start"
                                                HeightRequest="36" Padding="16,0" />
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

                <!-- ===== Keyboard Shortcuts ===== -->
                <converters:LazyExpander
                                         IsExpanded="{Binding SelectedSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Shortcuts}">
                    <converters:LazyExpander.ContentTemplate>
                        <DataTemplate x:DataType="pageModels:SettingsPageModel">
                            <Border StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    Padding="20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Keyboard Shortcuts"
                                                   FontFamily="SegoeSemibold" FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <Label Text="Click a shortcut, then press a new key combination. Press Escape while recording to cancel without changing it."
                                                   FontSize="12" TextColor="{StaticResource Gray400}" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="Reset All to Defaults"
                                                Command="{Binding ResetAllShortcutsCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11" HeightRequest="32" Padding="12,0" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ShortcutRows}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ShortcutRowViewModel">
                                                <Border Padding="12,8" StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                        Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                                            <Label Text="{Binding DisplayName}"
                                                                   FontFamily="SegoeSemibold" FontSize="12.5"
                                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                                            <Label Text="{Binding Scope}"
                                                                   FontSize="10.5" TextColor="{StaticResource Gray400}" />
                                                        </VerticalStackLayout>

                                                        <Button Grid.Column="1"
                                                                Text="{Binding DisplayText}"
                                                                Command="{Binding StartRecordingCommand}"
                                                                FontSize="11.5" WidthRequest="140" HeightRequest="30" Padding="8,0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                                                TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                                CornerRadius="4"
                                                                ToolTipProperties.Text="Click, then press a new key combination" />

                                                        <Button Grid.Column="2" Text="&#xE72C;"
                                                                FontFamily="Segoe Fluent Icons"
                                                                Command="{Binding ResetToDefaultCommand}"
                                                                IsVisible="{Binding IsCustomized}"
                                                                FontSize="12" WidthRequest="30" HeightRequest="30" Padding="0"
                                                                BackgroundColor="Transparent"
                                                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                                                CornerRadius="4"
                                                                ToolTipProperties.Text="Reset to default" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </converters:LazyExpander.ContentTemplate>
                </converters:LazyExpander>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
