<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Procure.PageModels"
             xmlns:models="clr-namespace:Procure.Models"
             xmlns:modals="clr-namespace:Procure.Pages.Modals"
             xmlns:controls="clr-namespace:Procure.Pages.Controls"
             xmlns:converters="clr-namespace:Procure.Utilities"
             xmlns:f="clr-namespace:Fonts"
             x:Class="Procure.Pages.PrListPage"
             x:Name="ThisPage"
             x:DataType="pageModels:PrListPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollView Padding="28,36,28,36">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="1600" HorizontalOptions="Fill">

                <!-- Page Header: Title + Primary Actions -->
                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto" Margin="0,6,0,0">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Label Text="Purchase Requisitions"
                                   FontFamily="SegoeSemibold"
                                   FontSize="26"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            
                            <Border Padding="10,3" StrokeThickness="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="{Binding FilteredPrs.Count, StringFormat='{0} requisitions'}"
                                       FontSize="12"
                                       FontFamily="SegoeSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </Border>
                        </HorizontalStackLayout>
                        
                        <Label Text="Manage procurement lifecycle across vendor RFQs, multi-role PCR approvals, and purchase orders."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>

                    <!-- Right Command Buttons -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Button Text="Export CSV"
                                ImageSource="{StaticResource IconExport}"
                                Command="{Binding ExportCsvCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="38"
                                Padding="16,0" />

                        <Button Text="Refresh"
                                ImageSource="{StaticResource IconRefresh}"
                                Command="{Binding LoadPrsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="38"
                                Padding="14,0" />

                        <Button Text="+ Bulk Create"
                                Command="{Binding OpenBatchCreateModalCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="38"
                                Padding="20,0" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Filter & Search Toolbar (Flat Fluent Command Bar - Native WinUI 3 Controls) -->
                <Grid ColumnDefinitions="*, 150, Auto, Auto, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <!-- Search Input (Direct Native WinUI 3 Control) -->
                    <Entry Grid.Column="0"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           Placeholder="Search by PR #, item, requestor..."
                           FontSize="13"
                           HeightRequest="36"
                           VerticalOptions="Center" />

                    <!-- Status Picker Dropdown (Direct Native WinUI 3 Control) -->
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding StatusFilterOptions}"
                            SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                            FontSize="13"
                            HeightRequest="36"
                            VerticalOptions="Center" />

                    <!-- Filter Chip: Overdue SLA (Pill Button) -->
                    <Button Grid.Column="2"
                            Text="Overdue SLA"
                            Command="{Binding ToggleFilterOverdueCommand}"
                            HeightRequest="36"
                            Padding="14,0"
                            CornerRadius="6"
                            FontSize="12"
                            FontFamily="SegoeSemibold"
                            BorderWidth="1"
                            BorderColor="{Binding FilterOverdueOnly, Converter={StaticResource BoolToFilterChipStrokeConverter}}"
                            BackgroundColor="{Binding FilterOverdueOnly, Converter={StaticResource BoolToFilterChipBgConverter}}"
                            TextColor="{Binding FilterOverdueOnly, Converter={StaticResource BoolToFilterChipTextConverter}}" />

                    <!-- Filter Chip: PCR Awaiting Sign (Pill Button) -->
                    <Button Grid.Column="3"
                            Text="PCR Awaiting Sign"
                            Command="{Binding ToggleFilterPcrPendingCommand}"
                            HeightRequest="36"
                            Padding="14,0"
                            CornerRadius="6"
                            FontSize="12"
                            FontFamily="SegoeSemibold"
                            BorderWidth="1"
                            BorderColor="{Binding FilterPcrPendingOnly, Converter={StaticResource BoolToFilterChipStrokeConverter}}"
                            BackgroundColor="{Binding FilterPcrPendingOnly, Converter={StaticResource BoolToFilterChipBgConverter}}"
                            TextColor="{Binding FilterPcrPendingOnly, Converter={StaticResource BoolToFilterChipTextConverter}}" />

                    <!-- Filter Chip: Urgent Only (Pill Button) -->
                    <Button Grid.Column="4"
                            Text="Urgent Only"
                            Command="{Binding ToggleFilterUrgentCommand}"
                            HeightRequest="36"
                            Padding="14,0"
                            CornerRadius="6"
                            FontSize="12"
                            FontFamily="SegoeSemibold"
                            BorderWidth="1"
                            BorderColor="{Binding FilterUrgentOnly, Converter={StaticResource BoolToFilterChipStrokeConverter}}"
                            BackgroundColor="{Binding FilterUrgentOnly, Converter={StaticResource BoolToFilterChipBgConverter}}"
                            TextColor="{Binding FilterUrgentOnly, Converter={StaticResource BoolToFilterChipTextConverter}}" />
                </Grid>

                <!-- Transient InfoBar / Notification (Clean Windows 11 Inline InfoBar) -->
                <Border IsVisible="{Binding IsStatusMessageVisible}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource AlertWarningBorderLight}, Dark={StaticResource AlertWarningBorderDark}}"
                        Background="{AppThemeBinding Light={StaticResource AlertWarningBgLight}, Dark={StaticResource AlertWarningBgDark}}"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="&#xE7BA;"
                               FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource AlertWarningIconLight}, Dark={StaticResource AlertWarningIconDark}}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding StatusMessage}"
                               FontSize="12"
                               FontFamily="SegoeSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="✕"
                                Command="{Binding DismissStatusMessageCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Gray400}"
                                FontSize="12" HeightRequest="26" WidthRequest="26" Padding="0" />
                    </Grid>
                </Border>

                <!-- Batch Action Bar (Visible when 1 or more PRs are selected) -->
                <Border IsVisible="{Binding IsBatchSelectionActive}"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                        Padding="16,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" Offset="0,4" Radius="12" Opacity="0.7" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                        <!-- Selection summary -->
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Border Padding="6,2" StrokeThickness="0" BackgroundColor="{DynamicResource Primary}" VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label Text="{Binding SelectedPrsCount}" FontSize="12" FontFamily="SegoeSemibold" TextColor="White" />
                            </Border>
                            <Label Text="{Binding SelectedPrsSummary}"
                                   FontFamily="SegoeSemibold"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Dynamic Batch Actions (Buttons switch up automatically based on selection state) -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                            <!-- Button 1: Combine / Merge PRs vs Split / Unmerge PR -->
                            <Button Text="{Binding MergeButtonText}"
                                    Command="{Binding MergeOrSplitPrCommand}"
                                    IsEnabled="{Binding IsMergeOrSplitPrEnabled}"
                                    Style="{StaticResource PrimaryButton}"
                                    HeightRequest="34"
                                    Padding="14,0"
                                    FontSize="12"
                                    ToolTipProperties.Text="{Binding MergeButtonToolTip}" />

                            <!-- Button 2: Shared RFQ vs Split Shared RFQ -->
                            <Button Text="{Binding SharedRfqButtonText}"
                                    Command="{Binding CreateOrSplitSharedRfqCommand}"
                                    IsEnabled="{Binding IsSharedRfqActionEnabled}"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="34"
                                    Padding="12,0"
                                    FontSize="12"
                                    ToolTipProperties.Text="{Binding SharedRfqButtonToolTip}" />

                            <!-- Button 3: Combined PO vs Split Combined PO -->
                            <Button Text="{Binding CombinedPoButtonText}"
                                    Command="{Binding CreateOrSplitCombinedPoCommand}"
                                    IsEnabled="{Binding IsCombinedPoActionEnabled}"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="34"
                                    Padding="12,0"
                                    FontSize="12"
                                    ToolTipProperties.Text="{Binding CombinedPoButtonToolTip}" />

                            <!-- Button 4: Clear Selection -->
                            <Button Text="Clear"
                                    Command="{Binding ClearSelectionCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="34"
                                    Padding="10,0"
                                    FontSize="12" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- ===== SKELETON LOADING (visible while IsBusy = true) ===== -->
                <controls:PrListSkeleton x:Name="SkeletonContainer"
                                         IsVisible="{Binding IsBusy}" />

                <!-- PR Cards List (Lightweight BindableLayout - Eliminates CollectionView layout measurement freeze) -->
                <VerticalStackLayout IsVisible="{Binding IsBusy, Converter={StaticResource BoolToInvertedBoolConverter}}"
                                     BindableLayout.ItemsSource="{Binding FilteredPrs}">
                    <BindableLayout.EmptyView>
                        <VerticalStackLayout Padding="60,40" Spacing="14" HorizontalOptions="Center">
                            <Label Text="No purchase requisitions match your criteria."
                                   FontSize="15"
                                   FontFamily="SegoeSemibold"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalOptions="Center" />
                            <Button Text="Reset Filters"
                                    Command="{Binding LoadPrsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HeightRequest="36"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PurchaseRequisition">
                            <Border Margin="0,0,0,14"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="0">

                                    <!-- CARD HEADER ROW (Clickable to expand/collapse) -->
                                    <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto, Auto"
                                          RowDefinitions="Auto"
                                          Padding="14,14,18,14"
                                          ColumnSpacing="10"
                                          BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleExpandCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>

                                        <!-- Multi-Select CheckBox (Native WinUI 3 CheckBox with zero MinWidth/Padding) -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  CheckedChanged="OnPrSelectionCheckedChanged"
                                                  HorizontalOptions="Start"
                                                  VerticalOptions="Center" />

                                        <!-- Priority Badge (Clickable: toggles Urgent / Normal) -->
                                        <Button Grid.Column="1"
                                                Text="{Binding Priority}"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.TogglePriorityCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="11"
                                                FontFamily="SegoeSemibold"
                                                HeightRequest="26"
                                                Padding="8,0"
                                                CornerRadius="4"
                                                BorderWidth="1"
                                                BorderColor="{Binding Priority, Converter={StaticResource PriorityBorderConverter}}"
                                                BackgroundColor="{Binding Priority, Converter={StaticResource PriorityBgConverter}}"
                                                TextColor="{Binding Priority, Converter={StaticResource PriorityColorConverter}}"
                                                VerticalOptions="Center" />

                                        <!-- PR Type & PR Number & Requestor & Plant -->
                                        <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center" WidthRequest="140">
                                            <!-- PR Type Badge (Positioned above PR Number) -->
                                            <Border IsVisible="{Binding PrType, Converter={StaticResource NullToBoolConverter}}"
                                                    Margin="0,0,0,2" Padding="6,2" StrokeThickness="1"
                                                    Stroke="{Binding PrType, Converter={StaticResource PrTypeBorderConverter}}"
                                                    BackgroundColor="{Binding PrType, Converter={StaticResource PrTypeBgConverter}}"
                                                    HorizontalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding PrType}"
                                                       FontSize="10" FontFamily="SegoeSemibold"
                                                       TextColor="{Binding PrType, Converter={StaticResource PrTypeColorConverter}}" />
                                            </Border>

                                            <Label Text="{Binding PrNo}"
                                                   FontFamily="SegoeSemibold"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Requestor}"
                                                       FontSize="12"
                                                       LineBreakMode="TailTruncation"
                                                       MaximumWidthRequest="80"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                                <Label Text="•"
                                                       FontSize="10"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                       IsVisible="{Binding Plant, Converter={StaticResource NullToBoolConverter}}" />
                                                <Label Text="{Binding Plant}"
                                                       FontSize="11"
                                                       FontFamily="SegoeSemibold"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                       IsVisible="{Binding Plant, Converter={StaticResource NullToBoolConverter}}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Description & Age & Consolidation Badges -->
                                        <VerticalStackLayout Grid.Column="3" Spacing="4" VerticalOptions="Center">
                                            <!-- Badges Row (Consolidation, Merged, Shared RFQ, Combined PO) -->
                                            <FlexLayout Wrap="Wrap" AlignItems="Center">
                                                <!-- Consolidation Master Badge -->
                                                <Border IsVisible="{Binding IsConsolidatedMaster}"
                                                        Margin="0,0,6,2" Padding="6,2" StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource BadgeCombinedPrBorderLight}, Dark={StaticResource BadgeCombinedPrBorderDark}}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BadgeCombinedPrBgLight}, Dark={StaticResource BadgeCombinedPrBgDark}}"
                                                        HorizontalOptions="Start">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding ConsolidatedFrom, StringFormat='Combined: {0}'}"
                                                           FontSize="10" FontFamily="SegoeSemibold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BadgeCombinedPrTextLight}, Dark={StaticResource BadgeCombinedPrTextDark}}"
                                                           LineBreakMode="TailTruncation"
                                                           MaximumWidthRequest="320" />
                                                </Border>

                                                <!-- Merged Child Badge -->
                                                <Border IsVisible="{Binding IsMergedChild}"
                                                        Margin="0,0,6,2" Padding="6,2" StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource BadgeMergedBorderLight}, Dark={StaticResource BadgeMergedBorderDark}}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BadgeMergedBgLight}, Dark={StaticResource BadgeMergedBgDark}}"
                                                        HorizontalOptions="Start">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="Merged into Master PR"
                                                           FontSize="10" FontFamily="SegoeSemibold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BadgeMergedTextLight}, Dark={StaticResource BadgeMergedTextDark}}" />
                                                </Border>

                                                <!-- Shared RFQ Badge -->
                                                <Border IsVisible="{Binding HasSharedRfqs}"
                                                        Margin="0,0,6,2" Padding="6,2" StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource BadgeSharedRfqBorderLight}, Dark={StaticResource BadgeSharedRfqBorderDark}}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BadgeSharedRfqBgLight}, Dark={StaticResource BadgeSharedRfqBgDark}}"
                                                        HorizontalOptions="Start">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding SharedRfqsBadgeText, StringFormat='Shared RFQ ({0})'}"
                                                           FontSize="10" FontFamily="SegoeSemibold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BadgeSharedRfqTextLight}, Dark={StaticResource BadgeSharedRfqTextDark}}"
                                                           LineBreakMode="TailTruncation"
                                                           MaximumWidthRequest="320" />
                                                </Border>

                                                <!-- Combined PO Badge -->
                                                <Border IsVisible="{Binding HasCombinedPos}"
                                                        Margin="0,0,6,2" Padding="6,2" StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource BadgeCombinedPoBorderLight}, Dark={StaticResource BadgeCombinedPoBorderDark}}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BadgeCombinedPoBgLight}, Dark={StaticResource BadgeCombinedPoBgDark}}"
                                                        HorizontalOptions="Start">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding CombinedPosBadgeText, StringFormat='Combined PO ({0})'}"
                                                           FontSize="10" FontFamily="SegoeSemibold"
                                                           TextColor="{AppThemeBinding Light={StaticResource BadgeCombinedPoTextLight}, Dark={StaticResource BadgeCombinedPoTextDark}}"
                                                           LineBreakMode="TailTruncation"
                                                           MaximumWidthRequest="320" />
                                                </Border>
                                            </FlexLayout>

                                            <!-- Description (Ellipsized at 2 lines max so cards stay compact & aligned) -->
                                            <Label Text="{Binding Description}"
                                                   FontFamily="SegoeSemibold"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                   MaxLines="2"
                                                   LineBreakMode="TailTruncation" />

                                            <!-- Items Count Tag & Age -->
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <!-- Total items tag -->
                                                <Border IsVisible="{Binding HasItems}"
                                                        Padding="5,1" StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource PillBorderLight}, Dark={StaticResource PillBorderDark}}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource PillBgLight}, Dark={StaticResource PillBgDark}}"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                                    <Label Text="{Binding ItemsCount, StringFormat='{0} items'}"
                                                           FontSize="9.5" FontFamily="SegoeSemibold"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                                </Border>

                                                <!-- Age -->
                                                <Label Text="{Binding AgeDisplay, StringFormat='Raised {0}'}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextTertiary}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Pipeline Count Pills (Unified Metric Strip) -->
                                        <HorizontalStackLayout Grid.Column="4" Spacing="8" VerticalOptions="Center">
                                            <!-- RFQ Pill -->
                                            <Border Padding="8,3" StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource PillBorderLight}, Dark={StaticResource PillBorderDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource PillBgLight}, Dark={StaticResource PillBgDark}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding RfqCount, StringFormat='{0} RFQs'}"
                                                       FontSize="11"
                                                       FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource PillTextNeutralLight}, Dark={StaticResource PillTextNeutralDark}}" />
                                            </Border>

                                            <!-- PCR Pill -->
                                            <Border Padding="8,3" StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource PillBorderLight}, Dark={StaticResource PillBorderDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource PillBgLight}, Dark={StaticResource PillBgDark}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding PcrStatusDisplay}"
                                                       FontSize="11"
                                                       FontFamily="SegoeSemibold"
                                                       TextColor="{Binding PcrStatusDisplay, Converter={StaticResource PcrPillTextColorConverter}}" />
                                            </Border>

                                            <!-- PO Pill -->
                                            <Border Padding="8,3" StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource PillBorderLight}, Dark={StaticResource PillBorderDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource PillBgLight}, Dark={StaticResource PillBgDark}}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding FormattedTotalPoValue, StringFormat='PO: {0}'}"
                                                       FontSize="11"
                                                       FontFamily="SegoeSemibold"
                                                       TextColor="{Binding TotalPoValue, Converter={StaticResource PoPillTextColorConverter}}" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- Status InfoBadge (Clickable: opens native button-anchored flyout) -->
                                        <Button Grid.Column="5"
                                                Text="{Binding Status}"
                                                Clicked="OnPrStatusButtonClicked"
                                                FontSize="12"
                                                FontFamily="SegoeSemibold"
                                                HeightRequest="28"
                                                Padding="12,0"
                                                CornerRadius="6"
                                                BorderWidth="0"
                                                BackgroundColor="{Binding Status, Converter={StaticResource StatusBadgeBgConverter}}"
                                                TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                VerticalOptions="Center" />

                                        <!-- Edit & Delete Action Icon Buttons -->
                                        <HorizontalStackLayout Grid.Column="6" Spacing="6" VerticalOptions="Center">
                                            <Button Text="&#xE70F;"
                                                    FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenEditPrModalCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="12"
                                                    HeightRequest="30"
                                                    WidthRequest="30"
                                                    Padding="0"
                                                    CornerRadius="4"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                    ToolTipProperties.Text="Edit PR" />

                                            <Button Text="&#xE74D;"
                                                    FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                                    Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeletePrCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="12"
                                                    HeightRequest="30"
                                                    WidthRequest="30"
                                                    Padding="0"
                                                    CornerRadius="4"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource FluentCritical}, Dark={StaticResource FluentCriticalTextDark}}"
                                                    ToolTipProperties.Text="Delete PR" />
                                        </HorizontalStackLayout>

                                        <!-- Expand / Collapse Indicator Chevron -->
                                        <Label Grid.Column="7"
                                                Text="{Binding IsExpanded, Converter={StaticResource BoolToChevronConverter}}"
                                                FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                                FontSize="11"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                                                VerticalOptions="Center" />
                                    </Grid>

                                    <!-- EXPANDED DETAIL VIEW (3-COLUMN NATIVE FLUENT PANEL) -->
                                    <converters:LazyExpander IsExpanded="{Binding IsExpanded}">
                                        <converters:LazyExpander.PlaceholderTemplate>
                                        <DataTemplate>
                                            <!-- Shown for one frame while the real panel builds, so a
                                                 data-heavy PR reads as loading rather than hung. Mirrors
                                                 the 3-column shape below so the swap is not jarring. -->
                                            <Border StrokeThickness="0" Padding="18"
                                                    Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkBackground}}">
                                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="14">
                                                    <Border Grid.Column="0" Padding="16" StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="12">
                                                            <BoxView HeightRequest="12" WidthRequest="140" CornerRadius="3" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                                            <BoxView HeightRequest="58" CornerRadius="6" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                                            <BoxView HeightRequest="58" CornerRadius="6" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="1" Padding="16" StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="12">
                                                            <BoxView HeightRequest="12" WidthRequest="120" CornerRadius="3" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                                            <BoxView HeightRequest="58" CornerRadius="6" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                                            <BoxView HeightRequest="58" CornerRadius="6" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border Grid.Column="2" Padding="16" StrokeThickness="1"
                                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                            Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="12">
                                                            <BoxView HeightRequest="12" WidthRequest="130" CornerRadius="3" HorizontalOptions="Start" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />
                                                            <BoxView HeightRequest="58" CornerRadius="6" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                                            <BoxView HeightRequest="58" CornerRadius="6" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </converters:LazyExpander.PlaceholderTemplate>

                                    <converters:LazyExpander.ContentTemplate>
                                        <DataTemplate x:DataType="models:PurchaseRequisition">
                                            <controls:PrDetailPanel PageModel="{Binding Source={x:Reference ThisPage}, Path=BindingContext}" />
                                        </DataTemplate>
                                    </converters:LazyExpander.ContentTemplate>
                                    </converters:LazyExpander>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Fluent Pagination Bar (Fast 0ms Navigation) -->
                <Grid IsVisible="{Binding IsBusy, Converter={StaticResource BoolToInvertedBoolConverter}}"
                      ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" Margin="0,8,0,16">
                    <!-- Left: Summary ("Showing 1–10 of 48 requisitions") -->
                    <Label Grid.Column="0"
                           Text="{Binding PaginationSummary}"
                           FontSize="12"
                           FontFamily="SegoeSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           VerticalOptions="Center" />

                    <!-- Right: Page Size Selector & Navigation Buttons -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                        <Label Text="Rows per page:"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />

                        <Picker ItemsSource="{Binding PageSizeOptions}"
                                SelectedItem="{Binding PageSize, Mode=TwoWay}"
                                FontSize="12"
                                HeightRequest="32"
                                WidthRequest="80"
                                VerticalOptions="Center" />

                        <Label Text="{Binding CurrentPage, StringFormat='Page {0} of '}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding TotalPages}"
                               FontSize="12"
                               FontFamily="SegoeSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                               VerticalOptions="Center" />

                        <!-- Navigation Buttons -->
                        <Button Text="&#xE892;"
                                FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                FontSize="12"
                                Command="{Binding FirstPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" WidthRequest="36" Padding="0" />

                        <Button Text="&#xE76B;"
                                FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                FontSize="12"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" WidthRequest="36" Padding="0" />

                        <Button Text="&#xE76C;"
                                FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                FontSize="12"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" WidthRequest="36" Padding="0" />

                        <Button Text="&#xE893;"
                                FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Default='Segoe MDL2 Assets'}"
                                FontSize="12"
                                Command="{Binding LastPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="32" WidthRequest="36" Padding="0" />
                    </HorizontalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= MODALS LAYER (Modular ContentView Components) ================= -->
        <converters:LazyExpander IsExpanded="{Binding IsEditModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:EditPrModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsAddRfqModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:AddRfqModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsAddPoModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:AddPoModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsApprovalConfigModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:ApprovalConfigModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsExportPcrModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:ExportPcrModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsMergePrModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:MergePrModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsSplitPrModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:SplitPrModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsBatchRfqModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:BatchRfqModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsBatchPoModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:BatchPoModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>
        <converters:LazyExpander IsExpanded="{Binding IsBatchCreateModalVisible}">
            <converters:LazyExpander.ContentTemplate>
                <DataTemplate><modals:BatchCreateModal /></DataTemplate>
            </converters:LazyExpander.ContentTemplate>
        </converters:LazyExpander>

        <!-- Hardware-Accelerated Smooth Theme Transition Curtain -->
        <BoxView x:Name="ThemeCurtain"
                 IsVisible="False"
                 Opacity="0"
                 InputTransparent="True"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 ZIndex="9999" />

    </Grid>
</ContentPage>
