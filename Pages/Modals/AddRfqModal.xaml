<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Procure.PageModels"
             xmlns:models="clr-namespace:Procure.Models"
             x:Class="Procure.Pages.Modals.AddRfqModal"
             x:Name="RfqModalRoot"
             x:DataType="pageModels:PrListPageModel"
             IsVisible="{Binding IsAddRfqModalVisible}">

    <Grid BackgroundColor="#99000000">
        <Border MaximumWidthRequest="950"
                Margin="24"
                MaximumHeightRequest="780"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                Padding="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#30000000" Offset="0,8" Radius="20" Opacity="0.8" />
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout Spacing="16">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Text="{Binding ModalRfqTitle}"
                               FontFamily="SegoeSemibold" FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                        <Button Grid.Column="1" Text="&#xE711;"
                                FontFamily="Segoe Fluent Icons"
                                Command="{Binding CloseAddRfqModalCommand}"
                                FontSize="12" WidthRequest="30" HeightRequest="30" Padding="0"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                ToolTipProperties.Text="Close" />
                    </Grid>

                    <!-- SECTION 1: Commercial Header & Terms (2 Clean Rows) -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="12">
                            <!-- Row 1: RFQ Number (200), Vendor Name (*), Technical Approval (200) -->
                            <Grid ColumnDefinitions="200, *, 200" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="RFQ Number" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry x:Name="RfqNoEntry" Text="{Binding NewRfqNo, Mode=TwoWay}" Placeholder="e.g. RFQ-001-A" HeightRequest="36" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Vendor Name *" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry Text="{Binding NewRfqVendor, Mode=TwoWay}" Placeholder="e.g. Dell Enterprise Systems" HeightRequest="36" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Technical Approval" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Picker ItemsSource="{Binding AvailableTechnicalApprovals}"
                                            SelectedItem="{Binding NewRfqTechnicalApproval, Mode=TwoWay}"
                                            HeightRequest="36" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Row 2: Currency, Payment Terms, Incoterms, Lead Time, Warranty -->
                            <Grid ColumnDefinitions="110, 160, 120, 160, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Currency" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Picker ItemsSource="{Binding AvailableCurrencies}"
                                            SelectedItem="{Binding NewRfqCurrency, Mode=TwoWay}"

                                            HeightRequest="36" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Payment Terms" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry Text="{Binding NewRfqPaymentTerms, Mode=TwoWay}" Placeholder="30 Days Net" HeightRequest="36" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Incoterms" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Picker ItemsSource="{Binding AvailableIncoterms}"
                                            SelectedItem="{Binding NewRfqIncoterms, Mode=TwoWay}"
                                            HeightRequest="36" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Text="Delivery / Lead Time" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry Text="{Binding NewRfqDeliveryLeadTime, Mode=TwoWay}" Placeholder="e.g. 2 Weeks" HeightRequest="36" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="4" Spacing="4">
                                    <Label Text="Warranty" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry Text="{Binding NewRfqWarranty, Mode=TwoWay}" Placeholder="e.g. 12 Months / 1 Year" HeightRequest="36" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SECTION 2: Item-Level Quoting & Pricing Table -->
                    <Border IsVisible="{Binding HasEditingRfqItems}"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <!-- Items Section Header -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="PR Line Items &amp; Quoted Unit Rates"
                                           FontFamily="SegoeSemibold" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Label Text="Select items quoted by the vendor and enter unit prices (paste from Excel supported)."
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                    <Button Text="+ Add Line"
                                            Command="{Binding AddEditingRfqItemCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="11" HeightRequest="28" Padding="8,0"
                                            ToolTipProperties.Text="Add a line item (e.g. when a vendor splits one PR line into two quoted rows)" />
                                    <Button Text="{Binding AllRfqItemsSelected, Converter={StaticResource SelectionToggleConverter}}"
                                            Command="{Binding ToggleAllRfqItemsCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="11" HeightRequest="28" Padding="8,0" />
                                    <Button Text="&#xE8C8; Copy for Email"
                                            FontFamily="Segoe Fluent Icons"
                                            Command="{Binding CopySelectedRfqItemsForEmailCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="11" HeightRequest="28" Padding="10,0"
                                            ToolTipProperties.Text="Copy selected items as a formatted table ready to paste into an email to supplier" />
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Table Header -->
                            <Grid ColumnDefinitions="36, *, 72, 64, 82, 80, 95, 90, 34"
                                  ColumnSpacing="8"
                                  Padding="6,4"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                                <Label Grid.Column="0" Text="Quote" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="1" Text="Item Description" FontSize="10.5" FontFamily="SegoeSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="2" Text="Qty" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="3" Text="Unit" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="4" Text="Unit Price" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="5" Text="Discount" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="6" Text="Line Total" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                <Label Grid.Column="7" Text="Historical Price" FontSize="10.5" FontFamily="SegoeSemibold" HorizontalOptions="End"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>

                            <!-- Table Rows. A virtualizing CollectionView with a bounded height:
                                 the old non-virtualized stack realized every row at open and
                                 re-measured all of them on every keystroke — with 60+ items that
                                 was the typing lag. Height tracks the item count up to ~8 rows,
                                 then the table scrolls internally. -->
                            <CollectionView ItemsSource="{Binding EditingRfqItems}"
                                            HeightRequest="{Binding RfqItemsListHeight}"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RfqItem">
                                        <Grid ColumnDefinitions="36, *, 72, 64, 82, 80, 95, 90, 34"
                                              ColumnSpacing="8"
                                              Padding="4,2"
                                              VerticalOptions="Center">
                                            <!-- Quoted CheckBox -->
                                            <CheckBox Color="{DynamicResource AccentFill}" Grid.Column="0"
                                                      IsChecked="{Binding IsQuoted, Mode=TwoWay}"
                                                      CheckedChanged="OnRfqItemCheckedChanged"
                                                      VerticalOptions="Center"
                                                      HorizontalOptions="Center" />

                                            <!-- Item Description (editable: correct a name or fill in a split line) -->
                                            <Entry Grid.Column="1"
                                                   Text="{Binding ItemName, Mode=TwoWay}"
                                                   Placeholder="Item name / spec..."
                                                   FontSize="12"
                                                   HeightRequest="32"
                                                   VerticalOptions="Center" />

                                            <!-- Quantity (editable: a vendor may re-pack or split a PR line) -->
                                            <Entry Grid.Column="2"
                                                   Text="{Binding Quantity, Mode=TwoWay}"
                                                   Placeholder="Qty"
                                                   Keyboard="Numeric"
                                                   HeightRequest="32"
                                                   FontSize="12"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="End" />

                                            <!-- Unit -->
                                            <Entry Grid.Column="3"
                                                   Text="{Binding Unit, Mode=TwoWay}"
                                                   Placeholder="pcs"
                                                   HeightRequest="32"
                                                   FontSize="12"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start" />

                                            <!-- Unit Price Input -->
                                            <Entry Grid.Column="4"
                                                   Text="{Binding QuotedUnitPrice, Mode=TwoWay}"
                                                   Placeholder="0.00"
                                                   Keyboard="Numeric"
                                                   HeightRequest="32"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="End"
                                                   IsEnabled="{Binding IsQuoted}"
                                                   Loaded="OnRfqUnitPriceEntryLoaded"
                                                   Unloaded="OnRfqUnitPriceEntryUnloaded"
                                                   TextChanged="OnRfqUnitPriceTextChanged" />

                                            <!-- Line Discount Input -->
                                            <Entry Grid.Column="5"
                                                   Text="{Binding Discount, Mode=TwoWay}"
                                                   Placeholder="0.00"
                                                   Keyboard="Numeric"
                                                   HeightRequest="32"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="End"
                                                   IsEnabled="{Binding IsQuoted}"
                                                   Loaded="OnRfqDiscountEntryLoaded"
                                                   Unloaded="OnRfqDiscountEntryUnloaded"
                                                   TextChanged="OnRfqDiscountTextChanged" />

                                            <!-- Line Total Display -->
                                            <Label Grid.Column="6"
                                                   Text="{Binding FormattedLineTotal}"
                                                   FontSize="12"
                                                   FontFamily="SegoeSemibold"
                                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Center" />

                                            <!-- Last Price Input -->
                                            <Entry Grid.Column="7"
                                                   Text="{Binding LastPrice, Mode=TwoWay}"
                                                   Placeholder="0.00"
                                                   Keyboard="Numeric"
                                                   HeightRequest="32"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="End"
                                                   IsEnabled="{Binding IsQuoted}"
                                                   Loaded="OnRfqLastPriceEntryLoaded"
                                                   Unloaded="OnRfqLastPriceEntryUnloaded"
                                                   TextChanged="OnRfqLastPriceTextChanged" />

                                            <!-- Remove line -->
                                            <Button Grid.Column="8"
                                                    Text="&#xE74D;"
                                                    FontFamily="Segoe Fluent Icons"
                                                    Command="{Binding Source={x:Reference RfqModalRoot}, Path=BindingContext.RemoveEditingRfqItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource FluentCritical}"
                                                    ToolTipProperties.Text="Remove Item"
                                                    HeightRequest="28" WidthRequest="28" Padding="0" FontSize="11"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SECTION 3: Financial Summary & VAT Breakdown Card -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, *, *, *, 120" ColumnSpacing="10">
                                <!-- Base Quote Total -->
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Base Quote Sum" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry Text="{Binding NewRfqQuoteAmount, Mode=TwoWay}"
                                           Placeholder="0.00"
                                           Keyboard="Numeric"
                                           HeightRequest="36"
                                           FontSize="13"
                                           FontFamily="SegoeSemibold"
                                           TextChanged="OnRfqQuoteAmountTextChanged" />
                                </VerticalStackLayout>

                                <!-- Freight Charges -->
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Freight" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry Text="{Binding NewRfqFreight, Mode=TwoWay}"
                                           Placeholder="0.00"
                                           Keyboard="Numeric"
                                           HeightRequest="36"
                                           TextChanged="OnRfqFreightTextChanged" />
                                </VerticalStackLayout>

                                <!-- Other Charges -->
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Other Charges" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry Text="{Binding NewRfqOtherCharges, Mode=TwoWay}"
                                           Placeholder="0.00"
                                           Keyboard="Numeric"
                                           HeightRequest="36"
                                           TextChanged="OnRfqOtherChargesTextChanged" />
                                </VerticalStackLayout>

                                <!-- Overall Discount (Before Tax) -->
                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Text="Total Discount" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Entry Text="{Binding NewRfqDiscount, Mode=TwoWay}"
                                           Placeholder="0.00"
                                           Keyboard="Numeric"
                                           HeightRequest="36"
                                           TextChanged="OnRfqTotalDiscountTextChanged" />
                                </VerticalStackLayout>

                                <!-- VAT Applicable -->
                                <VerticalStackLayout Grid.Column="4" Spacing="4">
                                    <Label Text="VAT Applicable" FontSize="11"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <Picker ItemsSource="{Binding AvailableVatTypes}"
                                            SelectedItem="{Binding NewRfqVatType, Mode=TwoWay}"

                                            HeightRequest="36" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Total Landed Cost Banner (Clean Neutral Border & Bold Amount) -->
                            <Border Margin="0,4,0,0" Padding="12,10"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Total Landed Cost (Base + Freight + Other Charges - Discount + VAT)"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                        <Label Text="{Binding FormattedCalculatedRfqGrandTotal}"
                                               FontSize="16"
                                               FontFamily="SegoeSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding CalculatedRfqVatAmount, StringFormat='VAT: {0:N2}'}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Action Buttons -->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="End" Margin="0,4,0,0">
                        <Button Text="Cancel" Command="{Binding CloseAddRfqModalCommand}"
                                Style="{StaticResource CancelButton}" HeightRequest="36" Padding="16,0" />
                        <Button Text="Save RFQ" Command="{Binding SaveNewRfqCommand}"
                                Style="{StaticResource PrimaryButton}" HeightRequest="36" Padding="20,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
