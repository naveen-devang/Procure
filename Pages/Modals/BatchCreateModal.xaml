<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:Procure.PageModels"
             xmlns:models="clr-namespace:Procure.Models"
             xmlns:u="clr-namespace:Procure.Utilities"
             x:Class="Procure.Pages.Modals.BatchCreateModal"
             x:Name="ThisModal"
             x:DataType="pageModels:PrListPageModel"
             IsVisible="{Binding IsBatchCreateModalVisible}">

    <Grid BackgroundColor="#99000000">
        <Border MaximumWidthRequest="1020"
                Margin="24"
                MaximumHeightRequest="820"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                Padding="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#30000000" Offset="0,8" Radius="20" Opacity="0.8" />
            </Border.Shadow>

            <!-- Master-detail: a lightweight list of PRs on the left (visible once there's more
                 than one row), a full form for whichever row is selected on the right. Only the
                 selected row's fields ever exist in the visual tree, so this is lighter than the
                 old one-full-card-per-row layout even before counting virtualization. -->
            <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" RowSpacing="16">
                <!-- Dialog Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{Binding ModalTitle}"
                               FontFamily="SegoeSemibold" FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Label Text="{Binding ModalSubtitle}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="✕"
                            Command="{Binding CloseBatchCreateModalCommand}"
                            BackgroundColor="Transparent" TextColor="{StaticResource Gray400}"
                            HeightRequest="30" WidthRequest="30" Padding="0" />
                </Grid>

                <!-- New Row Defaults - pre-fills rows added via "+ Add Row" and fills in whatever
                     a pasted Excel row doesn't specify. It never touches a row that already
                     exists, unlike the old "Apply Defaults to All Rows" button it replaces -
                     that's what made a hand-edited row's Plant/Type silently revert. -->
                <Border Grid.Row="1" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        Background="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}"
                        Padding="14,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto, 110, 160, 90, 150, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="New Row Defaults" FontFamily="SegoeSemibold" FontSize="12"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            <Picker Grid.Column="1" ItemsSource="{Binding AllPlants}" SelectedItem="{Binding BatchSharedPlant, Mode=TwoWay}" HeightRequest="32" FontSize="11" />
                            <Picker Grid.Column="2" ItemsSource="{Binding AllPrTypes}" SelectedItem="{Binding BatchSharedPrType, Mode=TwoWay}" HeightRequest="32" FontSize="11" />
                            <Picker Grid.Column="3" ItemsSource="{Binding AllPriorities}" SelectedItem="{Binding BatchSharedPriority, Mode=TwoWay}" HeightRequest="32" FontSize="11" />
                            <Entry Grid.Column="4" Text="{Binding BatchSharedRequestor, Mode=TwoWay}" Placeholder="Default requestor" HeightRequest="32" FontSize="11" />
                            <Entry Grid.Column="5" Text="{Binding BatchSharedNotes, Mode=TwoWay}" Placeholder="Notes / purpose" HeightRequest="32" FontSize="11" />
                            <Button Grid.Column="6" Text="Apply to all rows"
                                    Command="{Binding ApplyDefaultsToAllRowsCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" HeightRequest="32" Padding="12,0"
                                    ToolTipProperties.Text="Set Plant, PR Type, Priority, Requestor and Notes on every row (including pasted ones) to these defaults" />
                        </Grid>
                        <Label Text="Pre-fills new rows and fills blanks when pasting from Excel. &quot;Apply to all rows&quot; overwrites Plant / PR Type / Priority / Requestor / Notes on every row."
                               FontSize="10" TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Toolbar -->
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="{Binding RequisitionsSectionLabel}" FontFamily="SegoeSemibold" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                    <!-- Excel import is button-only: Ctrl+V is a plain text paste everywhere in the
                         modal now. "Paste rows" reads the clipboard and fans it out into PR rows. -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="Paste rows from Excel"
                                Command="{Binding PasteBatchPrRowsFromClipboardCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="11" HeightRequest="28" Padding="12,0" />
                        <Button Text="+ Add Row"
                                Command="{Binding AddBatchPrRowCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="11" HeightRequest="28" Padding="12,0" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Master-detail split. The list column's width and the gap next to it both
                     collapse to 0 with a single row - a plain IsVisible on the column's content
                     would leave the fixed-width Grid column (and its ColumnSpacing) reserved and
                     empty, the same reservation gap the earlier badge fix ran into. -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto, *"
                      ColumnSpacing="{Binding IsBulkMode, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='16|0'}">
                    <CollectionView Grid.Column="0"
                                    WidthRequest="{Binding IsBulkMode, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='220|0'}"
                                    ItemsSource="{Binding BatchPrEntries}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BatchPrEntry">
                                <!-- Selection is a plain identity check against SelectedBatchEntry, not
                                     CollectionView's own SelectionMode/VisualStateManager "Selected"
                                     state - that's unreliable on WinUI (only a partial highlight
                                     rendered). The TapGestureRecognizer also makes this row count as a
                                     "tap-to-select" region for MauiProgram's app-wide text-selection
                                     rule, so none of its labels render as selectable text - the
                                     highlighted card itself is the only selection feedback needed. -->
                                <Border StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        Background="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                        Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="7" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisModal}, Path=BindingContext.SelectBatchPrRowCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                                    <Binding Path="." />
                                                    <Binding Source="{x:Reference ThisModal}" Path="BindingContext.SelectedBatchEntry" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource LightTertiaryBackground}, Dark={StaticResource DarkTertiaryBackground}}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding PrNo}" FontFamily="SegoeSemibold" FontSize="11.5"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding ItemsCount, StringFormat='{0} item(s)'}" FontSize="9.5"
                                                   IsVisible="{Binding HasItems}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                            <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3"
                                                     Color="{DynamicResource AccentFill}"
                                                     IsVisible="{Binding HasCustomizations}"
                                                     VerticalOptions="Center"
                                                     ToolTipProperties.Text="Has custom field values set" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Detail pane: the selected row's full form. Every field binds through
                         SelectedBatchEntry rather than resetting BindingContext down the tree, so
                         this whole subtree stays compiled-binding-checked against PrListPageModel
                         like the rest of the file. -->
                    <ScrollView Grid.Column="1">
                        <!-- BindingContext scoped to the selected row (and x:DataType matching it),
                             the same pattern the old per-row CollectionView template used. -->
                        <VerticalStackLayout Spacing="14" Padding="0,0,16,0"
                                             BindingContext="{Binding SelectedBatchEntry}"
                                             x:DataType="models:BatchPrEntry">
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="PR Number *" FontSize="11" FontFamily="SegoeSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry x:Name="DetailPrNoEntry" Text="{Binding PrNo, Mode=TwoWay}"
                                           Placeholder="e.g. PR-2026-001"
                                           HeightRequest="36" FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Description / Summary" FontSize="11" FontFamily="SegoeSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry Text="{Binding Description, Mode=TwoWay}"
                                           Placeholder="Requisition title or item summary..." HeightRequest="36" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="PR Type *" FontSize="11" FontFamily="SegoeSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Picker ItemsSource="{Binding Source={x:Reference ThisModal}, Path=BindingContext.AllPrTypes}"
                                            SelectedItem="{Binding PrType, Mode=TwoWay}" HeightRequest="36" FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Plant" FontSize="11" FontFamily="SegoeSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Picker ItemsSource="{Binding Source={x:Reference ThisModal}, Path=BindingContext.AllPlants}"
                                            SelectedItem="{Binding Plant, Mode=TwoWay}" HeightRequest="36" FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Priority" FontSize="11" FontFamily="SegoeSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Picker ItemsSource="{Binding Source={x:Reference ThisModal}, Path=BindingContext.AllPriorities}"
                                            SelectedItem="{Binding Priority, Mode=TwoWay}" HeightRequest="36" FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Text="Requestor" FontSize="11" FontFamily="SegoeSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                                    <Entry Text="{Binding Requestor, Mode=TwoWay}" Placeholder="Requestor name / team" HeightRequest="36" FontSize="12" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Line Items" FontFamily="SegoeSemibold" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                           VerticalOptions="Center" />
                                    <!-- "Paste items" reads the clipboard and appends parsed line
                                         items to this PR. Ctrl+V in a field is a plain paste. -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Button Text="Paste items from Excel"
                                                Command="{Binding Source={x:Reference ThisModal}, Path=BindingContext.PasteBatchItemsFromClipboardCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11" HeightRequest="28" Padding="10,0" />
                                        <Button Text="+ Add Item"
                                                Command="{Binding Source={x:Reference ThisModal}, Path=BindingContext.AddBatchItemToPrCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButton}"
                                                FontSize="11" HeightRequest="28" Padding="10,0" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:PrItem">
                                            <Grid ColumnDefinitions="*, 75, 70, 90, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                                <!-- Fixed two-line field: wraps and scrolls inside for a longer spec,
                                                     full text on hover. Height never changes, so the row never jumps. -->
                                                <Editor Grid.Column="0" Text="{Binding ItemName, Mode=TwoWay}"
                                                        AutoSize="Disabled"
                                                        HeightRequest="46"
                                                        VerticalOptions="Center"
                                                        ToolTipProperties.Text="{Binding ItemName}"
                                                        Placeholder="Item name / spec..." FontSize="12" />
                                                <Entry Grid.Column="1" Text="{Binding Quantity, Mode=TwoWay}"
                                                       VerticalOptions="Center"
                                                       Placeholder="Qty" Keyboard="Numeric" HeightRequest="34" FontSize="12" HorizontalTextAlignment="Center" />
                                                <Entry Grid.Column="2" Text="{Binding Unit, Mode=TwoWay}"
                                                       VerticalOptions="Center"
                                                       Placeholder="pcs" HeightRequest="34" FontSize="12" HorizontalTextAlignment="Center" />
                                                <Entry Grid.Column="3" Text="{Binding EstimatedUnitPrice, Mode=TwoWay}"
                                                       VerticalOptions="Center"
                                                       Placeholder="Price (opt)" Keyboard="Numeric" HeightRequest="34" FontSize="12" />
                                                <Button Grid.Column="4" Text="&#xE74D;"
                                                        FontFamily="Segoe Fluent Icons"
                                                        Command="{Binding Source={x:Reference ThisModal}, Path=BindingContext.RemoveBatchItemFromPrCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="Transparent"
                                                        TextColor="{StaticResource FluentCritical}"
                                                        ToolTipProperties.Text="Remove Item"
                                                        VerticalOptions="Center"
                                                        HeightRequest="28" WidthRequest="28" Padding="0" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Custom Fields - every column defined on the Custom Columns page shows up
                                 here automatically, because SelectedBatchEntry.CustomValues already
                                 carries one entry per column (seeded in CreateNewBatchPrEntry). Hidden
                                 entirely when no custom columns exist at all. -->
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                     IsVisible="{Binding Source={x:Reference ThisModal}, Path=BindingContext.CustomColumnDefinitions.Count, Converter={StaticResource IntGreaterThanZeroConverter}}" />

                            <VerticalStackLayout Spacing="8"
                                                  IsVisible="{Binding Source={x:Reference ThisModal}, Path=BindingContext.CustomColumnDefinitions.Count, Converter={StaticResource IntGreaterThanZeroConverter}}">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Custom Fields" FontFamily="SegoeSemibold" FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Copy to all rows"
                                            Command="{Binding Source={x:Reference ThisModal}, Path=BindingContext.CopyCustomFieldsToAllRowsCommand}"
                                            CommandParameter="{Binding .}"
                                            ToolTipProperties.Text="Fills this value into any other row that doesn't already have one set - never overwrites"
                                            IsVisible="{Binding Source={x:Reference ThisModal}, Path=BindingContext.IsBulkMode}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="11" HeightRequest="28" Padding="10,0" />
                                </Grid>

                                <!-- BindableLayout only ever stacks children into its host in order - it
                                     has no ItemsLayout/column-span concept (that's CollectionView-only),
                                     so this follows EditPrModal's proven one-field-per-line pattern
                                     rather than attempting a grid host, which would leave every field
                                     stacked at 0,0. -->
                                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding CustomValues}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomFieldValue">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding ColumnName}" FontSize="11" FontFamily="SegoeSemibold"
                                                       TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />

                                                <Picker IsVisible="{Binding IsSelect}"
                                                        ItemsSource="{Binding OptionsList}"
                                                        SelectedItem="{Binding Value, Mode=TwoWay}"
                                                        HorizontalOptions="Fill"
                                                        HeightRequest="34" FontSize="12" />

                                                <DatePicker IsVisible="{Binding IsDate}"
                                                            Date="{Binding DateValue, Mode=TwoWay}"
                                                            Format="yyyy-MM-dd"
                                                            HorizontalOptions="Fill"
                                                            HeightRequest="34" FontSize="12" />

                                                <Entry IsVisible="{Binding IsNumber}"
                                                       Text="{Binding Value, Mode=TwoWay}"
                                                       Keyboard="Numeric"
                                                       HorizontalOptions="Fill"
                                                       HeightRequest="34" />

                                                <Entry IsVisible="{Binding IsText}"
                                                       Text="{Binding Value, Mode=TwoWay}"
                                                       HorizontalOptions="Fill"
                                                       HeightRequest="34" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>

                <!-- Dialog Footer -->
                <Grid Grid.Row="4" ColumnDefinitions="*, Auto" VerticalOptions="Center" Margin="0,4,0,0">
                    <Label Grid.Column="0" Text="{Binding BatchEntriesSummary}"
                           IsVisible="{Binding IsBulkMode}"
                           FontSize="12" FontFamily="SegoeSemibold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Button Text="Cancel"
                                Command="{Binding CloseBatchCreateModalCommand}"
                                Style="{StaticResource CancelButton}"
                                HeightRequest="36" Padding="16,0" />

                        <Button Text="{Binding SaveButtonText}"
                                Command="{Binding SaveBatchPrsModalCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="36" Padding="20,0" />
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
