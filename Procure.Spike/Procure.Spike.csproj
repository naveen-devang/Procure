<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 0 spike (MIGRATION-PLAN.md). Throwaway: proves whether a native WinUI 3
       PR board is measurably smoother than the MAUI build at 20k rows, against the
       real repository + the real SQLite file. Links the data-layer source directly
       from ..\Procure (no Procure.Core extraction yet - that is Phase 1) and stubs
       the 2 MAUI platform types DatabaseConstants touches (SpikeShims.cs). Does not
       modify the MAUI project. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Procure.Spike</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);SPIKE</DefineConstants>
    <NoWarn>$(NoWarn);MSB3270;CsWinRT1028;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <!-- Data layer, linked from the MAUI project. Kept in lockstep by path, not copied. -->
  <ItemGroup>
    <Compile Include="..\Models\*.cs" LinkBase="_Linked\Models"
             Exclude="..\Models\PastelThemeOption.cs;..\Models\ShortcutRowViewModel.cs" />
    <Compile Include="..\Data\SqliteDatabase.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\DatabaseConstants.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\PurchaseRequisitionRepository.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\PurchaseRequisitionRepository.Writes.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\PurchaseRequisitionRepository.Restructure.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\IPurchaseRequisitionRepository.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\MaterialAggregateMaintenance.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\CustomColumnRepository.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Data\Repositories\ICustomColumnRepository.cs" LinkBase="_Linked\Data" />
    <Compile Include="..\Utilities\MoneyFormat.cs" LinkBase="_Linked\Utilities" />
    <Compile Include="..\Utilities\PrLineMatcher.cs" LinkBase="_Linked\Utilities" />
  </ItemGroup>

</Project>
