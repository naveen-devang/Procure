<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows only. The UI is WinUI 3 throughout - Mica backdrop, Segoe Fluent Icons, native
		     MenuFlyouts, WinUI handler mappers - so the android/ios/maccatalyst heads only ever cost
		     restore and build time. Re-add a TargetFrameworks list if a mobile head is ever wanted. -->
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>Procure</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Memory & Garbage Collection Optimization -->
		<ServerGarbageCollection>false</ServerGarbageCollection>
		<ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
		<GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
		<TieredCompilation>true</TieredCompilation>
		<TieredPGO>true</TieredPGO>

		<!-- Kept for cold app start, NOT for the read path: measured Release GetAllAsync is 17ms cold,
		     so the ~520ms the PR Board waited was startup contention, not JIT of the query code. R2R may
		     still help the startup work that contention is queued behind, but that is unmeasured -
		     benchmark it before relying on it. Only takes effect on `dotnet publish`. -->
		<PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>

		<!-- Display name -->
		<ApplicationTitle>Procure</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.procure</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17171a" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17171a" BaseSize="128,128" />

		<!-- Custom Fonts. Scoped to *.ttf: a bare * also matched FluentUI.cs, which packaged a
		     C# source file as a font asset and shipped it in the publish output. -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
		<!-- TEMPORARY DOWNGRADE for A/B testing: pinned to 2.4.0 on 2026-08-24, but a multi-second
		     cursor stall (busy cursor on dropdown open, I-beam reverting late on Entry click) showed up
		     immediately after and didn't go away even after fixing the modal-construction issue found
		     separately. 2.4.0's headline change is to the InputPointerSource subsystem (new OS
		     touchpad/mouse haptics) - the exact layer that draws cursor icons - so this pins back to the
		     floor CommunityToolkit.Maui.Core 15.0.0 already requires, to test whether 2.4.0 itself is the
		     cause. Revert to 2.4.0 (or try 2.3.1) once that's confirmed either way. -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.11" />
		<PackageReference Include="Velopack" Version="1.2.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<!-- bundle_green 2.1.11 ships lib.e_sqlite3 2.1.11, which NU1903-flags as a high severity
		     vulnerability (GHSA-2m69-gcr7-jv3q). This pin lifts the desktop native binary to a patched
		     build; drop it once bundle_green ships >= 2.1.13. -->
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	</ItemGroup>
	
</Project>
