<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Procure.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Procure.Pages"
    xmlns:f="clr-namespace:Fonts"
    Shell.FlyoutBehavior="Locked"
    FlyoutWidth="{DynamicResource SidebarExpandedWidth}"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="Transparent"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
    Title="RWC MM Tracker">

    <!-- Flyout App Header with Responsive Collapse/Expand Toggle -->
    <Shell.FlyoutHeader>
        <Grid x:Name="FlyoutHeaderGrid"
              Padding="14,14,14,8"
              ColumnDefinitions="Auto, *"
              BackgroundColor="Transparent">

            <!-- Sidebar Collapse / Expand Toggle Button -->
            <Button x:Name="SidebarToggleBtn"
                    Grid.Column="0"
                    Text="&#xE700;"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="15"
                    WidthRequest="38"
                    HeightRequest="36"
                    Padding="0"
                    CornerRadius="6"
                    Clicked="OnToggleSidebarClicked"
                    BackgroundColor="Transparent"
                    ToolTipProperties.Text="Toggle Sidebar"
                    TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
        </Grid>
    </Shell.FlyoutHeader>

    <!-- Navigation Items with Tooltips for Compact Mode -->
    <ShellContent
        x:Name="DashboardContent"
        Title="Dashboard"
        ToolTipProperties.Text="Dashboard"
        Icon="{StaticResource IconDashboard}"
        Route="main" />

    <ShellContent
        x:Name="PrBoardContent"
        Title="PR Board"
        ToolTipProperties.Text="PR Board"
        Icon="{StaticResource IconProjects}"
        Route="prboard" />

    <ShellContent
        x:Name="MaterialsContent"
        Title="Raw &amp; Packing"
        ToolTipProperties.Text="Raw &amp; Packing Materials"
        Icon="{StaticResource IconMaterials}"
        Route="materials" />

    <ShellContent
        x:Name="TasksContent"
        Title="Tasks"
        ToolTipProperties.Text="Tasks"
        Icon="{StaticResource IconTasks}"
        Route="todos" />

    <ShellContent
        x:Name="NotesContent"
        Title="Notes"
        ToolTipProperties.Text="Notes"
        Icon="{StaticResource IconNotes}"
        Route="notes" />

    <ShellContent
        x:Name="SettingsContent"
        Title="Settings"
        ToolTipProperties.Text="Settings"
        Icon="{StaticResource IconSettings}"
        Route="settings" />

    <!-- Flyout Footer: Update-Ready Card + Responsive Theme Switcher -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout BackgroundColor="Transparent">
            <!-- Silent auto-update card - hidden by default, shown only once a downloaded update
                 is actually ready (see App.xaml.cs / AppShell.xaml.cs). Never asks permission to
                 check or download; this is the first and only thing the user sees, and only when
                 there's something to act on. -->
            <Border x:Name="UpdateReadyCard"
                    IsVisible="False"
                    Margin="12,0,12,10"
                    Padding="12,10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource PrimaryDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Ellipse Grid.Column="0" WidthRequest="6" HeightRequest="6" Margin="0,0,6,0"
                                 Fill="{DynamicResource AccentFill}" />
                        <Label Grid.Column="1" x:Name="UpdateReadyTitleLabel" Text="Update ready"
                               FontFamily="SegoeSemibold" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                        <Button Grid.Column="2" Text="&#xE711;"
                                FontFamily="Segoe Fluent Icons" FontSize="10"
                                Clicked="OnDismissUpdateBannerClicked"
                                BackgroundColor="Transparent" Padding="0"
                                WidthRequest="22" HeightRequest="22"
                                ToolTipProperties.Text="Dismiss"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    </Grid>
                    <Label Text="Downloaded in the background. Restart to apply." FontSize="10.5"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                    <HorizontalStackLayout Spacing="6">
                        <Button Text="Restart" Clicked="OnRestartForUpdateClicked"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" HeightRequest="28" Padding="12,0" HorizontalOptions="FillAndExpand" />
                        <Button Text="Later" Clicked="OnDismissUpdateBannerClicked"
                                Style="{StaticResource CancelButton}"
                                FontSize="11" HeightRequest="28" Padding="12,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Compact sidebar has no room for the card - a small dot on the theme button stands
                 in for it; clicking the theme button area still gets you to Settings, where the
                 same update is always checkable the old manual way regardless. -->
            <BoxView x:Name="CompactUpdateDot"
                     IsVisible="False"
                     WidthRequest="6" HeightRequest="6" CornerRadius="3"
                     HorizontalOptions="Center" Margin="0,0,0,6"
                     Color="{DynamicResource AccentFill}"
                     ToolTipProperties.Text="Update ready - open Settings to restart" />

            <Grid BackgroundColor="Transparent">
            <!-- Expanded Footer Layout: Full Two-Button Theme Switcher -->
            <Grid x:Name="ExpandedFooterLayout"
                  Padding="16,14"
                  ColumnDefinitions="*, Auto"
                  BackgroundColor="Transparent">
                <Label Grid.Column="0"
                       Text="Theme"
                       FontSize="12"
                       FontFamily="SegoeSemibold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />

                <Border Grid.Column="1"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                        Padding="4,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Button x:Name="LightModeBtn"
                                Text="&#xE706;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                WidthRequest="32" HeightRequest="28"
                                Padding="0"
                                CornerRadius="4"
                                Clicked="OnLightModeClicked"
                                BackgroundColor="Transparent"
                                ToolTipProperties.Text="Light Theme"
                                TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource Gray400}}" />

                        <Button x:Name="DarkModeBtn"
                                Text="&#xE708;"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="13"
                                WidthRequest="32" HeightRequest="28"
                                Padding="0"
                                CornerRadius="4"
                                Clicked="OnDarkModeClicked"
                                BackgroundColor="Transparent"
                                ToolTipProperties.Text="Dark Theme"
                                TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource LightOnDarkBackground}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Compact Footer Layout: Single Centered Theme Button -->
            <Grid x:Name="CompactFooterLayout"
                  Padding="0,12"
                  HorizontalOptions="Center"
                  IsVisible="False"
                  BackgroundColor="Transparent">
                <Button x:Name="CompactThemeBtn"
                        Text="&#xE708;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        CornerRadius="8"
                        Clicked="OnCompactThemeClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                        TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}"
                        ToolTipProperties.Text="Toggle Theme" />
            </Grid>
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
